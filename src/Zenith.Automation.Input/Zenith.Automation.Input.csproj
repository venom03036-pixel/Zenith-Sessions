<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- No InternalsVisibleTo: other assemblies stop a lease through TargetedInputRun.StopAsync(TargetedInputStopReason),
       never through the owner's lock, lane, transport, run constructor or *Locked members (O-C10-2). -->
</Project>
