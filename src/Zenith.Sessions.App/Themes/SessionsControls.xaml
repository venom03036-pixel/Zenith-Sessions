<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Zenith.Sessions.App">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ModernControls.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Companion-only editable variant. ComboBox owns text/selection synchronization
         through its named editable part; the host's noneditable style stays unchanged. -->
    <Style x:Key="SessionsEditableComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="IsEditable" Value="True"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        <Setter Property="ItemsPanel">
            <Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="SelectionPresenter" Margin="{TemplateBinding Padding}"
                                                  IsHitTestVisible="False" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                                <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Visibility="Collapsed"
                                         Margin="{TemplateBinding Padding}" Padding="0" BorderThickness="0" Background="Transparent"
                                         Foreground="{TemplateBinding Foreground}" CaretBrush="{TemplateBinding Foreground}"
                                         SelectionBrush="{DynamicResource SelectionBackground}" SelectionTextBrush="{DynamicResource SelectionForeground}"
                                         FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                         HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center"
                                         IsReadOnly="{TemplateBinding IsReadOnly}" Cursor="IBeam" Focusable="True" IsTabStop="True"
                                         AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="{x:Type TextBox}">
                                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                                <ToggleButton x:Name="DropDownToggle" Grid.Column="1" Style="{x:Null}" Focusable="False" IsTabStop="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              AutomationProperties.Name="Show group choices" Background="Transparent" BorderThickness="0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border x:Name="ArrowChrome" Background="{TemplateBinding Background}" CornerRadius="0,3,3,0">
                                                <Path Width="16" Height="16" Data="M 3,6 L 8,11 L 13,6" Stroke="{DynamicResource TextSecondary}"
                                                      StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ArrowChrome" Property="Background" Value="{DynamicResource HoverBackground}"/></Trigger>
                                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="ArrowChrome" Property="Background" Value="{DynamicResource HoverBackground}"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                            <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource ControlBorder}"
                                    BorderThickness="1" CornerRadius="4" Padding="4" Margin="0,4,0,0">
                                <ScrollViewer CanContentScroll="True" SnapsToDevicePixels="True"
                                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="True"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter Property="IsTabStop" Value="False"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SelectionPresenter" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderBrushFocus}"/></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderBrushFocus}"/></Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderBrushFocus}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Sessions visual language ─────────────────────────────────────────
         Sessions-only styles. Every color is a DynamicResource so theme presets
         (and tests that apply a palette to this dictionary) keep working. -->

    <!-- The implicit (unstyled) Button is defined at the end of this file as SecondaryButton. -->

    <!-- Type scale: page title 20 · section 15 · body 13 · caption 12 · eyebrow 11 -->
    <Style x:Key="PageTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="PageSubtitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style x:Key="Eyebrow" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Caption" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="17"/>
    </Style>
    <!-- One line, trimmed; bind ToolTip to the same text so nothing is lost. -->
    <Style x:Key="CaptionLine" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Caption}">
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="MetricValue" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,4,0,2"/>
    </Style>
    <Style x:Key="EmptyStateTitle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Status chips: short state words with a colored dot. Use instead of status sentences. -->
    <Style x:Key="ChipNeutral" TargetType="{x:Type ContentControl}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2,9,3" SnapsToDevicePixels="True">
                        <DockPanel>
                            <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Margin="0,1,6,0" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}"/>
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="Segoe UI Variable Text, Segoe UI"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ChipAccent" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource ChipNeutral}">
        <Setter Property="Background" Value="{DynamicResource BadgeBgTeal}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BadgeBgTeal}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
    </Style>
    <Style x:Key="ChipSuccess" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource ChipNeutral}">
        <Setter Property="Background" Value="{DynamicResource BadgeBgSuccess}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BadgeBgSuccess}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentSuccess}"/>
    </Style>
    <Style x:Key="ChipWarning" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource ChipNeutral}">
        <Setter Property="Background" Value="{DynamicResource BadgeBgWarning}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BadgeBgWarning}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentWarning}"/>
    </Style>
    <Style x:Key="ChipDanger" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource ChipNeutral}">
        <Setter Property="Background" Value="{DynamicResource BadgeBgDanger}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BadgeBgDanger}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentDanger}"/>
    </Style>
    <!-- Saved sign-in state (AccountRow.Identity). A saved link is not proof of a usable session. -->
    <Style x:Key="SignInChip" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource ChipNeutral}">
        <Style.Triggers>
            <Trigger Property="Content" Value="Linked"><Setter Property="Background" Value="{DynamicResource BadgeBgTeal}"/><Setter Property="BorderBrush" Value="{DynamicResource BadgeBgTeal}"/><Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/></Trigger>
            <Trigger Property="Content" Value="Saved link"><Setter Property="Background" Value="{DynamicResource BadgeBgTeal}"/><Setter Property="BorderBrush" Value="{DynamicResource BadgeBgTeal}"/><Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/></Trigger>
            <Trigger Property="Content" Value="Expired"><Setter Property="Background" Value="{DynamicResource BadgeBgWarning}"/><Setter Property="BorderBrush" Value="{DynamicResource BadgeBgWarning}"/><Setter Property="Foreground" Value="{DynamicResource AccentWarning}"/></Trigger>
            <Trigger Property="Content" Value="Expired link"><Setter Property="Background" Value="{DynamicResource BadgeBgWarning}"/><Setter Property="BorderBrush" Value="{DynamicResource BadgeBgWarning}"/><Setter Property="Foreground" Value="{DynamicResource AccentWarning}"/></Trigger>
            <Trigger Property="Content" Value="Sign in required"><Setter Property="Background" Value="{DynamicResource BadgeBgWarning}"/><Setter Property="BorderBrush" Value="{DynamicResource BadgeBgWarning}"/><Setter Property="Foreground" Value="{DynamicResource AccentWarning}"/></Trigger>
        </Style.Triggers>
    </Style>
    <!-- Launch request state (AccountRow.LaunchStatus). Only "Arrival verified" is green. -->
    <Style x:Key="LaunchChip" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource ChipNeutral}">
        <Style.Triggers>
            <Trigger Property="Content" Value="Arrival verified"><Setter Property="Background" Value="{DynamicResource BadgeBgSuccess}"/><Setter Property="BorderBrush" Value="{DynamicResource BadgeBgSuccess}"/><Setter Property="Foreground" Value="{DynamicResource AccentSuccess}"/></Trigger>
            <Trigger Property="Content" Value="Review required"><Setter Property="Background" Value="{DynamicResource BadgeBgWarning}"/><Setter Property="BorderBrush" Value="{DynamicResource BadgeBgWarning}"/><Setter Property="Foreground" Value="{DynamicResource AccentWarning}"/></Trigger>
            <Trigger Property="Content" Value="Uncertain"><Setter Property="Background" Value="{DynamicResource BadgeBgWarning}"/><Setter Property="BorderBrush" Value="{DynamicResource BadgeBgWarning}"/><Setter Property="Foreground" Value="{DynamicResource AccentWarning}"/></Trigger>
            <Trigger Property="Content" Value="Blocked"><Setter Property="Background" Value="{DynamicResource BadgeBgDanger}"/><Setter Property="BorderBrush" Value="{DynamicResource BadgeBgDanger}"/><Setter Property="Foreground" Value="{DynamicResource AccentDanger}"/></Trigger>
            <Trigger Property="Content" Value="Failed"><Setter Property="Background" Value="{DynamicResource BadgeBgDanger}"/><Setter Property="BorderBrush" Value="{DynamicResource BadgeBgDanger}"/><Setter Property="Foreground" Value="{DynamicResource AccentDanger}"/></Trigger>
            <Trigger Property="Content" Value="Queued"><Setter Property="Background" Value="{DynamicResource BadgeBgTeal}"/><Setter Property="BorderBrush" Value="{DynamicResource BadgeBgTeal}"/><Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/></Trigger>
            <Trigger Property="Content" Value="Validating"><Setter Property="Background" Value="{DynamicResource BadgeBgTeal}"/><Setter Property="BorderBrush" Value="{DynamicResource BadgeBgTeal}"/><Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/></Trigger>
            <Trigger Property="Content" Value="Launching"><Setter Property="Background" Value="{DynamicResource BadgeBgTeal}"/><Setter Property="BorderBrush" Value="{DynamicResource BadgeBgTeal}"/><Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/></Trigger>
            <Trigger Property="Content" Value="Stabilizing"><Setter Property="Background" Value="{DynamicResource BadgeBgTeal}"/><Setter Property="BorderBrush" Value="{DynamicResource BadgeBgTeal}"/><Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/></Trigger>
        </Style.Triggers>
    </Style>

    <!-- Banners: one short sentence about something that limits what the page can do. -->
    <Style x:Key="WarningBanner" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource BadgeBgWarning}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BadgeBgWarning}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,10"/>
    </Style>

    <!-- Quiet secondary action: no fill until hovered. Use beside one PrimaryButton. -->
    <Style x:Key="QuietButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource HoverBackground}"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BorderBrushLight}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource ActiveBackground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DangerQuietButton" TargetType="{x:Type Button}" BasedOn="{StaticResource QuietButton}">
        <Setter Property="Foreground" Value="{DynamicResource AccentDanger}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentDanger}"/></Trigger>
        </Style.Triggers>
    </Style>

    <!-- Row action: outlined normally, filled with the accent on the selected list row.
         Hover uses a translucent sheen so text contrast holds in both states. -->
    <Style x:Key="RowActionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"/>
                        <Border x:Name="Sheen" Background="{DynamicResource TextPrimary}" CornerRadius="5" Opacity="0" IsHitTestVisible="False"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Sheen" Property="Opacity" Value="0.08"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BorderBrushFocus}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Sheen" Property="Opacity" Value="0.14"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Segmented control: put SegmentButtons in a SegmentBar; bind each Tag to its "is selected" flag. -->
    <Style x:Key="SegmentBar" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style x:Key="SegmentButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButton}">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="14,4"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="{DynamicResource HoverBackground}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Trigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SelectionBorder}"/>
                <Setter Property="Foreground" Value="{DynamicResource SelectionForeground}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Small "i" that carries explanatory text in its ToolTip (also on keyboard focus). -->
    <Style x:Key="InfoTip" TargetType="{x:Type ContentControl}">
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="IsTabStop" Value="True"/>
        <Setter Property="Cursor" Value="Help"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
        <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="150"/>
        <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
        <Setter Property="AutomationProperties.HelpText" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Grid Width="18" Height="18" Background="Transparent">
                        <Ellipse x:Name="Ring" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.3"/>
                        <TextBlock Text="i" FontFamily="Georgia" FontStyle="Italic" FontWeight="Bold" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,1,1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentPrimary}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Redesign 2026-11 (Figma "Zenith Sessions — UI Redesign") ===== -->
    <!-- Default button = Secondary: quiet surface fill, light border, 32px. Primary/Ghost/Danger keep their own keys. -->
    <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButton}">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="{DynamicResource HoverBackground}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Background" Value="{DynamicResource ActiveBackground}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BorderBrushFocus}"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 32x32 icon-only button. Content is a 16px Path using the Glyph style. Always set ToolTip and AutomationProperties.Name. -->
    <Style x:Key="IconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource QuietButton}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <!-- IconButton on a selectable list row: while its row is selected the glyph takes the selection text colour (under Windows High
         Contrast the usual TextSecondary is the window text colour, which does not read on the Highlight colour); while hovered or
         pressed it draws on its own hover or press fill, so it takes TextPrimary as QuietButton does. -->
    <Style x:Key="RowIconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource IconButton}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource SelectionForeground}"/>
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Glyph" TargetType="{x:Type Path}">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="StrokeThickness" Value="1.4"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
    </Style>

    <Style x:Key="SectionHeading" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style x:Key="MonoText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
    </Style>
    <Style x:Key="KeyText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ValueText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SurfaceCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="Divider" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource BorderBrushLight}"/>
        <Setter Property="Margin" Value="0,14"/>
    </Style>
    <Style x:Key="JoiningBanner" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16,10"/>
    </Style>
    <Style x:Key="KeyCap" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="5,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="TableHeader" TargetType="{x:Type Border}">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style x:Key="TableHeaderText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- Step marker for the join flow (1 Find a game · 2 Browse servers · 3 Ready). Tag = is current step. -->
    <Style x:Key="StepButton" TargetType="{x:Type Button}" BasedOn="{StaticResource QuietButton}">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="10,4"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Chip buttons: compact rounded actions for favorites and recently played games. -->
    <Style x:Key="ChipButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource TextMuted}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Search result cards: a clickable surface whose border marks the current requested destination. -->
    <local:CardColumnsConverter x:Key="CardColumns"/>
    <Style x:Key="GameCard" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource TextMuted}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentPrimary}"/>
                            <Setter TargetName="Shell" Property="BorderThickness" Value="1.5"/>
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Every unstyled Button in the manager uses the quiet Secondary look. -->
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource SecondaryButton}"/>
</ResourceDictionary>
