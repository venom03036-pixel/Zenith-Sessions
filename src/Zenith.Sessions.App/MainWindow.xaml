                  <TextBlock Text="{Binding DataContext.RequestedCapacitySummary, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='Checked or selected accounts: {0}'}" TextWrapping="Wrap" Foreground="{DynamicResource AccentPrimary}" Margin="0,10,0,0" />
