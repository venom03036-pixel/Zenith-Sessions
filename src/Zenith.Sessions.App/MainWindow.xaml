                </StackPanel>
              </Expander>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="AutomationPage" Visibility="{Binding IsAutomation, Converter={StaticResource VisibleIf}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
