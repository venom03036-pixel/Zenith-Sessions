            </Border>
            <Border Style="{StaticResource Panel}" Margin="0,0,0,24" DataContext="{Binding MacroHostCatalog}">
              <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Saved macros" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding HostVersion}" Style="{StaticResource Muted}" Margin="0,5,0,0" /></StackPanel>
