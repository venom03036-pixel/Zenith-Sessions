                <Path DockPanel.Dock="Left" Data="M8,1 L15,14 H1 Z M8,6 V9.5 M8,11.5 V12" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource AccentWarning}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,12,0" />
