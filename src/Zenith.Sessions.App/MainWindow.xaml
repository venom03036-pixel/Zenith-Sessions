                    <WrapPanel Margin="0,14,0,0"><Button Content="Show process" Command="{Binding ShowEvidenceProcess}" IsEnabled="{Binding CanShowEvidenceProcess}" Margin="0,0,8,8" /><Button Content="Copy evidence" Click="CopyLaunchEvidence" IsEnabled="{Binding HasLaunchEvidence}" Style="{StaticResource QuietButton}" Margin="0,0,8,8" /><Button Content="Save evidence…" Click="SaveLaunchEvidence" IsEnabled="{Binding HasLaunchEvidence}" Style="{StaticResource QuietButton}" Margin="0,0,8,8" /></WrapPanel>
