            <Button Content="Remove checked" Click="RemoveSelected" Style="{StaticResource DangerQuietButton}" MinHeight="36" Margin="0,0,8,8" ToolTip="Review removal of checked profiles on this page" />
            <Button Content="{Binding AccountInspectorToggleLabel}" Command="{Binding ToggleAccountInspector}" MinHeight="36" Margin="0,0,8,8" Visibility="{Binding IsAccountInspectorNarrow, Converter={StaticResource VisibleIf}}" AutomationProperties.Name="Toggle account details" />
            <Button Content="Cancel account setup" Command="{Binding CancelAuthorization}" MinHeight="36" Margin="0,0,8,8" Visibility="{Binding IsAuthorizing, Converter={StaticResource VisibleIf}}" />
            <TextBlock Text="{Binding GroupChoicesNotice}" MaxWidth="640" FontSize="11" Margin="0,0,8,6" VerticalAlignment="Center">
              <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding GroupChoicesNotice}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </WrapPanel>
          <Grid Grid.Row="2">
