            <DockPanel Margin="0,0,0,12">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                <Button Content="← Back to sessions" Command="{Binding Navigate}" CommandParameter="Sessions" Style="{StaticResource QuietButton}" MinHeight="36" Margin="0,0,4,0" />
                <Button Content="Overview" Command="{Binding Navigate}" CommandParameter="Overview" Style="{StaticResource QuietButton}" MinHeight="36" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="Join a game" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Find a game, pick a server, then check who’s going before anything starts." Style="{StaticResource Caption}" Margin="0,2,0,0" />
              </StackPanel>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="-10,0,0,12">
              <Button Command="{Binding ShowJoinStep}" CommandParameter="1" Tag="{Binding IsJoinFindStep}" Style="{StaticResource StepButton}" AutomationProperties.Name="Step 1, find a game"><StackPanel Orientation="Horizontal"><Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource SelectionBackground}"><TextBlock Text="1" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="Find a game" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
              <Path Style="{StaticResource Glyph}" Stroke="{DynamicResource TextMuted}" Width="10" Height="10" Margin="6,0" Data="M6,4 L10,8 L6,12" />
              <Button Command="{Binding ShowJoinStep}" CommandParameter="2" Tag="{Binding IsJoinServerStep}" Style="{StaticResource StepButton}" AutomationProperties.Name="Step 2, browse servers"><StackPanel Orientation="Horizontal"><Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource SelectionBackground}"><TextBlock Text="2" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="Browse servers" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
              <Path Style="{StaticResource Glyph}" Stroke="{DynamicResource TextMuted}" Width="10" Height="10" Margin="6,0" Data="M6,4 L10,8 L6,12" />
              <Button Command="{Binding ShowJoinStep}" CommandParameter="3" Tag="{Binding IsJoinReadyStep}" Style="{StaticResource StepButton}" AutomationProperties.Name="Step 3, ready when you are"><StackPanel Orientation="Horizontal"><Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource SelectionBackground}"><TextBlock Text="3" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="Ready when you are" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
            </StackPanel>
            <Border Style="{StaticResource JoiningBanner}" Margin="0,0,0,16">
              <DockPanel>
                <Path DockPanel.Dock="Left" Style="{StaticResource Glyph}" Stroke="{DynamicResource AccentPrimary}" Margin="0,0,10,0" Data="M11,4 A3,3 0 1 1 5,4 A3,3 0 1 1 11,4 M2,15 V12 Q2,8 8,8 Q14,8 14,12 V15" />
                <TextBlock Text="{Binding RequestedCapacitySummary, TargetNullValue='Joining with the accounts checked in Accounts, or the selected account when none are checked.'}" ToolTip="{Binding RequestedCapacitySummary}" Foreground="{DynamicResource AccentPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </DockPanel>
            </Border>

            <!-- ===== Step 1 · Find a game ===== -->
            <Grid Visibility="{Binding IsJoinFindStep, Converter={StaticResource VisibleIf}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="360" /></Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel DataContext="{Binding ServerBrowser}">
                  <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="DestinationInput" Text="{Binding LinkInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="4096" MinHeight="40" FontSize="14" VerticalContentAlignment="Center" AutomationProperties.Name="Game name, place ID or Roblox link" ToolTip="Search a game name, paste a Roblox game or server link, or enter a place ID · Ctrl+F" /><Button Grid.Column="1" Content="Search / Use" Command="{Binding DataContext.DestinationSearch.SearchOrUse, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.DestinationSearch.CanSearch, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" Padding="16,6" MinHeight="40" Margin="8,0,0,0" ToolTip="Search public games by name, or use a place ID or Roblox link directly" /></Grid>
                  <TextBlock Text="Search a game name, paste a Roblox link, or enter a place ID." Style="{StaticResource Caption}" Margin="2,0,0,10" />
                  <TextBlock Text="Destination draft pending. Choose Search / Use or discard the draft to keep your previous request." Foreground="{DynamicResource AccentPrimary}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="{Binding HasDestinationDraft, Converter={StaticResource VisibleIf}}" />
                  <Border x:Name="DestinationSearchPanel" DataContext="{Binding DataContext.DestinationSearch, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SurfaceCard}" Padding="16,14" Margin="0,0,0,16">
                    <StackPanel>
                      <DockPanel Margin="0,0,0,8" Visibility="{Binding HasResults, Converter={StaticResource VisibleIf}}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Results.Count, StringFormat='{}{0} results'}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                          <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" MinWidth="130" MinHeight="32" AutomationProperties.Name="Sort search results" ToolTip="Sort the loaded results. Sorting is local and sends no request." />
                        </StackPanel>
                        <TextBlock Text="Search results — choose a game" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" />
                      </DockPanel>
                      <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                      <TextBlock Text="{Binding DataContext.ServerBrowser.DestinationSummary, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='Current request: {0}'}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,10" />
                      <!-- Clicking a card uses that game as the requested destination. Nothing is queued or launched. -->
                      <ItemsControl x:Name="DestinationSearchResults" ItemsSource="{Binding VisibleResults}" Visibility="{Binding HasResults, Converter={StaticResource VisibleIf}}" AutomationProperties.Name="Public experience search results">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource CardColumns}}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                          <Button Command="{Binding DataContext.UseCard, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource GameCard}" Margin="0,0,12,12" AutomationProperties.Name="{Binding AutomationName}" ToolTip="{Binding Identifiers}">
                            <StackPanel>
                              <Border Height="120" CornerRadius="8,8,0,0" Background="{DynamicResource SurfaceBackground}">
                                <Grid>
                                  <Path Style="{StaticResource Glyph}" Stroke="{DynamicResource TextMuted}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M2,3 L14,3 L14,13 L2,13 Z M2,11 L6,7 L9,10 L11,8 L14,11 M11,5.5 A0.8,0.8 0 1 0 11.01,5.5" />
                                  <Border CornerRadius="8,8,0,0" Visibility="{Binding HasArt, Converter={StaticResource VisibleIf}}"><Border.Background><ImageBrush ImageSource="{Binding Art}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" /></Border.Background></Border>
                                </Grid>
                              </Border>
                              <StackPanel Margin="14,10,14,12">
                                <DockPanel>
                                  <Path DockPanel.Dock="Right" Style="{StaticResource Glyph}" Stroke="{DynamicResource AccentPrimary}" Width="14" Height="14" Margin="8,0,0,0" VerticalAlignment="Center" Data="M3,8 L6.5,11.5 L13,4.5" Visibility="{Binding IsCurrent, Converter={StaticResource VisibleIf}}" ToolTip="Current requested destination" />
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                  <TextBlock Text="{Binding CreatorLine}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                                  <Path Style="{StaticResource Glyph}" Stroke="{DynamicResource AccentPrimary}" Width="12" Height="12" Margin="4,0,0,0" VerticalAlignment="Center" Data="M8,1.5 L9.8,3.2 L12.2,2.8 L12.8,5.2 L15,6.4 L13.8,8.5 L15,10.6 L12.8,11.8 L12.2,14.2 L9.8,13.8 L8,15.5 L6.2,13.8 L3.8,14.2 L3.2,11.8 L1,10.6 L2.2,8.5 L1,6.4 L3.2,5.2 L3.8,2.8 L6.2,3.2 Z M5.5,8.5 L7.3,10.3 L10.8,6.8" Visibility="{Binding IsCreatorVerified, Converter={StaticResource VisibleIf}}" ToolTip="Verified creator" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                  <Path Style="{StaticResource Glyph}" Stroke="{DynamicResource TextMuted}" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center" Data="M11,4 A3,3 0 1 1 5,4 A3,3 0 1 1 11,4 M2,15 V12 Q2,8 8,8 Q14,8 14,12 V15" />
                                  <TextBlock Text="{Binding PlayingLabel}" Style="{StaticResource Caption}" />
                                  <TextBlock Text="{Binding RatingLabel}" Style="{StaticResource Caption}" Margin="10,0,0,0" Visibility="{Binding HasRating, Converter={StaticResource VisibleIf}}" />
                                  <TextBlock Text="Sponsored" Style="{StaticResource Caption}" Margin="10,0,0,0" Visibility="{Binding IsSponsored, Converter={StaticResource VisibleIf}}" ToolTip="Roblox marked this result as a paid promotion." />
                                </StackPanel>
                              </StackPanel>
                            </StackPanel>
                          </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="{Binding PageSummary}" Style="{StaticResource Caption}" FontSize="11" Margin="0,4,0,0" Visibility="{Binding HasResults, Converter={StaticResource VisibleIf}}" />
                      <WrapPanel Margin="0,10,0,0"><Button Content="Show more" Command="{Binding ShowMore}" IsEnabled="{Binding CanShowMore}" Visibility="{Binding CanShowMore, Converter={StaticResource VisibleIf}}" MinHeight="36" Margin="0,0,8,8" ToolTip="Reveal the next twelve loaded results. No request is sent." /><Button Content="More results" Command="{Binding Next}" IsEnabled="{Binding CanNext}" Visibility="{Binding CanNext, Converter={StaticResource VisibleIf}}" Style="{StaticResource QuietButton}" MinHeight="36" Margin="0,0,8,8" /><Button Content="Cancel / discard draft" Command="{Binding Cancel}" IsEnabled="{Binding CanCancel}" Visibility="{Binding CanCancel, Converter={StaticResource VisibleIf}}" Style="{StaticResource QuietButton}" MinHeight="36" Margin="0,0,8,8" /></WrapPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
                <Border Style="{StaticResource SurfaceCard}" Padding="16,14" Margin="0,0,0,16"><StackPanel>
                  <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" DataContext="{Binding RobloxFavorites}" Command="{Binding Refresh}" Style="{StaticResource IconButton}" ToolTip="Refresh this account's Roblox favorites" AutomationProperties.Name="Refresh Roblox favorites"><Path Style="{StaticResource Glyph}" Width="14" Height="14" Data="M13.5,8 A5.5,5.5 0 1 1 11.9,4.1 M13.5,2.5 L13.5,5.7 L10.3,5.7" /></Button>
                    <TextBlock Text="Favorites" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" />
                  </DockPanel>
                  <!-- Saved Zenith favorites as star chips; clicking one sets the requested destination. -->
                  <ItemsControl x:Name="SavedFavoriteChips" DataContext="{Binding DestinationFavorites}" ItemsSource="{Binding Favorites}" AutomationProperties.Name="Saved favorite destinations">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Button Command="{Binding DataContext.UseFavorite, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource ChipButton}" Margin="0,0,6,6" ToolTip="{Binding DestinationSummary}" AutomationProperties.Name="{Binding Name}">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Glyph}" Stroke="{DynamicResource AccentWarning}" Width="12" Height="12" Margin="0,0,6,0" Data="M8,2.2 L9.8,5.9 L13.8,6.5 L10.9,9.3 L11.6,13.3 L8,11.4 L4.4,13.3 L5.1,9.3 L2.2,6.5 L6.2,5.9 Z" /><TextBlock Text="{Binding Name}" VerticalAlignment="Center" /></StackPanel>
                      </Button>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- The selected account's public Roblox favorites: listing metadata, never saved favorites or proof of access. -->
                  <StackPanel DataContext="{Binding RobloxFavorites}" Margin="0,6,0,0">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Margin="12,0,0,0" />
                      <TextBlock Text="{Binding HeaderLabel}" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" ToolTip="Public favorites from this account's Roblox profile. They are not saved Zenith favorites and prove no access." />
                    </DockPanel>
                    <WrapPanel Margin="0,6,0,0">
                      <ItemsControl x:Name="RobloxFavoriteChips" ItemsSource="{Binding Chips}" AutomationProperties.Name="Roblox favorites of the selected account">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                          <Button Command="{Binding DataContext.Use, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Content="{Binding Name}" Style="{StaticResource ChipButton}" Margin="0,0,6,6" AutomationProperties.Name="{Binding AutomationName}" ToolTip="Public favorite from this account's Roblox profile. Clicking sets it as the requested destination." />
                        </DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button Content="{Binding MoreLabel}" Command="{Binding ShowAll}" Style="{StaticResource QuietButton}" MinHeight="28" Padding="8,2" Visibility="{Binding HasMore, Converter={StaticResource VisibleIf}}" Margin="0,0,6,6" />
                    </WrapPanel>
                  </StackPanel>
                  <!-- Recently played: places this PC's Roblox clients reported in their logs. Diagnostic only; clicking uses the game, never the old server. -->
                  <StackPanel DataContext="{Binding RecentlyPlayed}" Margin="0,6,0,0" Visibility="{Binding HasChips, Converter={StaticResource VisibleIf}}">
                    <TextBlock Text="Recently played" Style="{StaticResource FieldLabel}" ToolTip="From your Roblox clients' logs on this PC. Not verified." />
                    <ItemsControl x:Name="RecentlyPlayedChips" ItemsSource="{Binding Chips}" Margin="0,6,0,0" AutomationProperties.Name="Recently played games from client logs">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate><DataTemplate>
                        <Button Command="{Binding DataContext.Use, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Content="{Binding Name}" Style="{StaticResource ChipButton}" Margin="0,0,6,6" AutomationProperties.Name="{Binding AutomationName}" ToolTip="From your Roblox clients' logs on this PC. Not verified. Clicking sets the game, not the old server, as the requested destination." />
                      </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <Expander Header="Manage favorites" DataContext="{Binding DestinationFavorites}" Margin="0,4,0,0">
                    <StackPanel Margin="0,8,0,0">
                      <ListView ItemsSource="{Binding Favorites}" SelectedItem="{Binding SelectedFavorite}" Height="132" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto"><ListView.View><GridView><GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding Name}" /><GridViewColumn Header="Destination" Width="480" DisplayMemberBinding="{Binding DestinationSummary}" /></GridView></ListView.View></ListView>
                      <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" MinHeight="32" AutomationProperties.Name="Favorite destination name" ToolTip="A name for the current request. Never enter credentials or private access codes." />
                        <Button Grid.Column="1" Content="Save current as new" Command="{Binding SaveCurrent}" IsEnabled="{Binding DataContext.ServerBrowser.CanUseDestination, RelativeSource={RelativeSource AncestorType=Window}}" Margin="8,0,0,0" />
                      </Grid>
                      <WrapPanel Margin="0,8,0,0"><Button Content="Use favorite" Command="{Binding Use}" IsEnabled="{Binding CanUseFavorite}" Margin="0,0,6,8" /><Button Content="Rename selected" Command="{Binding Rename}" IsEnabled="{Binding CanUseFavorite}" Style="{StaticResource QuietButton}" Margin="0,0,6,8" /><Button Content="Remove selected" Click="DeleteFavoriteDestination" IsEnabled="{Binding CanUseFavorite}" Style="{StaticResource DangerQuietButton}" Margin="0,0,6,8" /><Button Command="{Binding Refresh}" Style="{StaticResource IconButton}" ToolTip="Refresh favorites" AutomationProperties.Name="Refresh favorites" Margin="0,0,0,8"><Path Style="{StaticResource Glyph}" Width="14" Height="14" Data="M13.5,8 A5.5,5.5 0 1 1 11.9,4.1 M13.5,2.5 L13.5,5.7 L10.3,5.7" /></Button></WrapPanel>
                      <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" />
                    </StackPanel>
                  </Expander>
                </StackPanel></Border>
                <Expander Header="Native account trial · advanced" Margin="0,0,0,8">
                  <Border Style="{StaticResource SurfaceCard}" Padding="16,14" Margin="0,8,0,0">
                    <StackPanel>
                      <TextBlock Text="{Binding NativeTrialSelection}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding NativeTrialInstallation}" Style="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                      <WrapPanel Margin="0,12,0,0">
                        <Button Content="Review selected-account trial" Click="StartNativeTrialClick" IsEnabled="{Binding CanRunNativeTrial}" MinHeight="36" Margin="0,0,8,8" />
                        <Button Content="Stop trial" Command="{Binding CancelNativeTrial}" Style="{StaticResource QuietButton}" MinHeight="36" Margin="0,0,8,8" />
                        <Button Content="Review accounts and record test" Command="{Binding ShowJoinStep}" CommandParameter="3" Style="{StaticResource QuietButton}" MinHeight="36" Margin="0,0,0,8" />
                      </WrapPanel>
                      <TextBlock Text="{Binding NativeTrialStatus}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </Expander>
              </StackPanel>
              <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="0" VerticalAlignment="Top" ClipToBounds="True">
                <StackPanel>
                  <Border DataContext="{Binding GameDetails.Gallery}" Background="{DynamicResource AppBackground}" CornerRadius="8,8,0,0">
                    <StackPanel>
                      <Grid Height="190" ClipToBounds="True">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="300" Margin="20" Visibility="{Binding ShowPlaceholder, Converter={StaticResource VisibleIf}}"><TextBlock Text="{Binding EmptyTitle}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" /><TextBlock Text="{Binding EmptyDescription}" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,6,0,0" /></StackPanel>
                        <Image Source="{Binding Image}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasImage, Converter={StaticResource VisibleIf}}" AutomationProperties.Name="Selected experience gallery picture" />
                      </Grid>
                      <Grid Margin="10,6,10,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button Content="← Previous" Command="{Binding Previous}" IsEnabled="{Binding CanBrowse}" Style="{StaticResource QuietButton}" MinHeight="28" AutomationProperties.Name="Previous experience picture" />
                        <TextBlock Grid.Column="1" Text="{Binding Position}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                        <Button Grid.Column="2" Content="Next →" Command="{Binding Next}" IsEnabled="{Binding CanBrowse}" Style="{StaticResource QuietButton}" MinHeight="28" AutomationProperties.Name="Next experience picture" />
                      </Grid>
                      <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" FontSize="11" Margin="14,0,14,8" />
                    </StackPanel>
                  </Border>
                  <StackPanel Margin="20,16,20,20">
                    <StackPanel DataContext="{Binding GameDetails}">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Width="44" Height="44" VerticalAlignment="Top" Margin="0,0,12,0"><Grid.Clip><RectangleGeometry Rect="0,0,44,44" RadiusX="8" RadiusY="8" /></Grid.Clip><Border Background="{DynamicResource SurfaceBackground}" /><Path Style="{StaticResource Glyph}" Stroke="{DynamicResource TextMuted}" Data="M3,5 L13,5 Q15,5 15,8 L15,9 Q15,12 12,12 L4,12 Q1,12 1,9 L1,8 Q1,5 3,5 Z M4.5,8.5 L7,8.5 M5.8,7.2 L5.8,9.8" /><Image Source="{Binding Icon}" Width="44" Height="44" Stretch="UniformToFill" Visibility="{Binding HasIcon, Converter={StaticResource VisibleIf}}" AutomationProperties.Name="Public experience icon" /></Grid>
                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Creator}" Style="{StaticResource Caption}" Margin="0,2,0,0" /></StackPanel>
                      </Grid>
                      <TextBlock Text="{Binding Activity}" Margin="0,12,0,0" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Identifiers}" Style="{StaticResource MonoText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                      <TextBlock Text="{Binding Observed}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                      <WrapPanel Margin="0,10,0,0"><Button Content="Load game details" Command="{Binding Load}" IsEnabled="{Binding CanLoad}" Style="{StaticResource QuietButton}" Margin="0,0,4,4" /><Button Content="Cancel details" Command="{Binding Cancel}" IsEnabled="{Binding IsBusy}" Style="{StaticResource QuietButton}" Margin="0,0,4,4" /></WrapPanel>
                      <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" ToolTip="Experience-wide counts are separate from server occupancy. Loading details never replaces a requested subplace or proves access or arrival." />
                    </StackPanel>
                    <Border Style="{StaticResource Divider}" />
                    <StackPanel DataContext="{Binding ServerBrowser}">
                      <Button Content="{Binding QuickJoinLabel}" Command="{Binding DataContext.LaunchTargetedAccounts, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanQueueTargetedLaunch, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" MinHeight="36" ToolTip="{Binding QuickJoinToolTip}" />
                      <Button Content="Choose accounts / set up launch" Command="{Binding DataContext.ShowJoinStep, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="3" IsEnabled="{Binding CanUseDestination}" MinHeight="36" Margin="0,8,0,0" />
                      <Button Content="Browse servers" Command="{Binding DataContext.ShowJoinStep, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="2" MinHeight="36" Margin="0,8,0,0" />
                      <WrapPanel Margin="0,8,0,0">
                        <Button Content="Open on Roblox.com" Click="OpenGamePageClick" IsEnabled="{Binding CanUseDestination}" Style="{StaticResource QuietButton}" MinHeight="36" Margin="0,0,4,0" ToolTip="Open this game's public Roblox page in your browser. Nothing is launched or signed in." />
                        <Button Content="Copy link" Click="CopyGamePageLinkClick" IsEnabled="{Binding CanUseDestination}" Style="{StaticResource QuietButton}" MinHeight="36" ToolTip="Copy the public game page link. IDs only; never a server, share or private code." />
                      </WrapPanel>
                      <TextBlock Text="Opens the Roblox client for each account. Zenith shows launch progress; arrival is checked, not reserved." Style="{StaticResource Caption}" Margin="0,10,0,0" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>

            <!-- ===== Step 2 · Browse servers (public list or a private server link) ===== -->
            <Grid Visibility="{Binding IsJoinServerStep, Converter={StaticResource VisibleIf}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>
              <StackPanel DataContext="{Binding ServerBrowser}">
                <Border Style="{StaticResource SegmentBar}" Margin="0,0,0,14">
                  <StackPanel Orientation="Horizontal">
                    <Button Content="Public servers" Command="{Binding DataContext.ShowServerTab, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Public" Tag="{Binding DataContext.IsPublicServerTab, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SegmentButton}" />
                    <Button Content="Private server" Command="{Binding DataContext.ShowServerTab, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Private" Tag="{Binding DataContext.IsPrivateServerTab, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SegmentButton}" Margin="2,0,0,0" />
                  </StackPanel>
                </Border>
                <StackPanel Visibility="{Binding DataContext.IsPublicServerTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleIf}}">
                  <WrapPanel Margin="0,0,0,6"><ComboBox ItemsSource="{Binding ServerOrderChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedServerOrder}" MinWidth="230" MinHeight="32" Margin="0,0,14,8" AutomationProperties.Name="Public server order" ToolTip="Server order" /><CheckBox Content="Hide full servers" IsChecked="{Binding HideFull}" VerticalAlignment="Center" Margin="0,0,14,8" /><Button Content="Browse public servers" Command="{Binding Browse}" IsEnabled="{Binding CanUseDestination}" Margin="0,0,4,8" /><Button Content="{Binding DataContext.DestinationRecipientCount, RelativeSource={RelativeSource AncestorType=Window}}" ContentStringFormat="Find a server with room for {0}" Command="{Binding FindRoom}" CommandParameter="{Binding DataContext.DestinationRecipientCount, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.CanFindServerWithRoom, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="Find a server with room" Margin="0,0,4,8" ToolTip="Ask Roblox once for up to 100 public servers that are not full, most full first, and use the fullest one with room for the checked accounts (or the selected account) plus a spare seat, or else exactly enough room. The list below is not changed, and seats are not reserved." /><Button Content="Load next 25" Command="{Binding Next}" IsEnabled="{Binding CanNext}" Style="{StaticResource QuietButton}" Margin="0,0,4,8" ToolTip="Add the next 25 servers to the loaded list. A server seen again shows only its newest observation, and the list keeps the newest 100." /><Button Content="Cancel browsing" Command="{Binding Cancel}" IsEnabled="{Binding IsBusy}" Style="{StaticResource QuietButton}" Margin="0,0,4,8" /></WrapPanel>
                  <TextBlock Text="{Binding OrderingExplanation}" Style="{StaticResource Caption}" Margin="0,0,0,10" />
