              <TextBlock Text="Roblox keeps a log for every Player client it has run, in your user folder. Check old logs counts the Player logs older than the days you choose (file names containing _Player_) and shows their total size; Studio logs are left alone. Nothing is deleted until you confirm. Logs newer than that, logs a running client still holds and logs Zenith is watching for session evidence are always kept, and each file is checked again just before it is deleted. Roblox's settings are not changed." Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
              <WrapPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,8"><TextBlock Text="Older than" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="ClientLogCleanupDaysBox" Text="{Binding ClientLogCleanupDays, UpdateSourceTrigger=PropertyChanged}" Width="64" MaxLength="4" MinHeight="36" VerticalContentAlignment="Center" IsEnabled="{Binding CanSurveyClientLogs}" AutomationProperties.Name="Roblox client logs older than this many days" /><TextBlock Text="days" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0" /></StackPanel>
