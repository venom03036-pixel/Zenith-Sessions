              <TextBlock Text="{local:Text Appearance_DiscordApplicationId}" VerticalAlignment="Center" Margin="0,0,12,8" />
              <TextBox x:Name="SettingsDiscordApplicationId" Text="{Binding DiscordApplicationId, UpdateSourceTrigger=PropertyChanged}" MinWidth="220" MinHeight="36" VerticalContentAlignment="Center" Margin="0,0,8,8" AutomationProperties.Name="{local:Text Appearance_DiscordApplicationId}" ToolTip="{local:Text Appearance_DiscordApplicationIdTooltip}" />
              <Button x:Name="SettingsResumeDiscordPresence" Content="{local:Text Appearance_ResumeDiscordPresence}" Command="{Binding ResumeDiscordPresence}" IsEnabled="{Binding CanResumeDiscordPresence}" ToolTip="{local:Text Appearance_ResumeDiscordPresenceTooltip}" AutomationProperties.Name="{local:Text Appearance_ResumeDiscordPresence}" MinHeight="36" Margin="0,0,8,8" />
            </WrapPanel>
            <TextBlock Text="{Binding DiscordPresenceStatus}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{local:Text Appearance_PanicShortcut}" VerticalAlignment="Center" Margin="0,0,12,0" />
              <TextBox x:Name="SettingsPanicShortcut" Text="{Binding PanicShortcutText, UpdateSourceTrigger=PropertyChanged}" MinWidth="170" MinHeight="36" VerticalContentAlignment="Center" AutomationProperties.Name="{local:Text Appearance_PanicShortcut}" />
            </StackPanel>
            <TextBlock Text="{local:Text Appearance_PanicShortcutDescription}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,4" />
            <TextBlock Text="{Binding PanicShortcutStatus}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16" />
            <WrapPanel>
              <TextBlock Text="{local:Text Appearance_KeepAwake}" VerticalAlignment="Center" Margin="0,0,12,8" />
              <ComboBox x:Name="SettingsKeepAwake" ItemsSource="{Binding KeepAwakeChoices}" DisplayMemberPath="Label" SelectedValuePath="Minutes" SelectedValue="{Binding KeepAwakeMinutes}" MinWidth="170" MinHeight="36" Margin="0,0,12,8" AutomationProperties.Name="{local:Text Appearance_KeepAwake}" />
              <Button x:Name="ResumeKeepAwakeButton" Content="{local:Text Appearance_ResumeKeepAwake}" Command="{Binding ResumeKeepAwake}" IsEnabled="{Binding CanResumeKeepAwake}" MinHeight="36" Margin="0,0,0,8" />
            </WrapPanel>
            <TextBlock Text="{local:Text Appearance_KeepAwakeDescription}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
            <TextBlock x:Name="SettingsKeepAwakeStatus" Text="{Binding KeepAwakeStatus}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,24" />
            <TextBlock x:Name="SettingsShutdownAnchor" Text="Scheduled shutdown" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" Focusable="True" AutomationProperties.Name="Scheduled shutdown" />
            <TextBlock Text="Nothing is scheduled unless you ask here, and the choice is not saved. Schedule shutdown asks Windows' own shutdown tool to turn this PC off after the chosen time; Windows then closes every program, Roblox clients included, without saving their work. The countdown shows here and in the footer on every page. Cancel shutdown calls it off, and so do Panic and Exit; Lock and the idle lock leave it in place. Not available in sample mode." Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
            <WrapPanel>
              <TextBlock Text="Shut down this PC" VerticalAlignment="Center" Margin="0,0,12,8" />
              <ComboBox x:Name="SettingsShutdownDelay" ItemsSource="{Binding ShutdownDelayChoices}" DisplayMemberPath="Label" SelectedValuePath="Minutes" SelectedValue="{Binding ShutdownMinutes}" IsEnabled="{Binding CanScheduleShutdown}" MinWidth="200" MinHeight="36" Margin="0,0,8,8" AutomationProperties.Name="Shut down this PC after" />
              <Button x:Name="SettingsScheduleShutdown" Content="Schedule shutdown" Command="{Binding ScheduleShutdown}" IsEnabled="{Binding CanScheduleShutdown}" ToolTip="Ask Windows to shut down this PC after the chosen time" AutomationProperties.Name="Schedule shutdown" MinHeight="36" Margin="0,0,8,8" />
              <Button x:Name="SettingsCancelShutdown" Content="Cancel shutdown" Command="{Binding CancelShutdown}" IsEnabled="{Binding CanCancelShutdown}" ToolTip="Ask Windows to call off the scheduled shutdown" AutomationProperties.Name="Cancel shutdown" MinHeight="36" Margin="0,0,8,8" />
            </WrapPanel>
            <TextBlock Text="{Binding ShutdownStatus}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,24" />
            <Border Style="{StaticResource Panel}" Margin="0,0,0,24">
              <StackPanel>
                <TextBlock x:Name="SettingsPerformanceAnchor" Text="Performance profile" Style="{StaticResource SectionTitle}" />
                <ComboBox x:Name="SettingsPerformanceProfile" ItemsSource="{Binding PerformanceProfiles}" SelectedItem="{Binding SelectedPerformanceProfile}" DisplayMemberPath="Name" Width="300" HorizontalAlignment="Left" Margin="0,12,0,12" AutomationProperties.Name="Performance profile" />
                <TextBlock Text="{Binding PerformanceExplanation}" Style="{StaticResource Muted}" />
                <TextBlock Text="{Binding ActivePerformanceSummary}" Foreground="{DynamicResource AccentPrimary}" TextWrapping="Wrap" Margin="0,10,0,0" />
                <TextBlock Text="{Binding PerformanceMonitorStatus}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
                <CheckBox x:Name="SettingsClientGpu" Content="Show each client's GPU use" IsChecked="{Binding ShowClientGpu}" HorizontalAlignment="Left" MinHeight="36" Margin="0,14,0,0" AutomationProperties.Name="Show each client's GPU use" />
                <TextBlock Text="Off by default. When on and saved, the Sessions table shows each client's busiest GPU engine and dedicated GPU memory next to CPU and memory, from Windows' per-process GPU counters at the same one-second cadence. A value is credited to a client only when its process ID carried the same start time just before and just after the reading, so a reused process ID is never credited; anything unknown stays Unavailable, never 0. Nothing in Roblox is changed." Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
                <TextBlock Text="Main saved account" FontWeight="SemiBold" Margin="0,18,0,6" />
                <TextBlock Text="{Binding MainAccountDisplay}" TextWrapping="Wrap" />
                <WrapPanel Margin="0,10,0,0"><Button Content="Use selected library account" Command="{Binding SetSelectedAsMain}" Margin="0,0,8,8" /><Button Content="Clear main account" Command="{Binding ClearMainAccount}" Margin="0,0,0,8" /></WrapPanel>
                <TextBlock Text="Choose an account in the library, then use it here. Main Account Priority affects eligible launch order only; profile priorities and waiting-age fairness remain active." Style="{StaticResource Muted}" FontSize="12" />
                <StackPanel Visibility="{Binding IsCustomPerformance, Converter={StaticResource VisibleIf}}" Margin="0,18,0,0">
                  <TextBlock Text="Custom timing · milliseconds" FontWeight="SemiBold" Margin="0,0,0,10" />
                  <WrapPanel>
                    <StackPanel Width="200" Margin="0,0,14,14"><TextBlock Text="Process details · 500–5000" Margin="0,0,0,6" /><TextBox x:Name="SettingsCustomTiming" Text="{Binding CustomProcessSample, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" AutomationProperties.Name="Process details interval in milliseconds" /></StackPanel>
                    <StackPanel Width="200" Margin="0,0,14,14"><TextBlock Text="Dashboard · 250–2000" Margin="0,0,0,6" /><TextBox x:Name="SettingsDashboardTiming" Text="{Binding CustomPresentation, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" AutomationProperties.Name="Dashboard interval in milliseconds" /></StackPanel>
                    <StackPanel Width="200" Margin="0,0,14,14"><TextBlock Text="Launch spacing · 1000–30000" Margin="0,0,0,6" /><TextBox x:Name="SettingsLaunchSpacing" Text="{Binding CustomStagger, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" AutomationProperties.Name="Launch spacing in milliseconds" /></StackPanel>
                    <StackPanel Width="200" Margin="0,0,0,14"><TextBlock Text="Stabilization · 20000–120000" Margin="0,0,0,6" /><TextBox x:Name="SettingsStabilizationTiming" Text="{Binding CustomStabilization, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" AutomationProperties.Name="Launch stabilization in milliseconds" /></StackPanel>
                  </WrapPanel>
                </StackPanel>
                <CheckBox x:Name="ShortenWaitAfterJoinOption" Content="Shorten the wait between starts when the previous client reports it joined" IsChecked="{Binding ShortenWaitAfterJoin}" MinHeight="36" VerticalContentAlignment="Center" Margin="0,14,0,0" AutomationProperties.Name="Shorten the wait between starts when the previous client reports it joined" />
                <TextBlock Text="Off by default. When on, a startup stabilization wait ends as soon as the started client's own log reports it joined, but never before the launch spacing has passed since its start and never later than the full stabilization. The report is diagnostic: fresh resources, provider eligibility and one start at a time are still required, and without a report the full wait stays. Applies after Save settings." Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
                <TextBlock Text="{Binding PerformancePendingCapabilities}" Style="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0" />
                <WrapPanel Margin="0,16,0,0"><Button Content="Save settings" Command="{Binding SaveSettings}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8" /><Button Content="Reset custom timing" Command="{Binding ResetCustomPerformance}" Margin="0,0,0,8" /></WrapPanel>
                <TextBlock Text="Save commits all valid settings. Timing changes apply to future starts; an active launch keeps its original pacing. Performance gains require measurement." Style="{StaticResource Muted}" FontSize="12" />
                <Expander x:Name="SettingsPerformanceTransfer" Header="Share manager performance settings" Margin="0,18,0,0" Focusable="True">
                  <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Only the selected profile and its timing values travel. Accounts, your main-account choice, sign-in, capacity guards, hotkeys and client settings stay local. A share code is readable transfer text, not encryption or proof of trust." Style="{StaticResource Muted}" FontSize="12" />
                    <WrapPanel Margin="0,12,0,0" IsEnabled="{Binding CanTransferPerformance}"><Button Content="Copy code" Click="CopyPerformanceShareCode" Margin="0,0,8,8" /><Button Content="Save to file…" Click="ExportPerformanceFile" Margin="0,0,8,8" /><Button Content="Review file…" Click="ImportPerformanceFile" Margin="0,0,8,8" /></WrapPanel>
                    <TextBox x:Name="SettingsPerformanceTransferInput" Text="{Binding PerformanceShareInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="5472" MinHeight="60" MaxHeight="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Performance share code to review" IsEnabled="{Binding CanTransferPerformance}" />
                    <WrapPanel Margin="0,8,0,0"><Button Content="Review code" Command="{Binding PreviewPerformanceCode}" IsEnabled="{Binding CanTransferPerformance}" Margin="0,0,8,8" /><Button Content="Cancel transfer" Command="{Binding CancelPerformanceTransfer}" IsEnabled="{Binding IsPerformanceTransferBusy}" Margin="0,0,8,8" /></WrapPanel>
                    <TextBlock Text="{Binding PerformanceTransferStatus}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8" />
                    <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" Padding="12" Visibility="{Binding HasPerformanceReview, Converter={StaticResource VisibleIf}}"><StackPanel><TextBlock Text="Review before applying" FontWeight="SemiBold" /><TextBlock Text="{Binding PerformanceReviewSummary}" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,12" /><WrapPanel IsEnabled="{Binding CanTransferPerformance}"><Button Content="Use in draft" Command="{Binding UsePerformanceReview}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" /><Button Content="Dismiss" Command="{Binding DismissPerformanceReview}" Margin="0,0,0,8" /></WrapPanel><TextBlock Text="Use in draft replaces the performance fields only. Save settings is still required; other pending preferences are retained." Style="{StaticResource Muted}" FontSize="12" /></StackPanel></Border>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
            <TextBlock x:Name="SettingsMemoryAnchor" Text="Memory policy" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Conservative starting estimates, not game requirements. CPU, provider support, and observed stability also constrain admission." Style="{StaticResource Muted}" Margin="0,8,0,16" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="220" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,14,0">
                <TextBlock Text="Minimum spare RAM (GiB)" Margin="0,0,0,8" />
                <TextBox x:Name="SettingsSpareRam" Text="{Binding SpareRam, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Minimum spare RAM in GiB" />
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,14,0">
                <TextBlock Text="New-client physical (GiB)" Margin="0,0,0,8" />
                <TextBox x:Name="SettingsPhysicalPerClient" Text="{Binding PhysicalPerClient, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New client physical memory estimate in GiB" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="New-client commit (GiB)" Margin="0,0,0,8" />
                <TextBox x:Name="SettingsCommitPerClient" Text="{Binding CommitPerClient, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="New client commit estimate in GiB" />
              </StackPanel>
            </Grid>
            <TextBlock Text="Saved per-client estimates apply to new requests. Existing requests keep the estimate shown in the queue; cancel and create a fresh request to change it. These are provisional budgets, not measured Roblox consumption." Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" />
            <TextBlock Text="Optional maximum clients · blank means no user cap" Margin="0,20,0,8" />
            <TextBox x:Name="SettingsMaximumClients" Text="{Binding MaximumClients, UpdateSourceTrigger=PropertyChanged}" Width="206" HorizontalAlignment="Left" AutomationProperties.Name="Optional maximum clients" />
            <Border Style="{StaticResource Panel}" Margin="0,26,0,24">
              <StackPanel>
                <TextBlock x:Name="SettingsInstallationsAnchor" Text="Roblox installation" Style="{StaticResource SectionTitle}" Focusable="True" AutomationProperties.Name="Roblox installation settings" />
                <TextBlock Text="Inspect Roblox, Froststrap, Fishstrap, Bloxstrap and Voidstrap installation hints. A filename, registration or the product name written in the file does not verify the publisher, compatibility or a signed-in account. Refresh also asks Roblox's public version service, without signing in, which Windows player release is current and compares it with the players found. This check never opens, downloads or updates a program; a unique standard-player result may be suggested and preselected." Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,12" />
                <WrapPanel><Button Content="Refresh installation" Command="{Binding RefreshInstallations}" IsEnabled="{Binding CanRefreshInstallations}" Margin="0,0,8,8" /><Button Content="Cancel check" Command="{Binding CancelInstallationDiscovery}" IsEnabled="{Binding IsInstallationDiscoveryBusy}" Margin="0,0,8,8" /><TextBlock Text="{Binding InstallationObserved}" VerticalAlignment="Center" Margin="0,0,0,8" Style="{StaticResource Muted}" /></WrapPanel>
                <TextBlock Text="{Binding InstallationStatus}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10" />
                <TextBlock Text="{Binding InstallationReleaseStatus}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10" AutomationProperties.Name="Roblox release comparison" />
                <TextBlock Text="Roblox updates. With the check below saved on, Zenith asks Roblox's public version service for its current release 3 seconds after start and every 30 minutes (refreshing this list when no row is selected) and tells you once when the installed Roblox player is behind. Download Roblox update fetches Roblox's own installer for that release from setup.rbxcdn.com (at most 64 MB) into a temporary folder and has Windows verify its signature from Roblox Corporation; nothing is run. Install Roblox update asks first, warns about running clients (Roblox's installer closes every Roblox client while it updates), then runs the verified file and waits for it. Zenith changes no Roblox setting or file itself." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap" />
                <CheckBox x:Name="CheckRobloxUpdatesOption" Content="Check for Roblox updates automatically (3 seconds after start, then every 30 minutes; saves with Save settings)" IsChecked="{Binding CheckRobloxUpdates}" MinHeight="36" VerticalContentAlignment="Center" Margin="0,0,0,4" AutomationProperties.Name="Check for Roblox updates automatically" />
                <TextBlock Text="{Binding RobloxUpdateCheckStatus}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap" AutomationProperties.Name="Automatic Roblox update check status" />
                <WrapPanel>
                  <Button x:Name="DownloadRobloxUpdateButton" Content="Download Roblox update" Command="{Binding DownloadRobloxUpdate}" IsEnabled="{Binding CanDownloadRobloxUpdate}" Margin="0,0,8,8" ToolTip="Downloads Roblox's own installer for the current release into a temporary folder and checks its signature. Nothing is run." />
                  <Button x:Name="InstallRobloxUpdateButton" Content="Install Roblox update…" Click="InstallRobloxUpdate" IsEnabled="{Binding CanInstallRobloxUpdate}" Margin="0,0,8,8" ToolTip="Asks first, then runs the verified installer and waits for it." />
                  <Button Content="Cancel" Command="{Binding CancelRobloxUpdate}" IsEnabled="{Binding IsRobloxUpdateBusy}" Style="{StaticResource QuietButton}" Margin="0,0,8,8" ToolTip="Stops a download, or stops waiting for a started installer; a running installer is not closed." />
                </WrapPanel>
                <TextBlock Text="{Binding ClientUpdateStatus}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap" AutomationProperties.Name="Roblox update status" />
                <ListView ItemsSource="{Binding InstallationCandidates}" SelectedItem="{Binding SelectedInstallation}" MaxHeight="220" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Unverified installation candidates"><ListView.View><GridView><GridViewColumn Header="Suggested" Width="90" DisplayMemberBinding="{Binding Suggestion}" /><GridViewColumn Header="Product" Width="190" DisplayMemberBinding="{Binding Product}" /><GridViewColumn Header="Product named in file (unverified)" Width="230" DisplayMemberBinding="{Binding ReportedProductName}" /><GridViewColumn Header="Version" Width="130" DisplayMemberBinding="{Binding Version}" /><GridViewColumn Header="Release" Width="130" DisplayMemberBinding="{Binding ReleaseStatus}" /><GridViewColumn Header="File status" Width="195" DisplayMemberBinding="{Binding FileState}" /><GridViewColumn Header="Evidence" Width="390" DisplayMemberBinding="{Binding Evidence}" /></GridView></ListView.View></ListView>
                <TextBlock Text="Select the installed Roblox player to use for saved-account launches. Refresh suggests a standard player when the detected installation is unambiguous. Direct ticket checks the account and executable publisher on every launch; no recorded trial is required. Changing the installation stops pending preparation and pauses the queue. Bootstrapper rows are available for inspection; use the standard Roblox player for this build." Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,6" TextWrapping="Wrap" />
                <TextBox Text="{Binding SelectedInstallation.ExecutablePath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="36" MaxHeight="90" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Selected installation executable path" />
                <TextBlock Text="{Binding NativeTrialStatus}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.Name="Native trial installation status" />
                <TextBlock Text="Native launch mode" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                <ComboBox x:Name="SettingsNativeLaunchMode" ItemsSource="{x:Static local:ShellViewModel.NativeLaunchModeOptions}" SelectedItem="{Binding SelectedNativeLaunchMode}" DisplayMemberPath="Name" Width="300" HorizontalAlignment="Left" AutomationProperties.Name="Native launch mode" ToolTip="How an explicit native trial gets its launch request. Save settings to apply." />
                <TextBlock Text="{Binding SelectedNativeLaunchMode.Description}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding NativeLaunchModeStatus}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" AutomationProperties.Name="Saved native launch mode" />
                <TextBlock Text="Ordinary launching" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                <TextBlock x:Name="SettingsNativeLaunchVerification" Text="{Binding NativeLaunchVerificationStatus}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Focusable="True" AutomationProperties.Name="Saved account launch availability" />
                <WrapPanel Margin="0,6,0,0"><Button Content="Forget verified trial" Command="{Binding ForgetNativeLaunchVerification}" IsEnabled="{Binding CanForgetNativeLaunchVerification}" Margin="0,0,8,8" ToolTip="Turn ordinary and group launching off again for the saved launch mode and the selected installation by forgetting the trial recorded as verified for them. The launch queue is paused; explicit trials are offered again." /></WrapPanel>
                <TextBlock Text="Off by default. Ordinary and group launch requests are recorded blocked until, in Join a game, one explicit trial's started client reports the expected player in the requested place and you choose Record this trial as verified. The record (mode, installation, time, the trial's request and process receipt) is saved in settings.json; it holds no sign-in material. It applies to that launch mode and installation only, and every request still passes the same checks as a trial, one start at a time." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,0" TextWrapping="Wrap" />
                <TextBlock Text="Extra client arguments · default for every account" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                <TextBox x:Name="SettingsDefaultClientArguments" Text="{Binding DefaultClientArguments, UpdateSourceTrigger=PropertyChanged}" MaxLength="512" MinHeight="36" AutomationProperties.Name="Extra client arguments default" ToolTip="Added after Roblox's own launch request when Zenith starts the selected native Roblox player itself. Never enter sign-in cookies or tokens." />
                <TextBlock Text="Off until you enter something. These arguments are added after Roblox's own launch request only when Zenith starts the selected native Roblox player itself, never through Bloxstrap, Fishstrap, Froststrap or Voidstrap. Up to 512 characters and 16 arguments separated by spaces, using letters, digits and - _ . : / = + , @ # ~ [ ] { } ( ); quotes, percent signs, &lt; &gt; | &amp;, backslashes and line breaks are refused. An account's own arguments in Edit account profile replace this default for that account. Save settings to apply; the trial review names the arguments it will pass. They are never written to logs, diagnostics or metadata exports." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                <WrapPanel Margin="0,10,0,0"><Button Content="Verify publisher" Command="{Binding VerifyInstallationPublisher}" IsEnabled="{Binding CanVerifyInstallationPublisher}" Margin="0,0,8,8" ToolTip="Check the selected file's Authenticode signature with cached Windows trust evidence: the Roblox player must be signed by Roblox Corporation; a bootstrapper's own executable shows its signer for you to accept." /><Button Content="Cancel verification" Command="{Binding CancelPublisherVerification}" IsEnabled="{Binding IsPublisherVerificationBusy}" Margin="0,0,8,8" /><Button x:Name="SettingsAcceptBootstrapperPublisher" Content="Accept publisher" Command="{Binding AcceptBootstrapperPublisher}" IsEnabled="{Binding CanAcceptBootstrapperPublisher}" Margin="0,0,8,8" ToolTip="Accept the verified signer shown in the status as the publisher of the selected bootstrapper, once per product. This saves publisher inspection only. Bootstrapper launching remains deferred in this build." /><Button Content="Forget accepted publisher" Command="{Binding ForgetBootstrapperPublisher}" IsEnabled="{Binding CanForgetBootstrapperPublisher}" Margin="0,0,8,8" ToolTip="Forget the selected bootstrapper's saved publisher. Bootstrapper launching remains deferred." /></WrapPanel>
                <TextBlock Text="{Binding PublisherVerificationStatus}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                <TextBlock x:Name="SettingsBootstrapperLaunch" Text="{Binding BootstrapperLaunchStatus}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Focusable="True" AutomationProperties.Name="Launch through a bootstrapper" />
                <TextBlock Text="Offline verification uses locally cached Windows trust information. Missing chain or revocation information remains unknown. A verified publisher does not authorize account selection, multi-instance launching or future file contents. Bootstrapper launching is deferred in this build; accepting its publisher does not enable trials or ordinary launches." Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" />
                <ItemsControl ItemsSource="{Binding InstallationIssues}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel>
            </Border>
            <TextBlock x:Name="SettingsSignInAnchor" Text="Saved Roblox sign-ins" Style="{StaticResource SectionTitle}" Margin="0,26,0,8" Focusable="True" AutomationProperties.Name="Saved Roblox sign-in settings" />
            <TextBlock Text="{Binding VaultPasswordStatusText}" Style="{StaticResource Muted}" Margin="0,0,0,10" />
            <WrapPanel Margin="0,0,0,12"><Button Content="{Binding VaultPasswordPrimaryLabel}" Click="UseVaultPasswordPrimary" IsEnabled="{Binding CanUseVaultPasswordPrimary}" /><Button Content="Disable master password…" Click="DisableVaultPassword" IsEnabled="{Binding CanDisableVaultPassword}" Margin="8,0,0,0" /><Button Content="Forget protected sign-ins…" Click="ForgetProtectedSignIns" IsEnabled="{Binding CanForgetProtectedSignIns}" Margin="8,0,0,0" /></WrapPanel>
            <TextBlock Text="No developer registration is needed. On Accounts, select a profile and choose Sign in with Roblox. Finish sign-in on Roblox’s own page, then explicitly save that account’s session. Each session is encrypted for your Windows account and verified against its Roblox user ID." Style="{StaticResource Muted}" Margin="0,0,0,10" />
            <TextBlock Text="Microsoft Edge WebView2 Runtime is required. Password saving, autofill, downloads and pop-ups are disabled. Navigation permits Roblox and the exact Google or Apple sign-in hosts; saving remains on Roblox. Browser data is removed after sign-in unless the option below is saved on." Style="{StaticResource Muted}" Margin="0,0,0,10" />
            <CheckBox Content="Keep sign-in browser device data" IsChecked="{Binding KeepSignInBrowserData}" Margin="0,0,0,8" />
            <TextBlock Text="Optional, off by default. Keeps Roblox device and tracking cookies on disk under the data folder, using WebView2's own Windows protection for cookies. The Roblox session cookie is removed before and after each sign-in. Google or Apple sign-in clears this browser data afterwards. Fewer challenges are not guaranteed. Turning this off stops reuse; use Forget to remove the kept data." Style="{StaticResource Muted}" Margin="0,0,0,10" />
            <Button Content="Forget kept sign-in browser data" Command="{Binding ForgetSignInBrowserData}" HorizontalAlignment="Left" Margin="0,0,0,12" />
            <TextBlock Text="Saved sign-in does not by itself prove account-specific native launch, simultaneous clients, or arrival in a game. Those controls stay unavailable until their independent checks pass." Style="{StaticResource Muted}" Margin="0,0,0,20" />
            <StackPanel Orientation="Horizontal">
              <Button x:Name="SettingsSaveButton" Content="Save settings" Command="{Binding SaveSettings}" Style="{StaticResource PrimaryButton}" />
              <Button Content="Open settings folder" Command="{Binding OpenFolder}" Margin="12,0,0,0" />
              <TextBlock Text="{Binding SaveStatus}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{DynamicResource TextSecondary}" />
            </StackPanel>
            <TextBlock x:Name="SettingsRecoveryAnchor" Text="Protected-file recovery" Style="{StaticResource SectionTitle}" Margin="0,26,0,8" />
            <TextBlock Text="{Binding DataEncryptionStatus}" Style="{StaticResource Muted}" />
            <WrapPanel Margin="0,10,0,12"><Button Content="Encrypt data folder with Windows EFS…" Click="EncryptDataFolder" IsEnabled="{Binding CanEncryptDataFolder}" /><Button Content="Cancel encryption" Command="{Binding CancelDataEncryption}" IsEnabled="{Binding IsEncryptingDataFolder}" Margin="8,0,0,0" /></WrapPanel>
            <TextBlock Text="{Binding CredentialCleanupStatus}" Style="{StaticResource Muted}" />
            <Button x:Name="SettingsRecoveryButton" Content="Retry credential cleanup" Command="{Binding CleanupCredentials}" HorizontalAlignment="Left" Margin="0,12,0,16" />
            <Expander x:Name="SettingsReleaseUpdates" Header="Zenith updates" DataContext="{Binding ReleaseUpdates}" Margin="0,10,0,16">
              <StackPanel Margin="0,10,0,0">
                <TextBlock Text="Updates stay off until the release feed and trusted publisher are configured. A check can download a verified package; it never installs one automatically. Approval for the next start asks you again before installation." Style="{StaticResource Muted}" Margin="0,0,0,12" />
                <TextBlock Text="Release feed URL" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding FeedUri, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Release feed URL" Margin="0,4,0,10" />
                <TextBlock Text="Publisher certificate SHA-256" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding PublisherCertificateSha256, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Publisher certificate SHA-256" Margin="0,4,0,10" />
                <CheckBox Content="Check daily while Zenith is open" IsChecked="{Binding CheckDaily}" Margin="0,0,0,10" />
                <WrapPanel>
                  <Button Content="Save update settings" Command="{Binding Save}" Margin="0,0,8,8" />
                  <Button Content="Check now" Command="{Binding CheckNow}" Margin="0,0,8,8" />
                  <Button Content="Stop check" Command="{Binding Stop}" Margin="0,0,8,8" />
                  <Button Content="Approve for next start…" Command="{Binding ApproveNextStart}" Margin="0,0,8,8" />
                  <Button Content="Cancel approval" Command="{Binding CancelApproval}" Margin="0,0,8,8" />
                  <Button Content="Discard downloaded update" Command="{Binding DiscardPending}" Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer Visibility="{Binding IsGuide, Converter={StaticResource VisibleIf}}" VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{local:Text Page_Guide}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding InstanceTitle, Mode=OneTime}" Style="{StaticResource Caption}" Margin="0,2,0,20" />
            <TextBlock Text="Sessions shows observed clients and window controls. Choose Join a game there, or from Overview, to search and review a destination. Back to sessions returns to the same client view. Automation contains the saved macro catalog and assignments. Opening Join a game never starts a client, searches Roblox or enables previews." Style="{StaticResource Muted}" Margin="0,0,0,24" />
            <TextBlock Text="{local:Text GuideHeading_AccountLibrary}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Open Accounts and choose + Add account. Complete sign-in on Roblox’s own page, then choose Save this Roblox sign-in. Zenith checks the player ID before creating an account named from its verified username. Closing sign-in before verification creates no account. If a save was already committed, cancellation preserves it for review. Already-saved Roblox identities require review rather than silently replacing their sign-in. Use Profile only… when you want optional local metadata without signing in. Select a row to edit notes, groups or preferences; these fields never authorize a launch. Group filters include all memberships. Manage groups reviews a rename or removal across the whole library, including accounts on other pages. Choose a fallback when removing a primary group; saved accounts and sign-ins stay in place. Existing target names require explicit merge approval and a new review. Editing names or a reviewed account invalidates the old review. Dense view fits more accounts, and metadata exports exclude sign-in material." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="Saved groups can be empty. In Manage groups, create a name, choose a named color or HEX value, and use Move up/down to organize the group list. Follow theme uses the current accent. Colors and group order do not change account priority, launches or sign-ins. Search and pages in the manager reach groups beyond the bounded filter suggestions. Profile metadata exports include membership names, but exclude empty groups, colors and group order." Style="{StaticResource Muted}" Margin="0,0,0,24" />
            <TextBlock Text="{local:Text GuideHeading_Identity}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="A profile is your local record. A session is an observed native process. A typed username does not prove which account a client uses. Sessions displays process identity and resources without claiming account or server information that has not been verified." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_NativeSessions}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Account setup may use Roblox's sign-in page. Games must open in the native Roblox application, never in a browser window. Native account selection and launching are awaiting isolated verification; this preview does not substitute your browser's current account. Sessions → Focus requests foreground activation of an observed native window. Close asks that selected, revalidated process window to close normally, asks again after a moment so Roblox's own leave prompt is answered, and waits a few seconds for the process to exit; a confirmation appears first. If the client is still open after that wait, Force close appears on its row: it ends the process at once after a second confirmation that names the client, loses unsaved game activity, and is recorded in Recent clients as a forced end. Nothing is ever ended without that confirmation, and Panic or Lock withdraws the offer." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_Headroom}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Overview separates available physical RAM from system commit. Capacity estimates reserve spare memory and a provisional cost for each new client. Each queued request keeps its own physical and commit estimate; changing the defaults applies to new requests. The queue shows the pinned estimate. A recovered possible client without a recorded estimate needs closure review before another start. Unknown GPU values stay unavailable. A memory estimate never authorizes additional Roblox clients or proves background automation support." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_SettingsData}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Themes apply immediately. Save settings commits view and capacity preferences; the saved indicator changes only after writing succeeds. In Settings, use its search or Ctrl+F to find an existing control, then open a result. Search changes no preference or pending draft. Custom timing stays hidden until you explicitly choose Custom. User data stays outside the application folder. Export contains metadata only, never authorization. Imports create new local profiles and require sign-in separately. Preserve damaged files if a recovery error is reported." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_Favorites}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="In Sessions → Join a game, enter a public game name, place ID or supported game/server link and choose Search / Use. For a name, choose a result card to make that game your requested destination; no result is chosen automatically. Browse public servers if needed, then use a selected server as your requested destination. Under Favorite destinations, enter a name and choose Save current as new. Use favorite restores that request without launching or contacting Roblox; Rename selected changes its name, and Remove selected asks for confirmation. Copy requested link copies IDs only. Favorites stay in your writable data folder, separate from account authorization, and do not reserve a server seat." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_Bundles}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="In Accounts, check the profiles to save together. In Sessions → Join a game → Who is launching → Edit bundles, enter a name and choose Save checked page as new. Switch account pages and use Add checked to bundle to extend the same bundle. Review members shows current profile existence and last-known player IDs. Missing profiles block the entire bundle request until you explicitly remove missing references or replace recipients. Choose a game or server link above, then Queue bundle for this destination. Before you queue, the bundle card compares every saved recipient in the selected bundle with the used server's reported open slots. Recipients and target are pinned for that request; later bundle edits affect future requests. Native support, sign-in and capacity checks still apply to every account. Stop bundle work cancels preparation and pending requests it created; a client that may already have started still requires review." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_LaunchInspection}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Select an account with a saved Roblox sign-in. In Sessions → Join a game, choose a game-only destination, then Inspect and prevent launch. This opens a fresh private official game page using only the selected saved session. Choose Play there: Zenith cancels the external request and retains only known field labels, counts and the reported page-gesture flag. No ticket or full launch address is displayed or saved, and no native client starts. After browser cleanup, the page's current session must verify as the same player before it is saved. Cancelled, incomplete, mismatched or failed checks leave sign-in needing review or renewal. A check refused before any page opens, because another private browser is still open or closing or an earlier cleanup did not finish, leaves the saved sign-in unchanged. Panic, Lock and profile removal wait for the actual operation owner. Exit waits at most 10 seconds for an inspection browser that is still closing; if it has not closed by then, Zenith Sessions exits anyway and removes that private browser folder at the next start. A captured handoff does not prove native account selection, server arrival, simultaneous clients or reconnect support; those need separate live tests." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_CpuPriority}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="In Sessions, open Client CPU priority. Check clients or select a row, then choose Normal, Below normal, Efficiency mode, Spread over cores or Cap CPU. Efficiency mode adds Windows EcoQoS power throttling and very low memory priority to Below normal. Spread over cores divides the CPU cores among the checked clients it can change; clients spread in separate operations can share cores. Cap CPU puts each checked client in a Windows job this run of Zenith creates for it (recorded in client-cpu-caps.json in the data folder) and limits that client's threads, together, to the chosen share of all CPU time on this PC: 10, 25, 50 or 75 percent. The cap may lower the client's frame rate when CPU time is the limiting factor. Nothing in the client is changed. Windows keeps a process in its job for life and only the run that created the job can reach it, so a client already in a Windows job (another program's, or one an earlier run of Zenith capped, even if that cap was cleared) is reported and left alone until it exits. Each operation pins those process instances and reports its result. Restore original returns the client's own priority, efficiency and core values and clears the cap (the client stays in the now-empty job), and affects the selected clients only while every observed value matches Zenith's last change. Exit attempts to restore all changes made in this session. Windows can refuse a change or restoration. A crash can leave an applied priority until the client exits or you change it in Task Manager; a CPU cap left by a crash lasts until that client exits, and Zenith names such clients when it next starts. Scheduling priority does not impose a CPU percentage, FPS or memory limit; a CPU cap imposes exactly that share and nothing else. Compare the same workload before deciding whether it helps." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_ClientSound}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="In Sessions, open Client sound. Check clients or select a row, then choose Mute or Unmute. Mute turns off that client's own sound in Windows, the same switch as its Volume mixer entry; Roblox's settings and files are not changed. Zenith turns the sound it muted on again on Unmute and on Exit. Unmute also turns on a client that started muted. If only part of a client's sound is muted, Mute leaves it as found; Unmute, then Mute, mutes all of it. To mute clients as they start, turn on Mute clients when they appear and save; clients already running are left alone. Windows can remember a mute for the next client of the same program, so a client that closes while muted, or a crash, can leave a later client muted; Unmute or Volume mixer turns it on." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_UploadLimit}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="In Sessions, open Upload limit. Enter whole kilobits per second, 100 to 10,000,000, and choose Apply upload limit. Windows shows its administrator prompt; after you approve it, Windows PowerShell creates Zenith's QoS policy for each Roblox client executable (RobloxPlayerBeta.exe, RobloxPlayer.exe and Roblox.exe) in Windows' active policy store at that rate, replacing an earlier one, and reads it back before reporting success. Remove deletes those policies the same way and confirms they are gone. The limit is one shared ceiling on what all matching clients send together; downloads are not limited, and nothing in the client is changed. The policy ends when Windows restarts; Zenith does not remove it on Exit, so it stays until you choose Remove or restart. Reading Windows' policy list needs administrator rights, so the section shows Zenith's own record of what it applied in this Windows session (upload-limit.json in the data folder), not a readback; a refused or mismatched result leaves that record uncertain. Cancel, Panic, Lock and timeout stop waiting, but an approved PowerShell may still run. New changes stay blocked until that earlier prompt proves nothing started or its process exits. Closing Zenith can lose that observation, so a saved unresolved owner blocks changes until Zenith can establish Windows restarted. Reopen Zenith promptly after restarting; an ambiguous restart keeps the hold, and needs record recovery review. An unreadable ownership record also blocks changes; review it before recovery. To see Windows' own list, run Get-NetQosPolicy -PolicyStore ActiveStore in an administrator PowerShell. Zenith has not measured any effect on game play or on other programs." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_ClientGpu}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="In Settings → Performance profile, turn on Show each client's GPU use and save. The Sessions table then shows each client's busiest GPU engine and dedicated GPU memory next to CPU and memory, read from Windows' per-process GPU counters by the same one-second sampler; nothing in Roblox is changed. A value is credited to a client only when its process ID carried the same start time just before and just after the reading, so a process ID that Windows reused is never credited; unknown or expired values stay Unavailable and are never shown as 0. The engine value is that client's own busiest engine, not a share of the adapter total shown under Overview → GPU measurements." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_KeepAwake}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Roblox disconnects a client that gets no input for 20 minutes. In Settings → Keep clients awake, choose a gap of 5 to 19 minutes and save. Every gap, when you have left the keyboard and mouse alone for 10 seconds, Zenith brings each client with a window forward, sends it one F13 press through its single input owner (the same owner macros use; a window a macro owns is left to that macro), and puts the window that was in front back. A client Windows will not bring forward gets no key, so a focus change never sends F13 to another program. It is off by default and is refused until the live input isolation trial marks background input Supported; until then the status under the choice says so and nothing is sent. Panic and Lock stop it for this run until you choose Resume keeping clients awake; saving the choice on after it was off also restarts it. The Diagnostics journal records how many clients each press reached, never which." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_NativeTrials}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="For a scheduled compatibility test, select a native Roblox installation in Settings, a saved account in Accounts, and an explicit game or server in Sessions → Join a game. Review selected-account trial shows the selected account, place or server, and installation. Confirming allows that one reviewed request to use the unverified provider. Choose Play in its private Roblox page. Publisher, selected-account identity, saved authorization, resource headroom and stop controls are checked again before native startup. The queue shows the requested destination separately from the process receipt; neither proves the client's account or actual arrival. Pause, Panic, Lock, installation changes and restart revoke unstarted trial permission; Stop trial and an installation change also pause the launch queue. Nothing resumes automatically. Review possible clients before confirming they are closed. Confirming closure releases only the forecast; any process Windows still observes remains counted. Extra client arguments you saved (a default in Settings → Roblox installation, or an account's own set in Edit account profile, which replaces the default for that account) are added after Roblox's own launch request when Zenith starts the native player itself; the review names the set it will pass. They are never passed through a bootstrapper and never written to logs, diagnostics or metadata exports." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="Use Launch evidence to inspect a pinned request. Requested player/place/server, the original process receipt, current process presence and separately timestamped log reports stay distinct. Reported match is still unverified; reported mismatch is a discrepancy to investigate. Teleport/disconnect and expired or ambiguous evidence never reuse last-known IDs as current. Show process selects the exact current process in Sessions; it sends no input. Copy/Save evidence exports only the displayed typed IDs and timing, not credentials, names, paths or raw logs. A startup stabilization countdown prevents rapid successive trials; fresh resources and explicit permission remain required after it ends. If the provider refused a start before any client started, the next one waits twice the Launch spacing; the wait doubles again for each such start in a row, up to about 1 minute, with up to 1 second of random variation so retries do not line up. Two in a row pause the queue with a notice, and the remaining requests stay queued. Resume continues, but until a client starts or 10 minutes pass, one more such start pauses it again. Closing or cancelling a request's private Roblox page counts as a refusal too. A start that timed out, expired or was stopped in Zenith Sessions, or whose account changed first, does not lengthen the wait; a start that timed out or was stopped during startup may still have left a client, so reconcile it before retrying. The longer wait and the count are kept only while Zenith runs; a restart always opens the queue paused. If Shorten the wait between starts when the previous client reports it joined is on in Settings → Performance profile (it is off by default), a startup stabilization wait ends as soon as the started client's own log reports it joined, but never before the Launch spacing has passed since its start and never later than the full stabilization. That report is diagnostic: it grants no permission, so fresh resources, provider eligibility and one start at a time are still required, and without a report the full wait stays." Style="{StaticResource Muted}" Margin="0,0,0,24" />
            <TextBlock Text="{local:Text GuideHeading_NativeLaunchMode}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Settings → Roblox installation → Native launch mode: Direct ticket is the default. It asks Roblox for an authentication ticket with the encrypted saved sign-in and starts the player without opening a game page. Zenith sends its own User-Agent with the Roblox protocol Origin and Referer headers. The ticket is used once and never saved. Every account, publisher, resource and stop check stays in place. Official page remains a diagnostic alternative: choose Play there to capture its request. Neither mode proves the account or arrival from a process receipt alone." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_BootstrapperLaunch}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Settings → Roblox installation lists Bloxstrap, Fishstrap, Froststrap or Voidstrap for inspection. Verify publisher shows the signer and certificate thumbprint; Accept publisher retains that inspection choice, and Forget accepted publisher removes it. Bootstrapper launching remains deferred until Zenith can associate the exact Roblox player with its bootstrapper. An accepted publisher does not enable trials or ordinary launching. Use the standard Roblox player for this build. A bootstrapper applies its own client settings and FFlags; Zenith never writes those files, and extra client arguments are never passed through a bootstrapper." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_OrdinaryLaunch}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Direct ticket launches saved accounts immediately and does not require a successful setup trial, even after a Roblox update. Each start still checks the executable publisher and held file, account, saved authorization, resource headroom, pacing, Panic and Lock. Launch evidence distinguishes Client started · unverified from the client log reporting the expected player and destination. Official page diagnostic mode retains its recorded-trial requirement. Forget verified trial removes that diagnostic record and pauses the queue; it does not disable Direct ticket. Old blocked requests stay blocked; cancel them and queue again." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_Receipts}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="A process-start receipt records the reported PID and creation time. It is not proof of the account, game arrival or current liveness. Client started · unverified remains reserved and reviewable; timeout or Panic cannot turn a late response into successful arrival. Use Review only after checking that no client or startup attempt remains. Restart never relaunches pending work: a request that had not started comes back as Not started · interrupted and can only be cancelled, and one that may have started comes back as Review required (see 8. Interrupted saves and recovery). Queue format 4 preserves these receipts; older versions of the companion must not overwrite this newer queue." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_ArrangeWindows}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="In Sessions, check clients or select one row. Minimize clients and Restore clients use that pinned selection without requiring a monitor choice; each state is confirmed separately. Restoring does not request foreground focus. Minimizing does not promise lower committed memory and minimized-window automation is unsupported. For tiling, choose Refresh monitors, select a monitor and check the clients to tile. With no checkboxes selected, Tile clients uses the selected row. Layout preferences set the gap, minimum outer-window size and optional column count in logical pixels; Windows scaling determines physical pixels. Each eligible normal, resizable window is checked again before moving. Restore minimized or maximized windows and leave fullscreen first. Arrangement does not request foreground focus. Cancel and Panic stop later requests but cannot undo a request already sent. The results list preserves per-client outcomes. Save all settings retains layout and your other preference edits; reopening the manager never automatically rearranges clients." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="Sessions → Content size uses physical content pixels, independently of the tiling preferences. Width starts at 640 and height at 480 on every manager launch. Tiny fills 320 × 240 only; choose Apply size to resize the checked clients, or the selected row when none are checked. Dimensions and recipients are pinned before work begins. Window frames add extra pixels, and each client uses its current monitor. Restore minimized or maximized clients and leave fullscreen first. Resizing does not request foreground activation, verify an account or prove automation compatibility. These temporary dimensions are never saved; Cancel, Lock and Panic stop later requests while retaining any reported partial outcomes." Style="{StaticResource Muted}" Margin="0,0,0,24" />
            <TextBlock Text="{local:Text GuideHeading_ResourceHistory}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Overview charts show measured machine CPU, available physical RAM and system commit. Sessions → History shows up to 120 samples over two minutes for the selected exact process instance. Select the client there or in Table. The chart axes use actual sample times and labelled shared memory/I/O scales. Missing, invalid, stale or reset measurements produce gaps, never invented zeroes. First process I/O readings warm up before a rate is available; changing PID/start identity cannot inherit an earlier instance's baseline. Read/write/other byte and operation rates combine files, network and devices, and do not measure disk-only activity, bandwidth or paging. Generic page faults combine soft and hard faults. History uses one shared reducer, no row-owned timers and no persisted running state. It is diagnostic information and does not verify an account, server or performance improvement. Returning to Table/History stops optional previews; history never starts capture or sends input." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_WindowsOverview}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Choose Windows to see the observed clients tiled evenly inside Zenith. Start previews opts into one shared low-rate capture owner; Stop, leaving the page, hiding Zenith, Panic, Lock or resource pressure stops it. Every observed tile remains visible, including clients with no usable window. Incomplete discovery is labelled and is not proof that an absent client closed. Large groups refresh in fair small batches: the rate is shared, not a promise of one frame per second per client. A dated last-known picture is labelled separately from a current image and expires after two minutes. Select a tile to inspect it; Focus client is a separate explicit action. Selecting or clicking an image never sends game input, chooses macro recipients or proves the signed-in account. Saved accounts remain separate. Sessions → Tile clients arranges real desktop windows; Windows shows them inside the manager." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_Previews}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Previews are off on every launch. In Sessions → Table, check up to four observed clients or select one row. Choose Previews, then Preview checked clients. The process start time and window are pinned; changing checkboxes never silently retargets capture. Outputs fit 320 × 180 without upscaling and update no faster than once per second. Windows may capture at a higher internal rate and still reads the source surface; no resource-saving claim is implied. The Windows capture border stays enabled. Minimized, hidden, changed or unavailable windows show an explicit status. Old images expire after three seconds, are kept only in bounded memory and are never saved or used for input, identity verification or image matching. Leaving this view, hiding/minimizing Zenith, Lock, Panic, or unhealthy/stale resource measurements clears and stops previews. Return and Start explicitly to resume. Several large windows can exceed the shared surface budget and be deferred. Unsupported Windows capture has no desktop fallback. Roblox preview compatibility and live overhead still need real-client verification." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_ReportedDestinations}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Selected client details separates current diagnostic player/place/server values from timestamped last-known information. A process using a log is not proof of who wrote it, and these parser formats remain unverified. Copy reported server link checks the latest available evidence at the click and refuses expired, ambiguous or disconnected destinations. Copying does not establish public access, choose an authorized account or confirm a join." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_RecentHistory}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Expand Recent clients in Sessions to see up to 100 process instances that a fresh, complete scan no longer observed. A partial, stale or failed scan does not establish absence. Each entry keeps the process start time and any last-reported, unverified player/game/server information. Zenith records a successful normal close request separately, and a Force close you confirmed as a forced end; otherwise the actual cause of disappearance is named only from the evidence Zenith found (a crash record, a hang, a logged disconnect) or stays unknown. No historical row launches, rejoins, authorizes an account or restores running state. Clear recent history asks for confirmation and affects only ended records; active tracking continues. History uses a separate bounded client-history.db in your data folder. Save errors stay visible and require Retry history storage; damaged storage is preserved rather than replaced with an empty database. Use Open settings folder to locate and preserve that file before recovery." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_Linking}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="On Accounts, create or select a saved profile, then choose Sign in with Roblox. Complete sign-in and security challenges on Roblox’s real page in the private window. Choose Save this Roblox sign-in only when the intended account is signed in. Zenith verifies the returned user ID before storing the reusable session with Windows protection. Check saved sign-in revalidates that same account; Remove saved sign-in deletes Zenith’s local authorization without deleting the profile or closing running games. Native account launch remains a separate capability. Existing older authorization records are preserved; reconnecting through this saved-sign-in flow requires explicitly removing an incompatible old link first." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_LinkRecovery}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="An expired or unreadable saved sign-in preserves the profile. Check saved sign-in contacts Roblox only for the selected protected account. Check checked sign-ins checks the checked accounts on the current page one at a time, only when you choose it, and stops as soon as Roblox cannot be reached or a check times out; accounts it did not reach are left unchanged. If Roblox cannot be reached at all, or turns a check away as busy without replacing the session, that saved sign-in is left unchanged. A check that times out or fails after reaching Roblox requires fresh sign-in because Roblox may have replaced its session during the request. Cancel, Lock, Panic and Exit cancel the current attempt; the private page hides immediately while its owner finishes cleanup. Preserve unreadable protected files for recovery. Remove saved sign-in deletes only Zenith’s local authorization; it does not perform a global Roblox logout." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_Installations}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
            <TextBlock Text="In Settings, Refresh installation reads bounded current-user registrations, standard locations and version metadata. It runs when requested, or on the saved automatic-update schedule while no installation is selected. With an installation selected, automatic checks refresh only the public release comparison. Panic stops the schedule until explicitly resumed. Conflicting registrations and multiple versions remain visible. When the hints single out one present native Roblox player, Refresh preselects it and marks it Suggested, skipping Microsoft Store builds, the launcher and bootstrapper-managed players; with several present players only the one the Roblox registration names is suggested, and disagreeing registrations suggest nothing. The preselection passes the same publisher check before any start, and you can select another row. Select a candidate to see its local path. Found files are unverified: installation discovery does not prove publisher trust, compatibility, account sign-in or native arrival. Cancel, Lock and Panic discard the current check; refresh explicitly after unlocking. No program, protocol registration or client file is changed. Portable or unregistered installations may be missed." Style="{StaticResource Muted}" Margin="0,0,0,24" />
            <TextBlock Text="Roblox updates are off until you tick Check for Roblox updates automatically in Settings and save: Zenith then asks Roblox's public version service for its current release 3 seconds after start and every 30 minutes (with no row selected it refreshes the installation list; with a row selected it only re-reads the release) and tells you once when the installed player is behind. Download Roblox update fetches Roblox's own installer for that release from setup.rbxcdn.com into a temporary folder and has Windows verify its signature from Roblox Corporation; the result shows the publisher and SHA-256, and nothing is run. Install Roblox update asks first, saying how many Roblox clients are running (the installer closes every one), then runs the verified file and waits up to 10 minutes; afterwards the installation list is refreshed. Cancel stops a download or stops waiting; Panic and Lock do the same and delete a downloaded installer that was not run. Zenith never closes the installer and never changes Roblox's settings or files itself." Style="{StaticResource Muted}" Margin="0,0,0,24" />
            <TextBlock Text="{local:Text GuideHeading_PerformanceProfiles}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
            <TextBlock Text="Choose a profile in Settings and save. Maximum Efficiency samples process details less often and spaces eligible starts further apart. Balanced keeps the normal cadence. High Performance refreshes manager observations more often, with additional monitoring overhead. Main Account Priority gives your explicitly selected saved profile a bounded launch-order boost while waiting-age fairness and admission stay active. Use as main account in the library chooses the profile; it does not verify a running client. Custom changes the displayed timing values within their ranges. Invalid custom timing remains pending; Reset custom timing restores valid defaults. Essential RAM, commit and CPU samples remain once per second and expire after three seconds. An active start keeps its original stabilization/spacing. Share manager performance settings exports only the profile and four custom timing values. Copy code or Save to file uses the current valid performance draft. Review code or Review file shows the profile, effective policy and dormant custom values; Use in draft changes only those fields while keeping your current main account. Save settings is still required. Share codes are readable and unauthenticated; imported values still have to pass validation. No account, authorization, safety headroom, hotkey, layout or client flag is transferred. No profile promises game FPS or client-capacity gains; unsupported graphics, FPS, client CPU/render, previews and macro policies remain pending." Style="{StaticResource Muted}" Margin="0,0,0,24" />
            <TextBlock Text="{Binding PanicShortcutStatus}" Style="{StaticResource Muted}" Margin="0,10,0,14" />
            <TextBlock Text="{Binding DiagnosticsStatus}" Style="{StaticResource Muted}" Margin="0,0,0,20" />
            <TextBlock Text="{local:Text GuideHeading_Shortcuts}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
            <TextBlock Text="These keys work while this manager is focused, and the numbers follow the sidebar order. They belong to this window only: none registers a global shortcut or replaces a Zenith transport binding. Choose the global Panic shortcut in Settings." Style="{StaticResource Muted}" Margin="0,0,0,8" />
            <!-- The same table MainWindow builds its key bindings from, so this list always matches the keys that work. -->
            <ItemsControl x:Name="GuideShortcutList" ItemsSource="{x:Static local:ShellShortcuts.All}" Focusable="False" AutomationProperties.Name="{local:Text GuideHeading_Shortcuts}" Margin="0,0,0,24">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="88" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Gesture}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource Muted}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{local:Text GuideHeading_Diagnostics}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
            <TextBlock Text="Diagnostics shows the newest 512 manager events and session totals. Each failure names the subsystem that failed, such as Launch queue or Credential vault, in the view, Copy visible and the report. Pause view freezes display only. Clear view hides current entries without deleting logs. Severity and text filters apply to Copy visible and the redacted report. Save report writes a JSON file outside application/data folders. Reports include the Windows version, the theme and the active performance and capacity numbers. They omit account metadata, paths, URLs, sign-in and window-layout settings, credentials and raw exception messages; nothing is uploaded. Include Roblox client log entries, off until you tick it before Save report, adds for up to 8 Roblox Player logs written in the last day the time, kind, place and server IDs and disconnect code of the log lines Zenith recognises (joins, connections, teleports, disconnects, identity and human checks), never the lines themselves, player IDs, chat, URLs or paths; the tick clears after each report it was included in, Copy diagnostics never includes them, and the sample profile cannot turn it on. The live view covers this launch only; Open logs shows the retained rotating files. Roblox client logs, at the bottom of Diagnostics, cleans up Roblox's own Player logs in two steps: Check old logs counts the Player logs older than the days you choose and shows their total size, and Delete these logs asks first and then removes exactly those files, each checked again just before it goes. Logs newer than that, logs a running client still holds and logs Zenith is watching for session evidence are always kept; Studio logs are left alone, and nothing is deleted on its own." Style="{StaticResource Muted}" Margin="0,0,0,24" />
            <TextBlock Text="{local:Text GuideHeading_Avatars}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
            <TextBlock Text="Use Choose server in Account details to open Join a game. Use the account's … menu to refresh its public avatar or use its preferred game. In Sessions, Review reported server fills the destination field when a current client reports a server. Choose Search / Use to review that request. Headshots load for verified player IDs while the Accounts page is visible, using one shared bounded loader. Use Refresh public avatar to retry. Sample profiles do not contact Roblox. Public names and pictures do not prove a current sign-in or identify a local process. In Sessions → Join a game, enter a public name, place ID or supported game/server link and choose Search / Use. A successful explicit choice loads details; Load game details can refresh them to see its public name, creator, experience-wide players and requested/root place IDs; loading details never replaces your requested place. The icon is optional and validated before display. The experience gallery preserves public media order; use Previous and Next to browse. Pending, unavailable and unsupported video items have explicit states. These pictures are experience artwork, not live client frames. Browse public servers 25 at a time: Load next 25 adds the next page to the loaded rows, a server seen again shows only its newest observation, and the list keeps the newest 100. Each row shows a fill bar and the server's reported FPS when Roblox gives one. Select one, and press Use selected server before Queue checked accounts. Or press Find a server with room: it asks Roblox once for up to 100 public servers that are not full, most full first, and uses the fullest one with room for the checked accounts (or the selected account) plus a spare seat, or else exactly enough room, just as if you had used it yourself. It leaves the list alone. To spread a batch instead, turn on Give each account its own listed server before queuing: with no server pinned, each account gets a different loaded server with room for it and a spare seat, in random order, and accounts left over join the game without a chosen server. It is off by default, and a pinned server still goes to everyone. Capacity advice compares that observation with the checked recipients, or the selected account when none are checked. It expires after five minutes; reported slots are not reserved seats. Recipients and destination are frozen before queuing; unavailable providers produce blocked requests. Private/share codes are discarded and never guessed into a public destination. A queued request is not confirmed arrival." Style="{StaticResource Muted}" Margin="0,0,0,24" />
            <TextBlock Text="{local:Text GuideHeading_Capabilities}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Automation lists supported, unavailable, and unverified functionality. Native diagnostic successes are not Roblox compatibility. Panic stop is always available and leaves clients open. Its global shortcut is F12 unless you choose another in Settings → Panic shortcut and save. Lock hides account controls while monitoring continues. To lock automatically after a time without keyboard or mouse input, choose it in Settings → Lock when idle and save. Closing the main window keeps the manager in the tray; click the tray icon to reopen it, and use the tray menu's Exit command to shut it down. To make the close button exit instead, turn on Close button exits the manager in Settings and save. Scheduled shutdown in Settings asks Windows' own shutdown tool to turn this PC off after a chosen time, with a countdown and Cancel shutdown there and in the footer; nothing is scheduled unless you ask, Panic and Exit cancel it, and Lock leaves it in place. Hold launches on a public network in Settings, off by default, holds new launches and locks the dashboard while Windows files the active connection as Public; held requests start again once the network is private, and the footer says while they are held. Send Discord alerts in Settings, off by default, posts a short message to one saved Discord webhook when a client crashes, stops responding or is disconnected, and when a launch batch has finished; the webhook URL is kept protected and never shown, Panic stops the alerts until Resume alerts, and Lock leaves them running. Show Zenith in your Discord status in Settings, off by default, tells the Discord app on this PC how many Roblox clients are running (and, if you also choose it, which game) so your Discord status shows it; it needs the Application ID of a Discord application you create, is cleared on Lock, Panic and exit, and is shown again after Unlock or Resume Discord status." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_SavedMacros}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Open the matching Personal Zenith build, then choose Automation → Saved macros → Refresh host macros. The list shows successfully saved or loaded macros and their assigned shortcuts, rather than pending edits. Previous and Next browse one page at a time. If Zenith changes its library while you browse, refresh from the beginning. Connection failures keep the last received page clearly marked as stale. This connection does not copy macro contents, start the editor automatically or run playback. Shared playback and broadcasting remain unavailable until their integrations and real-client tests pass. Sample mode does not connect to your real macro library." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_Assignments}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="In Automation, refresh saved macros and assignments. Select a saved macro, then choose Selected account, Current saved group or Selected bundle to pin the target shown in the assignment panel. Assign checks that target's stable ID and rechecks the received host page before saving one macro reference. Later selection changes never redirect a pending request. A group or bundle's members will be resolved and frozen at a future explicit run start. Last-observed names are hints: a removed group or off-page macro is never replaced by another with the same name. Remove assignment deletes only that reference, after checking the confirmation box. Conflicting changes require Refresh; cancelled requests may already have committed metadata, so refresh to inspect them. Assignments survive restarts but never resume playback. Macro execution and live account/provider verification remain unfinished." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="{local:Text GuideHeading_Recovery}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="After any restart the queue opens paused and nothing starts on its own. A request that was still waiting to start comes back as Not started · interrupted: it never started a client, reserves no resources and can only be cancelled. Queue it again if you still need it. A request that was preparing its account comes back as Review preparation; that phase starts no client, so cancel it and create a fresh request. A request that may have reached native startup comes back as Review required and stays counted as a possible client until you review it. A Client started · unverified row keeps its process receipt and stays reviewable. When the queue loads from its backup, requests that were waiting to start also show Review required, because the lost main file may already have started them." Style="{StaticResource Muted}" Margin="0,10,0,24" />
            <TextBlock Text="A missing or damaged main queue can load its verified backup for review. Recovered requests remain paused; no client or macro restarts automatically. The startup notice and Log identify backup recovery. Saved settings can also load a verified backup without immediately replacing your original files. If recovery is blocked, the launch queue footer names the file involved. Keep the .bak, .tmp and .damaged files and use More options › Open data folder to review them. Do not delete them to dismiss a warning. When a closed or interrupted app left launch-queue.json.tmp next to a readable queue, choose Set aside interrupted save in the footer: it renames that file to launch-queue.json.interrupted-(time), keeps it, and reopens the last completed queue paused. If the queue was already running, setting the save aside keeps it stopped until you restart Zenith Sessions. Other blocked states still need your review. Unsupported newer files need a compatible app version. Account profiles remain usable when the separate launch queue is unavailable." Style="{StaticResource Muted}" Margin="0,0,0,24" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <!-- One footer: launch-queue state + notices. Expanding opens the queue above it. -->
      <Expander Grid.Row="2" Grid.ColumnSpan="2" IsExpanded="{Binding QueueExpanded}" AutomationProperties.Name="Launch queue">
        <Expander.Template>
          <ControlTemplate TargetType="Expander">
            <Border Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,1,0,0">
              <DockPanel>
                <Grid DockPanel.Dock="Bottom" MinHeight="34">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Cursor="Hand" FocusVisualStyle="{StaticResource KeyboardFocusRing}" ToolTip="Show or hide the launch queue" AutomationProperties.Name="Show launch queue">
                    <ToggleButton.Template>
                      <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Hit" Background="Transparent" Padding="14,0,6,0">
                          <Path x:Name="Chevron" Width="12" Height="12" Stretch="Uniform" Data="M 3,10 L 8,5 L 13,10" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Data" Value="M 3,6 L 8,11 L 13,6" /></Trigger>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hit" Property="Background" Value="{DynamicResource HoverBackground}" /></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </ToggleButton.Template>
                  </ToggleButton>
                  <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" />
                </Grid>
                <ContentPresenter x:Name="ExpandedContent" Visibility="Collapsed" ContentSource="Content" />
              </DockPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Expander.Template>
        <Expander.Header>
          <DockPanel LastChildFill="True" MinHeight="32" Margin="4,0,0,0">
            <Button DockPanel.Dock="Right" Content="{Binding QueuePauseLabel}" Command="{Binding ToggleQueuePause}" IsEnabled="{Binding QueueReady}" MinHeight="26" Padding="10,0" Margin="12,2,8,2" />
            <Button DockPanel.Dock="Right" Content="Set aside interrupted save" Click="SetAsideInterruptedQueueWrite" Visibility="{Binding CanSetAsideInterruptedQueueWrite, Converter={StaticResource VisibleIf}}" MinHeight="26" Padding="10,0" Margin="12,2,0,2" ToolTip="Renames launch-queue.json.tmp to a kept launch-queue.json.interrupted file. Nothing is deleted. The queue reopens paused; if it was already running, it reopens after you restart Zenith Sessions." AutomationProperties.Name="Set aside interrupted queue save" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding SaveStatus}" Style="{StaticResource CaptionLine}" VerticalAlignment="Center" Margin="16,0,0,0" />
            <TextBlock DockPanel.Dock="Left" Text="Launch queue" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ContentControl DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0">
              <ContentControl.Style>
                <Style TargetType="ContentControl" BasedOn="{StaticResource ChipSuccess}">
                  <Setter Property="Content" Value="Active" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding QueuePauseLabel}" Value="Resume queue"><Setter Property="Content" Value="Paused" /><Setter Property="Background" Value="{DynamicResource BadgeBgWarning}" /><Setter Property="BorderBrush" Value="{DynamicResource BadgeBgWarning}" /><Setter Property="Foreground" Value="{DynamicResource AccentWarning}" /></DataTrigger>
                    <DataTrigger Binding="{Binding QueueReady}" Value="False"><Setter Property="Content" Value="Opening" /><Setter Property="Background" Value="{DynamicResource SurfaceBackground}" /><Setter Property="BorderBrush" Value="{DynamicResource SurfaceBackground}" /><Setter Property="Foreground" Value="{DynamicResource TextSecondary}" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </ContentControl.Style>
            </ContentControl>
            <TextBlock DockPanel.Dock="Left" Text="{Binding QueueStatus}" ToolTip="{Binding QueueStatus}" Style="{StaticResource CaptionLine}" MaxWidth="420" VerticalAlignment="Center" Margin="0,0,16,0" />
            <!-- A failure stays beside the status line until dismissed. Screen readers hear the error assertively and the status politely. -->
            <DockPanel x:Name="FooterNotices" LastChildFill="True" VerticalAlignment="Center">
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Visibility="{Binding HasErrorNotice, Converter={StaticResource VisibleIf}}" Margin="0,0,16,0">
                <Path Style="{StaticResource Glyph}" Width="14" Height="14" Stroke="{DynamicResource AccentDanger}" Data="M1.5,8 A6.5,6.5 0 1 1 14.5,8 A6.5,6.5 0 1 1 1.5,8 Z M8,4.6 V8.6 M8,11.1 V11.4" Margin="0,0,6,0" />
                <TextBlock Text="{Binding ErrorNotice, NotifyOnTargetUpdated=True}" Binding.TargetUpdated="AnnounceNotice" ToolTip="{Binding ErrorNotice}" AutomationProperties.Name="{Binding ErrorNotice, StringFormat='Error: {0}'}" AutomationProperties.LiveSetting="Assertive" Style="{StaticResource CaptionLine}" Foreground="{DynamicResource AccentDanger}" MaxWidth="440" VerticalAlignment="Center" />
                <Button Content="Dismiss" Command="{Binding DismissError}" ToolTip="Dismiss this error" AutomationProperties.Name="Dismiss error" Style="{StaticResource QuietButton}" MinHeight="26" Padding="10,0" Margin="8,2,0,2" />
              </StackPanel>
              <!-- A scheduled PC shutdown shows its countdown and Cancel on every page, only while one is scheduled. -->
              <StackPanel x:Name="FooterShutdownCountdown" DockPanel.Dock="Left" Orientation="Horizontal" Visibility="{Binding IsShutdownScheduled, Converter={StaticResource VisibleIf}}" Margin="0,0,16,0">
                <TextBlock Text="{Binding ShutdownCountdown}" ToolTip="{Binding ShutdownStatus}" AutomationProperties.Name="{Binding ShutdownCountdown}" Style="{StaticResource CaptionLine}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                <Button Content="Cancel shutdown" Command="{Binding CancelShutdown}" IsEnabled="{Binding CanCancelShutdown}" ToolTip="Ask Windows to call off the scheduled shutdown" AutomationProperties.Name="Cancel the scheduled shutdown" Style="{StaticResource QuietButton}" MinHeight="26" Padding="10,0" Margin="8,2,0,2" />
              </StackPanel>
              <!-- The public-network guard says on every page that launches are held, only while they are. -->
              <TextBlock x:Name="FooterPublicNetwork" DockPanel.Dock="Left" Text="Public network: launches held" ToolTip="{Binding PublicNetworkStatus}" AutomationProperties.Name="Public network: launches held" Visibility="{Binding IsPublicNetworkHeld, Converter={StaticResource VisibleIf}}" Style="{StaticResource CaptionLine}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,16,0" />
              <TextBlock Text="{Binding Notice, NotifyOnTargetUpdated=True}" Binding.TargetUpdated="AnnounceNotice" ToolTip="{Binding Notice}" AutomationProperties.LiveSetting="Polite" Style="{StaticResource CaptionLine}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
            </DockPanel>
          </DockPanel>
        </Expander.Header>
        <Grid Height="220" Margin="16,10,16,6">
          <ListView ItemsSource="{Binding Launches}" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderBrushLight}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Launch requests">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="Account / process" Width="225"><GridViewColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Style="{StaticResource SessionsListText}" Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" /><TextBlock Text="{Binding ProcessReceipt}" ToolTip="{Binding ProcessReceipt}" TextTrimming="CharacterEllipsis" FontSize="11" Style="{StaticResource SessionsListCaption}" Margin="0,3,0,0" /><TextBlock Text="{Binding ResourceEstimate}" ToolTip="{Binding ResourceEstimate}" TextTrimming="CharacterEllipsis" FontSize="11" Style="{StaticResource SessionsListCaption}" Margin="0,3,0,0" /></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                <GridViewColumn Header="State" Width="145"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource SessionsListText}" Text="{Binding State}" TextWrapping="Wrap" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                <GridViewColumn Header="Destination" Width="230"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Style="{StaticResource SessionsListText}" Text="{Binding RequestedDestination}" ToolTip="{Binding RequestedDestination}" TextTrimming="CharacterEllipsis" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                <GridViewColumn Header="Details" Width="290"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Detail}" ToolTip="{Binding Detail}" TextTrimming="CharacterEllipsis" Style="{StaticResource SessionsListCaption}" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                <GridViewColumn Header="" Width="160">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <Button Content="Cancel" Command="{Binding DataContext.CancelLaunch, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" IsEnabled="{Binding CanCancel}" Style="{StaticResource QuietButton}" Padding="10,0" />
                        <Button Content="Review" Click="ReviewLaunch" IsEnabled="{Binding CanReview}" Padding="10,0" Margin="6,0,0,0" />
                      </StackPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
          <TextBlock Text="No launch requests yet. Queue an account's preferred game, or pick a game in Join a game." HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="560" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding Launches.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Expander>
      <Border Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{DynamicResource AppBackground}" Visibility="{Binding IsLocked, Converter={StaticResource VisibleIf}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
          <theme:ThemeAwareLogo Width="48" Height="48" HorizontalAlignment="Left" />
          <TextBlock Text="Controls are locked" Style="{StaticResource PageTitle}" Margin="0,20,0,10" />
          <TextBlock Text="Account details are hidden. Monitoring continues; automation requires an explicit restart after unlocking." Style="{StaticResource Muted}" />
          <Button Content="Unlock dashboard" Command="{Binding Unlock}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,22,0,0" />
          <TextBlock Text="{Binding VaultPasswordStatusText}" Style="{StaticResource Muted}" Margin="0,12,0,0" />
          <Button Content="Forgot password: forget saved sign-ins…" Click="ForgetProtectedSignIns" IsEnabled="{Binding CanForgetProtectedSignIns}" HorizontalAlignment="Left" Margin="0,10,0,0" />
          <Expander Header="Close a running client safely" Margin="0,20,0,0">
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate><DockPanel Margin="0,6"><Button Content="Close client" DockPanel.Dock="Right" Click="CloseSession" Margin="8,0,0,0" /><TextBlock Text="{Binding ProcessLabel}" VerticalAlignment="Center" /></DockPanel></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Expander>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
