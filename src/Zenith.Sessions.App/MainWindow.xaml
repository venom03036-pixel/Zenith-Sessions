                    <StackPanel DataContext="{Binding GameDetails}">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Width="44" Height="44" VerticalAlignment="Top" Margin="0,0,12,0"><Grid.Clip><RectangleGeometry Rect="0,0,44,44" RadiusX="8" RadiusY="8" /></Grid.Clip><Border Background="{DynamicResource SurfaceBackground}" /><Path Style="{StaticResource Glyph}" Stroke="{DynamicResource TextMuted}" Data="M3,5 L13,5 Q15,5 15,8 L15,9 Q15,12 12,12 L4,12 Q1,12 1,9 L1,8 Q1,5 3,5 Z M4.5,8.5 L7,8.5 M5.8,7.2 L5.8,9.8" /><Image Source="{Binding Icon}" Width="44" Height="44" Stretch="UniformToFill" Visibility="{Binding HasIcon, Converter={StaticResource VisibleIf}}" AutomationProperties.Name="Public experience icon" /></Grid>
                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Creator}" Style="{StaticResource Caption}" Margin="0,2,0,0" /></StackPanel>
                      </Grid>
                      <TextBlock Text="{Binding Activity}" Margin="0,12,0,0" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Identifiers}" Style="{StaticResource MonoText}" TextWrapping="Wrap" Margin="0,6,0,0" />
                      <TextBlock Text="{Binding Observed}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                      <WrapPanel Margin="0,10,0,0"><Button Content="Load game details" Command="{Binding Load}" IsEnabled="{Binding CanLoad}" Style="{StaticResource QuietButton}" Margin="0,0,4,4" /><Button Content="Cancel details" Command="{Binding Cancel}" IsEnabled="{Binding IsBusy}" Style="{StaticResource QuietButton}" Margin="0,0,4,4" /></WrapPanel>
                      <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" ToolTip="Experience-wide counts are separate from server occupancy. Loading details never replaces a requested subplace or proves access or arrival." />
                    </StackPanel>
                    <Border Style="{StaticResource Divider}" />
                    <StackPanel DataContext="{Binding ServerBrowser}">
                      <Button Content="Quick join · any server" Command="{Binding DataContext.QueueTargetedAccounts, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CanUseDestination}" Style="{StaticResource PrimaryButton}" MinHeight="36" ToolTip="Queue the checked accounts (or the selected account) for this game. Roblox picks the server." />
                      <Button Content="Browse servers" Command="{Binding DataContext.ShowJoinStep, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="2" MinHeight="36" Margin="0,8,0,0" />
                      <WrapPanel Margin="0,8,0,0">
                        <Button Content="Open on Roblox.com" Click="OpenGamePageClick" IsEnabled="{Binding CanUseDestination}" Style="{StaticResource QuietButton}" MinHeight="36" Margin="0,0,4,0" ToolTip="Open this game's public Roblox page in your browser. Nothing is launched or signed in." />
                        <Button Content="Copy link" Click="CopyGamePageLinkClick" IsEnabled="{Binding CanUseDestination}" Style="{StaticResource QuietButton}" MinHeight="36" ToolTip="Copy the public game page link. IDs only; never a server, share or private code." />
                      </WrapPanel>
                      <TextBlock Text="Opens the Roblox client for each account. Zenith shows launch progress; arrival is checked, not reserved." Style="{StaticResource Caption}" Margin="0,10,0,0" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>

            <!-- ===== Step 2 · Browse servers (public list or a private server link) ===== -->
            <Grid Visibility="{Binding IsJoinServerStep, Converter={StaticResource VisibleIf}}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>
              <StackPanel DataContext="{Binding ServerBrowser}">
                <Border Style="{StaticResource SegmentBar}" Margin="0,0,0,14">
                  <StackPanel Orientation="Horizontal">
                    <Button Content="Public servers" Command="{Binding DataContext.ShowServerTab, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Public" Tag="{Binding DataContext.IsPublicServerTab, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SegmentButton}" />
                    <Button Content="Private server" Command="{Binding DataContext.ShowServerTab, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Private" Tag="{Binding DataContext.IsPrivateServerTab, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource SegmentButton}" Margin="2,0,0,0" />
                  </StackPanel>
                </Border>
                <StackPanel Visibility="{Binding DataContext.IsPublicServerTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleIf}}">
                  <WrapPanel Margin="0,0,0,6"><ComboBox ItemsSource="{Binding ServerOrderChoices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedServerOrder}" MinWidth="230" MinHeight="32" Margin="0,0,14,8" AutomationProperties.Name="Public server order" ToolTip="Server order" /><CheckBox Content="Hide full servers" IsChecked="{Binding HideFull}" VerticalAlignment="Center" Margin="0,0,14,8" /><Button Content="Browse public servers" Command="{Binding Browse}" IsEnabled="{Binding CanUseDestination}" Margin="0,0,4,8" /><Button Content="Next page" Command="{Binding Next}" IsEnabled="{Binding CanNext}" Style="{StaticResource QuietButton}" Margin="0,0,4,8" /><Button Content="Cancel browsing" Command="{Binding Cancel}" IsEnabled="{Binding IsBusy}" Style="{StaticResource QuietButton}" Margin="0,0,4,8" /></WrapPanel>
                  <TextBlock Text="{Binding OrderingExplanation}" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                  <ListView ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" Height="260" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrushLight}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Public servers"><ListView.View><GridView><GridViewColumn Header="Server" Width="300" DisplayMemberBinding="{Binding JobId}" /><GridViewColumn Header="Players" Width="90" DisplayMemberBinding="{Binding Occupancy}" /><GridViewColumn Header="Room" Width="160" DisplayMemberBinding="{Binding Availability}" /><GridViewColumn Header="Ping" Width="90" DisplayMemberBinding="{Binding Ping}" /><GridViewColumn Header="Checked" Width="90" DisplayMemberBinding="{Binding Observed}" /></GridView></ListView.View></ListView>
                  <TextBlock Text="{Binding PageSummary}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                  <WrapPanel Margin="0,10,0,0"><Button Content="Use selected server" Command="{Binding UseServer}" IsEnabled="{Binding CanUseServer}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" /><Button Content="Copy requested link" Click="CopyRequestedServerLink" IsEnabled="{Binding CanUseDestination}" Style="{StaticResource QuietButton}" Margin="0,0,8,8" /></WrapPanel>
                  <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" />
                </StackPanel>
                <!-- Private server tab: one explicit check with the selected account's saved session. Codes are never shown in full. -->
                <Border Style="{StaticResource SurfaceCard}" DataContext="{Binding DataContext.ShareLink, RelativeSource={RelativeSource AncestorType=Window}}" Visibility="{Binding DataContext.IsPrivateServerTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleIf}}">
                  <StackPanel>
                    <TextBlock Text="Join a private server" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="Paste the private server or game share link the owner shared with you. Zenith checks it with the selected account before anything launches." Style="{StaticResource Muted}" Margin="0,6,0,14" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <TextBox x:Name="ShareLinkInput" Text="{Binding LinkInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="4096" MinHeight="36" VerticalContentAlignment="Center" AutomationProperties.Name="Private server or share link" ToolTip="Paste a roblox.com/share link. Its code is checked with the selected account and never shown again." />
                      <Button Grid.Column="1" Content="Check link" Command="{Binding Check}" IsEnabled="{Binding CanCheck}" Style="{StaticResource PrimaryButton}" MinHeight="36" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="6" Padding="12,10" Margin="0,12,0,0" Visibility="{Binding HasResult, Converter={StaticResource VisibleIf}}">
                      <StackPanel>
                        <TextBlock Text="{Binding ResultTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ResultDetail}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <StackPanel Visibility="{Binding HasPrivateResult, Converter={StaticResource VisibleIf}}" Margin="0,10,0,0">
                          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SaveName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" MinHeight="32" AutomationProperties.Name="Private server favorite name" ToolTip="A name for this private server. Never enter the link or its code." />
                            <Button Grid.Column="1" Content="Save as favorite" Command="{Binding SaveAsFavorite}" IsEnabled="{Binding CanSave}" Margin="8,0,0,0" />
                          </Grid>
                          <WrapPanel Margin="0,8,0,0">
                            <Button Content="Join private server" IsEnabled="{Binding CanJoinPrivate}" Style="{StaticResource PrimaryButton}" MinHeight="36" Margin="0,0,8,0" ToolTip="{Binding JoinNote}" />
                            <TextBlock Text="{Binding JoinNote}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                          </WrapPanel>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <TextBlock Text="Saved private servers" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                    <ListView ItemsSource="{Binding Saved}" SelectedItem="{Binding SelectedSaved}" MaxHeight="150" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Saved private servers"><ListView.View><GridView><GridViewColumn Header="Name" Width="200" DisplayMemberBinding="{Binding Name}" /><GridViewColumn Header="Place" Width="130" DisplayMemberBinding="{Binding PlaceId}" /><GridViewColumn Header="Code" Width="90" DisplayMemberBinding="{Binding Last4, StringFormat='…{0}'}" /></GridView></ListView.View></ListView>
                    <WrapPanel Margin="0,8,0,0"><Button Content="Remove selected" Click="DeletePrivateServer" IsEnabled="{Binding CanRemoveSaved}" Style="{StaticResource DangerQuietButton}" Margin="0,0,6,0" /><Button Content="Refresh list" Command="{Binding RefreshSaved}" Style="{StaticResource QuietButton}" /></WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Path Style="{StaticResource Glyph}" Stroke="{DynamicResource TextMuted}" Width="13" Height="13" Margin="0,0,8,0" Data="M3,7 L13,7 L13,14 L3,14 Z M5.2,7 L5.2,5 A2.8,2.8 0 0 1 10.8,5 L10.8,7" /><TextBlock Text="Anyone with this link can join, so treat it like a password." Style="{StaticResource Caption}" /></StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
              <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" VerticalAlignment="Top">
                <StackPanel DataContext="{Binding ServerBrowser}">
                  <TextBlock Text="Pinned for this batch" Style="{StaticResource SectionHeading}" />
                  <TextBlock Text="One destination for every account in the batch" Style="{StaticResource Caption}" Margin="0,2,0,14" />
                  <TextBlock Text="{Binding DestinationSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding DataContext.RequestedCapacitySummary, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" Foreground="{DynamicResource AccentPrimary}" Margin="0,10,0,0" />
                  <Border Style="{StaticResource Divider}" />
                  <TextBlock Text="Free slots can’t be reserved and may change before launch." Style="{StaticResource Caption}" Margin="0,0,0,14" ToolTip="Server lists do not reserve seats or confirm arrival. Each request still requires the intended account, a compatible native provider and available resources." />
                  <Button Content="Review launch  →" Command="{Binding DataContext.ShowJoinStep, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="3" IsEnabled="{Binding CanUseDestination}" Style="{StaticResource PrimaryButton}" MinHeight="36" />
                  <Button Content="Change game" Command="{Binding DataContext.ShowJoinStep, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="1" Style="{StaticResource QuietButton}" MinHeight="36" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- ===== Step 3 · Ready when you are ===== -->
            <StackPanel Visibility="{Binding IsJoinReadyStep, Converter={StaticResource VisibleIf}}">
              <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource SurfaceCard}"><StackPanel DataContext="{Binding RecipientBundles}">
                  <TextBlock Text="Who is launching" Style="{StaticResource SectionHeading}" />
                  <TextBlock Text="Accounts checked in Accounts, or a saved bundle" Style="{StaticResource Caption}" Margin="0,2,0,12" />
                  <ComboBox ItemsSource="{Binding Bundles}" SelectedItem="{Binding SelectedBundle}" DisplayMemberPath="Name" IsEnabled="{Binding CanManage}" MinHeight="32" AutomationProperties.Name="Saved account bundle" ToolTip="Saved account bundle" />
                  <TextBlock Text="{Binding SelectedSummary}" Style="{StaticResource Caption}" Margin="0,6,0,10" />
                  <ListView ItemsSource="{Binding Members}" MaxHeight="210" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Reviewed bundle members"><ListView.View><GridView><GridViewColumn Header="Account" Width="130" DisplayMemberBinding="{Binding Label}" /><GridViewColumn Header="Player" Width="110" DisplayMemberBinding="{Binding Identity}" /><GridViewColumn Header="Sign-in" Width="160" DisplayMemberBinding="{Binding SignInState}" /></GridView></ListView.View></ListView>
                  <WrapPanel Margin="0,10,0,0"><Button Content="Review members" Command="{Binding Review}" IsEnabled="{Binding CanUseSelected}" Margin="0,0,6,6" /><Button Content="Remove missing references" Command="{Binding RemoveMissing}" IsEnabled="{Binding CanUseSelected}" Style="{StaticResource QuietButton}" Margin="0,0,6,6" /></WrapPanel>
                  <Expander Header="Edit bundles" Margin="0,6,0,0">
                    <StackPanel Margin="0,8,0,0">
                      <TextBox Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" IsEnabled="{Binding CanManage}" MinHeight="32" AutomationProperties.Name="Account bundle name" ToolTip="Bundle name" />
                      <WrapPanel Margin="0,8,0,0"><Button Content="Save checked page as new" Command="{Binding SaveChecked}" IsEnabled="{Binding CanManage}" Margin="0,0,6,6" /><Button Content="Add checked to bundle" Command="{Binding AddChecked}" IsEnabled="{Binding CanUseSelected}" Margin="0,0,6,6" /><Button Content="Rename" Command="{Binding Rename}" IsEnabled="{Binding CanUseSelected}" Style="{StaticResource QuietButton}" Margin="0,0,6,6" /><Button Content="Replace recipients…" Click="ReplaceRecipientBundleMembers" IsEnabled="{Binding CanUseSelected}" Style="{StaticResource QuietButton}" Margin="0,0,6,6" /><Button Content="Remove bundle…" Click="DeleteRecipientBundle" IsEnabled="{Binding CanUseSelected}" Style="{StaticResource DangerQuietButton}" Margin="0,0,6,6" /><Button Content="Refresh bundles" Command="{Binding Refresh}" IsEnabled="{Binding CanManage}" Style="{StaticResource QuietButton}" Margin="0,0,6,6" /></WrapPanel>
                    </StackPanel>
                  </Expander>
                  <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                </StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource SurfaceCard}"><StackPanel DataContext="{Binding ServerBrowser}">
                  <TextBlock Text="Where they’re joining" Style="{StaticResource SectionHeading}" />
                  <TextBlock Text="Same destination for everyone" Style="{StaticResource Caption}" Margin="0,2,0,12" />
                  <TextBlock Text="{Binding DataContext.GameDetails.Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding DestinationSummary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                  <TextBlock Text="{Binding DataContext.RequestedCapacitySummary, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" Foreground="{DynamicResource AccentPrimary}" Margin="0,10,0,0" />
                  <Border Style="{StaticResource Divider}" />
                  <TextBlock Text="Free slots can’t be reserved. Another player may join before your accounts do." Style="{StaticResource Caption}" />
                  <Button Content="Change server" Command="{Binding DataContext.ShowJoinStep, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="2" MinHeight="36" Margin="0,14,0,0" />
                </StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource SurfaceCard}"><StackPanel>
                  <TextBlock Text="What happens afterward" Style="{StaticResource SectionHeading}" />
                  <TextBlock Text="Choose what runs once they’re in" Style="{StaticResource Caption}" Margin="0,2,0,12" />
                  <Border Background="{DynamicResource SelectionBackground}" BorderBrush="{DynamicResource AccentPrimary}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                    <StackPanel><TextBlock Text="Launch only" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" /><TextBlock Text="Open each client and stop there." Style="{StaticResource Caption}" Margin="0,4,0,0" /></StackPanel>
                  </Border>
                  <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,8,0,0" Opacity="0.6" ToolTip="Macro playback isn't connected yet. Assign macros in Automation; they will run here once playback is wired.">
                    <StackPanel><TextBlock Text="Launch and run" FontWeight="SemiBold" /><TextBlock Text="Open each client, wait for the game, then start the assigned macro. Coming soon." Style="{StaticResource Caption}" Margin="0,4,0,0" /></StackPanel>
                  </Border>
                  <TextBlock Text="{Binding LaunchPacingStatus}" Style="{StaticResource Caption}" Margin="0,12,0,0" />
                </StackPanel></Border>
              </Grid>
              <Border Style="{StaticResource SurfaceCard}" Padding="16,12" Margin="0,0,0,16">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Queue bundle for this destination" DataContext="{Binding RecipientBundles}" Command="{Binding Queue}" IsEnabled="{Binding CanQueueSelected}" Margin="0,0,8,0" />
                    <Button Content="Stop bundle work" DataContext="{Binding RecipientBundles}" Command="{Binding Cancel}" IsEnabled="{Binding IsBusy}" Style="{StaticResource QuietButton}" Margin="0,0,8,0" />
                    <Button Content="Queue checked accounts" DataContext="{Binding ServerBrowser}" Command="{Binding DataContext.QueueTargetedAccounts, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding CanUseDestination}" Style="{StaticResource PrimaryButton}" Padding="16,6" />
                  </StackPanel>
                  <TextBlock Text="Clients open one after another. Sign-in, launch support and free memory are checked again for every account." Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,16,0" />
                </DockPanel>
              </Border>
              <Expander Header="Launch evidence and diagnostics" Margin="0,0,0,12">
                <StackPanel Margin="0,10,0,0">
                  <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,16"><StackPanel>
                    <TextBlock Text="Native launch preparation test" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="{Binding HandoffSelectionSummary}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="Research step: opens this saved account's official game page so you can choose Play; Zenith inspects and cancels the request. No client starts." Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,12" ToolTip="Inspects only the cancelled request's structure. It does not prove native account selection. Use a game-only destination; exact server requests need separate validation. Incomplete checks may require signing in again." />
                    <WrapPanel><Button Content="Inspect and prevent launch" Command="{Binding InspectNativeHandoff}" IsEnabled="{Binding CanInspectNativeHandoff}" Margin="0,0,8,8" /><Button Content="Cancel inspection" Command="{Binding CancelAuthorization}" Visibility="{Binding IsAuthorizing, Converter={StaticResource VisibleIf}}" Margin="0,0,8,8" /></WrapPanel>
                    <TextBlock Text="{Binding HandoffInspectionStatus}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel></Border>
                  <Border Style="{StaticResource SurfaceCard}"><StackPanel>
                    <TextBlock Text="Launch evidence" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="Each request stays pinned while you pick other accounts or games. Reported values are never treated as verified." Style="{StaticResource Caption}" Margin="0,4,0,10" />
                    <TextBlock Text="No launch requests yet. A confirmed native test will appear here with its requested account, game and process observations." Style="{StaticResource Muted}" Margin="0,4,0,0" Visibility="{Binding HasLaunchEvidence, Converter={StaticResource HiddenIf}}" />
                    <ComboBox ItemsSource="{Binding LaunchEvidenceRows}" SelectedItem="{Binding SelectedLaunchEvidence}" DisplayMemberPath="Label" MinHeight="36" AutomationProperties.Name="Launch request to inspect" Visibility="{Binding HasLaunchEvidence, Converter={StaticResource VisibleIf}}" />
                    <Grid Margin="0,14,0,0" Visibility="{Binding HasLaunchEvidence, Converter={StaticResource VisibleIf}}">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Requested" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="Expected player" Style="{StaticResource Caption}" Margin="0,10,0,2" /><TextBlock Text="{Binding SelectedLaunchEvidence.ExpectedPlayer}" TextWrapping="Wrap" />
                        <TextBlock Text="Place" Style="{StaticResource Caption}" Margin="0,10,0,2" /><TextBlock Text="{Binding SelectedLaunchEvidence.RequestedPlace}" TextWrapping="Wrap" />
                        <TextBlock Text="Server" Style="{StaticResource Caption}" Margin="0,10,0,2" /><TextBlock Text="{Binding SelectedLaunchEvidence.RequestedServer}" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="Reported · unverified" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="Player" Style="{StaticResource Caption}" Margin="0,10,0,2" /><TextBlock Text="{Binding SelectedLaunchEvidence.ReportedPlayer}" TextWrapping="Wrap" />
                        <TextBlock Text="Current place" Style="{StaticResource Caption}" Margin="0,10,0,2" /><TextBlock Text="{Binding SelectedLaunchEvidence.ReportedPlace}" TextWrapping="Wrap" />
                        <TextBlock Text="Current server" Style="{StaticResource Caption}" Margin="0,10,0,2" /><TextBlock Text="{Binding SelectedLaunchEvidence.ReportedServer}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding SelectedLaunchEvidence.ProcessSummary}" TextWrapping="Wrap" Margin="0,16,0,4" />
                    <TextBlock Text="{Binding SelectedLaunchEvidence.ObservationTime}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding SelectedLaunchEvidence.Comparison}" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Margin="0,12,0,4" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedLaunchEvidence.Explanation}" Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock Text="{Binding SelectedLaunchEvidence.LastKnown}" Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0" />
                    <Expander x:Name="NativeLaunchStages" Header="Native launch stages · diagnostic only" Margin="0,14,0,0" DataContext="{Binding SelectedNativeDiagnostics}" Visibility="{Binding DataContext.HasLaunchEvidence, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleIf}}">
                      <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Times}" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,12" />
                        <TextBlock Text="{Binding Trust}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding Preparation}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding Browser}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding Shape}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding Dispatch}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding Cleanup}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding StageTimes}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,8" />
                        <TextBlock Text="These transient facts are separate from process and log observations. They never verify the native account, arrival or permission to send input. Restart or history eviction can make stage details unavailable." Style="{StaticResource Muted}" FontSize="12" />
                      </StackPanel>
                    </Expander>
                    <WrapPanel Margin="0,14,0,0"><Button Content="Show process" Command="{Binding ShowEvidenceProcess}" IsEnabled="{Binding CanShowEvidenceProcess}" Margin="0,0,8,8" /><Button Content="Copy evidence" Click="CopyLaunchEvidence" IsEnabled="{Binding HasLaunchEvidence}" Style="{StaticResource QuietButton}" Margin="0,0,8,8" /><Button Content="Save evidence…" Click="SaveLaunchEvidence" IsEnabled="{Binding HasLaunchEvidence}" Style="{StaticResource QuietButton}" Margin="0,0,8,8" /></WrapPanel>
                    <TextBlock Text="Exports include player, place and server IDs, stage outcomes and timestamps. They exclude names, credentials, launch addresses, raw logs and installation paths." Style="{StaticResource Caption}" />
                  </StackPanel></Border>
                </StackPanel>
              </Expander>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="AutomationPage" Visibility="{Binding IsAutomation, Converter={StaticResource VisibleIf}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="Automation" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Assign saved Zenith macros to accounts, groups or bundles." Style="{StaticResource Caption}" Margin="0,2,0,16" />
            <Border Style="{StaticResource WarningBanner}" Margin="0,0,0,18">
              <DockPanel>
                <Path DockPanel.Dock="Left" Data="M8,1 L15,14 H1 Z M8,6 V9.5 M8,11.5 V12" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource AccentWarning}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="Macro playback isn’t connected yet. You can browse macros and save assignments, but nothing will run." TextWrapping="Wrap" VerticalAlignment="Center" ToolTip="Nothing runs from this page, and saving an assignment never starts playback." />
              </DockPanel>
            </Border>
            <Border Style="{StaticResource Panel}" Margin="0,0,0,24" DataContext="{Binding MacroHostCatalog}">
              <StackPanel>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Saved macros" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding HostVersion}" Style="{StaticResource Muted}" Margin="0,5,0,0" /></StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Stop request" Command="{Binding Cancel}" IsEnabled="{Binding IsBusy}" Style="{StaticResource QuietButton}" Margin="14,0,0,0" /><Button Content="Refresh host macros" Command="{Binding Refresh}" IsEnabled="{Binding CanRefresh}" Margin="8,0,0,0" /></StackPanel>
                </Grid>
                <TextBlock Text="Record and edit macros in the Zenith editor; they appear here once saved." Style="{StaticResource Caption}" Margin="0,10,0,12" />
                <ListView ItemsSource="{Binding Macros}" SelectedItem="{Binding SelectedMacro}" Height="220" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderBrushLight}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Saved Personal Zenith macros">
