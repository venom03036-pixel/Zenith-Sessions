                        <Button Content="Remove profile" IsEnabled="{Binding HasSelection}" Click="RemoveProfile" Style="{StaticResource DangerQuietButton}" MinHeight="36" Margin="0,8,0,0" />
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
          <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Previous" IsEnabled="{Binding CanPrevious}" Command="{Binding PreviousPage}" Style="{StaticResource GhostButton}" MinHeight="36" />
              <Button Content="Next" IsEnabled="{Binding CanNext}" Command="{Binding NextPage}" Style="{StaticResource GhostButton}" MinHeight="36" />
            </StackPanel>
            <TextBlock Text="{Binding PageLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
          </DockPanel>
        </Grid>
