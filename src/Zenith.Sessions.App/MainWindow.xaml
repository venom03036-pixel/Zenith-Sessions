                        <TextBlock Text="{Binding Dispatch}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding Cleanup}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding StageTimes}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,8" />
