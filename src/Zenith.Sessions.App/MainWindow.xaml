              <GridViewColumn Header="Subsystem" Width="150" DisplayMemberBinding="{Binding Subsystem}" />
              <GridViewColumn Header="Event" Width="400" DisplayMemberBinding="{Binding Description}" />
              <GridViewColumn Header="Error class" Width="170" DisplayMemberBinding="{Binding ErrorType}" />
            </GridView></ListView.View>
          </ListView>
          <StackPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock Text="{Binding DiagnosticViewStatus}" Style="{StaticResource Caption}" /><TextBlock Text="{Binding DiagnosticStorageStatus}" Style="{StaticResource Caption}" Margin="0,2,0,0" /></StackPanel>
