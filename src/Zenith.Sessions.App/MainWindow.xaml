                    <TextBlock Text="System" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" />
                  </DockPanel>
                  <DockPanel Margin="0,0,0,14">
                    <local:ResourceSparkline DockPanel.Dock="Right" Points="{Binding Telemetry.PhysicalPoints}" Ceiling="{Binding Telemetry.PhysicalCeiling}" Style="{StaticResource OverviewChart}" AutomationProperties.Name="Available physical RAM history" />
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Free memory" Style="{StaticResource Caption}" ToolTip="Available physical RAM, as measured by Windows" />
                      <TextBlock Text="{Binding Overview.Physical}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Telemetry.PhysicalRange}" ToolTip="{Binding Telemetry.PhysicalRange}" Style="{StaticResource CaptionLine}" />
                    </StackPanel>
                  </DockPanel>
                  <DockPanel Margin="0,0,0,14">
                    <local:ResourceSparkline DockPanel.Dock="Right" Points="{Binding Telemetry.CommitPoints}" Ceiling="{Binding Telemetry.CommitCeiling}" Style="{StaticResource OverviewChart}" AutomationProperties.Name="System committed memory history" />
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Committed memory" Style="{StaticResource Caption}" ToolTip="System commit charge: memory Windows has promised to processes, out of the commit limit" />
                      <TextBlock Text="{Binding Overview.Commit}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Telemetry.CommitRange}" ToolTip="{Binding Telemetry.CommitRange}" Style="{StaticResource CaptionLine}" />
                    </StackPanel>
                  </DockPanel>
                  <DockPanel Margin="0,0,0,10">
                    <local:ResourceSparkline DockPanel.Dock="Right" Points="{Binding Telemetry.CpuPoints}" Ceiling="100" Style="{StaticResource OverviewChart}" AutomationProperties.Name="Machine CPU history" />
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="CPU" Style="{StaticResource Caption}" ToolTip="Whole-machine CPU use. Gaps in the chart are unknown, not zero." />
                      <TextBlock Text="{Binding Overview.Cpu}" FontSize="15" FontWeight="SemiBold" />
                      <TextBlock Text="All logical processors" Style="{StaticResource CaptionLine}" />
                    </StackPanel>
                  </DockPanel>
                  <Border Style="{StaticResource Divider}" Margin="0,4,0,10" />
                  <TextBlock Text="{Binding Overview.ResourceSummary}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Overview.ResourceCaption}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                  <Expander x:Name="OverviewDetails" Header="Capacity details" Margin="0,8,0,0">
                    <StackPanel Margin="0,8,0,0">
                      <TextBlock Text="{Binding Overview.ForecastCaption}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Capacity}" TextWrapping="Wrap" Margin="0,8,0,0" />
                      <TextBlock Text="{Binding PressureNotice}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                      <TextBlock Text="{Binding Telemetry.SystemStatus}" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
                      <TextBlock Text="{Binding ActivePerformanceSummary}" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
                      <Expander Header="GPU measurements" Margin="0,10,0,0"><StackPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding GpuTelemetry.Status}" Style="{StaticResource Muted}" FontSize="12" />
                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding GpuTelemetry.Adapters}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8,0,0">
                          <TextBlock Text="{Binding Identity}" FontWeight="SemiBold" FontSize="12" />
                          <WrapPanel Margin="0,4,0,0"><TextBlock Text="{Binding Engine}" Margin="0,0,18,0" FontSize="12" /><TextBlock Text="{Binding Dedicated}" Margin="0,0,18,0" FontSize="12" /><TextBlock Text="{Binding Shared}" FontSize="12" /></WrapPanel>
                          <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="11" />
                        </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                        <TextBlock Text="GPU usage is not memory capacity. Shared GPU memory is part of system RAM." Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" />
                      </StackPanel></Expander>
                      <TextBlock Text="Account-selecting launch is still being verified." Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" ToolTip="Standard account-selecting launch remains unavailable. Explicit native trials do not prove account selection or arrival." />
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="0" VerticalAlignment="Top">
                <StackPanel>
                  <DockPanel Margin="20,16,12,10">
                    <Button DockPanel.Dock="Right" Content="Open Sessions" Command="{Binding Navigate}" CommandParameter="Sessions" Style="{StaticResource QuietButton}" MinHeight="28" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Running clients" Style="{StaticResource SectionHeading}" /><TextBlock Text="{Binding Sessions.Count}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel>
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding Sessions}" MaxHeight="232" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Running clients summary">
                    <ItemsControl.Template><ControlTemplate TargetType="ItemsControl"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter /></ScrollViewer></ControlTemplate></ItemsControl.Template>
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,1,0,0" Padding="20,10">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding CpuPercent, StringFormat={}{0:0.0}%, TargetNullValue=—}" Style="{StaticResource MonoText}" Width="52" TextAlignment="Right" VerticalAlignment="Center" />
                          <TextBlock DockPanel.Dock="Left" Text="{Binding ProcessLabel}" Style="{StaticResource MonoText}" Foreground="{DynamicResource TextPrimary}" Width="110" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" Style="{StaticResource CaptionLine}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                        </DockPanel>
                      </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="No Roblox clients running." Margin="20,4,20,16">
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Sessions.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Border>
            </Grid>
            <TextBlock Text="Recent activity" Style="{StaticResource SectionHeading}" Margin="0,0,0,8" />
            <ListBox x:Name="OverviewRecentActivity" ItemsSource="{Binding Events}" Background="Transparent" BorderThickness="0" MaxHeight="170" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="0,4"><Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{DynamicResource TextMuted}" Margin="2,0,12,0" VerticalAlignment="Center" /><TextBlock Text="{Binding}" Style="{StaticResource Muted}" FontSize="12" /></DockPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="AccountsWorkspace" Visibility="{Binding IsAccounts, Converter={StaticResource VisibleIf}}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
              <Button x:Name="AccountLibraryTools" Content="Import or export" Click="OpenMoreOptions" MinHeight="36" Style="{StaticResource QuietButton}" Margin="0,0,8,0" AutomationProperties.Name="Account library tools" ToolTip="Import, export or create a profile without signing in">
                <Button.ContextMenu>
                  <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Import profile metadata…" Click="ImportProfiles" IsEnabled="{Binding IsReady}" />
                    <MenuItem Header="Export profile metadata…" Click="ExportProfiles" IsEnabled="{Binding IsReady}" />
                    <Separator />
                    <MenuItem Header="Create profile only…" Click="AddProfile" IsEnabled="{Binding IsReady}" ToolTip="Optional local metadata without signing in. It cannot authorize a Roblox launch." />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
              <Button Content="+ Add account" Command="{Binding AddRobloxAccount}" IsEnabled="{Binding CanAddRobloxAccount}" MinHeight="36" Padding="14,6" Style="{StaticResource PrimaryButton}" ToolTip="Sign in on Roblox’s own page. The saved account uses its verified username and player ID." />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Accounts" Style="{StaticResource PageTitle}" />
              <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"><Run Text="{Binding AccountCount, Mode=OneWay}" /><Run Text=" saved · groups, sign-ins and preferred games" /></TextBlock>
            </StackPanel>
          </DockPanel>
          <WrapPanel x:Name="AccountToolbar" Grid.Row="1" Margin="0,0,0,12" KeyboardNavigation.TabNavigation="Continue">
            <Grid Width="260" Margin="0,0,8,8">
              <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search accounts" ToolTip="Search names and usernames" MinHeight="36" Padding="30,0,8,0" VerticalContentAlignment="Center" />
              <Path Style="{StaticResource Glyph}" Stroke="{DynamicResource TextMuted}" Width="14" Height="14" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Data="M11.5,7 A4.5,4.5 0 1 1 2.5,7 A4.5,4.5 0 1 1 11.5,7 M10.5,10.5 L13.7,13.7" />
              <TextBlock Text="Search accounts" Margin="31,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" IsHitTestVisible="False">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </Grid>
            <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding Group}" Style="{StaticResource SavedGroupFilterCombo}" Width="150" MinHeight="36" Margin="0,0,8,8" ToolTip="{Binding GroupChoicesNotice}" AutomationProperties.Name="Account group filter" />
            <ComboBox ItemsSource="{Binding SortChoices}" SelectedItem="{Binding SortChoice}" DisplayMemberPath="Label" Width="140" MinHeight="36" Margin="0,0,8,8" AutomationProperties.Name="Sort accounts" ToolTip="Sort" />
            <CheckBox Content="Compact" IsChecked="{Binding Dense}" VerticalAlignment="Center" Margin="4,0,14,8" MinHeight="36" ToolTip="Fit more accounts on screen" />
