<Window x:Class="Zenith.Sessions.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:theme="clr-namespace:MacroSuite.App.Themes" xmlns:local="clr-namespace:Zenith.Sessions.App" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="{Binding WindowTitle}" local:Localization.Strings="{Binding Strings}" FlowDirection="{Binding Strings.FlowDirection}" Language="{Binding Strings.XmlLanguage}" Width="1320" Height="840" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <!-- Key bindings come from ShellShortcuts (built in the MainWindow constructor), the same table the Guide lists. -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <DataTemplate x:Key="SavedGroupFilterTemplate">
      <StackPanel Orientation="Horizontal" ToolTip="{Binding Label}" VerticalAlignment="Center">
        <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center">
          <Border.Style><Style TargetType="Border">
            <Setter Property="Background" Value="{Binding ColorHex}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ColorHex}" Value="{x:Null}"><Setter Property="Background" Value="{DynamicResource AccentPrimary}" /></DataTrigger>
              <DataTrigger Binding="{Binding Value}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
          </Style></Border.Style>
        </Border>
        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>
    <Style x:Key="SavedGroupFilterCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="ItemTemplate" Value="{StaticResource SavedGroupFilterTemplate}" />
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
      <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="HistoryChart" TargetType="{x:Type local:ResourceSparkline}">
      <Setter Property="Height" Value="72" /><Setter Property="Margin" Value="0,14,0,8" />
      <Setter Property="LineBrush" Value="{DynamicResource AccentPrimary}" /><Setter Property="GridBrush" Value="{DynamicResource BorderBrushLight}" />
    </Style>
    <Style x:Key="SessionNav" TargetType="Button" BasedOn="{StaticResource NavTabButton}">
      <Style.Resources>
        <!-- The app's implicit TextBlock style draws every label in TextPrimary, whatever the button's colour. On the current page the
             label is drawn in the selection text colour instead, since under Windows High Contrast TextPrimary is the window text colour,
             which does not read on the Highlight colour; hovering shows the hover fill, so it goes back to TextPrimary. -->
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SelectionForeground}" /></DataTrigger>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}" /></DataTrigger>
          </Style.Triggers>
        </Style>
      </Style.Resources>
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Fill" Background="{TemplateBinding Background}" Padding="10,0" CornerRadius="6">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
              </Border>
              <!-- Active marker kept as a part for the template contract; the filled row is the visible state. -->
              <Border x:Name="Rail" Width="2" Margin="0,10" CornerRadius="1" HorizontalAlignment="Left" Background="{TemplateBinding BorderBrush}" Opacity="0" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Fill" Property="Background" Value="{DynamicResource HoverBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
          <Setter Property="Background" Value="{DynamicResource SelectionBackground}" />
          <!-- The icon's colour; the labels follow the same rule in Style.Resources above. -->
          <Setter Property="Foreground" Value="{DynamicResource SelectionForeground}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="NavigationIcon" TargetType="Path">
      <Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" /><Setter Property="Stretch" Value="Uniform" />
      <Setter Property="StrokeThickness" Value="1.4" /><Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
      <Setter Property="StrokeLineJoin" Value="Round" /><Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Background" Value="{DynamicResource CardBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Height" Value="32" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
    </Style>
    <Style TargetType="ListViewItem" BasedOn="{StaticResource SessionsListViewRow}">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="LineHeight" Value="19" />
    </Style>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style x:Key="AccountItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1">
              <Grid>
                <Border x:Name="Rail" Width="2" HorizontalAlignment="Left" Background="Transparent" />
                <ContentPresenter Margin="12,0,8,0" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBackground}" />
              </Trigger>
              <!-- The row templates also colour each label with SelectionForeground while selected: the app's implicit TextBlock style
                   would otherwise draw them in TextPrimary, the window text colour under Windows High Contrast, on the Highlight colour. -->
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource SelectionForeground}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Rail" Property="Background" Value="{DynamicResource AccentPrimary}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Account row: avatar + name/@username · group, sign-in and launch state, one action. The headshot is centre-cropped (UniformToFill) and clipped to the rounded square, so every Roblox picture sits centred. -->
    <DataTemplate x:Key="AccountRow">
      <Grid Height="56">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="44" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition x:Name="AccountStatusColumn" Width="150" />
          <ColumnDefinition Width="92" />
          <ColumnDefinition Width="32" />
        </Grid.ColumnDefinitions>
        <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" AutomationProperties.Name="Select profile" />
        <Grid Grid.Column="1" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="{Binding PublicProfileEvidence}">
          <Grid.Clip><RectangleGeometry Rect="0,0,32,32" RadiusX="7" RadiusY="7" /></Grid.Clip>
          <Border Background="{DynamicResource SurfaceBackground}" />
          <Path x:Name="AccountAvatarPlaceholder" Data="M 12,2 A 4,4 0 1 1 11.99,2 M 4,22 L 4,19 C 4,12 20,12 20,19 L 20,22" Width="16" Height="18" Stretch="Uniform" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"><Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasAvatar}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Path.Style></Path>
          <Image Source="{Binding Avatar}" Width="32" Height="32" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasAvatar, Converter={StaticResource VisibleIf}}" AutomationProperties.Name="Roblox avatar headshot" />
        </Grid>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="2,0,8,0">
          <TextBlock x:Name="AccountName" Text="{Binding Label}" ToolTip="{Binding Alias}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="AccountIdentityGroups" Margin="0,2,0,0" ToolTip="{Binding Destination}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMuted}" FontSize="12"><Run Text="{Binding Username, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Group, Mode=OneWay}" /></TextBlock>
          <TextBlock x:Name="CompactAccountStatus" Visibility="Collapsed" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding LinkedAccount}"><Run Text="{Binding Identity, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding LaunchStatus, Mode=OneWay}" /></TextBlock>
        </StackPanel>
        <StackPanel x:Name="AccountStatus" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0"><ContentControl Content="{Binding Identity}" Style="{StaticResource SignInChip}" ToolTip="{Binding LinkedAccount}" /><TextBlock x:Name="AccountLaunchStatus" Text="{Binding LaunchStatus}" ToolTip="{Binding LaunchStatus}" Style="{StaticResource CaptionLine}" Margin="2,4,0,0" /></StackPanel>
        <Button Grid.Column="4" Content="{Binding PowerLabel}" ToolTip="{Binding PowerExplanation}" Command="{Binding DataContext.AccountPower, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource RowActionButton}" VerticalAlignment="Center" MinHeight="36" Padding="10,0" Margin="0,0,6,0" AutomationProperties.Name="{Binding PowerLabel}" />
        <Button Grid.Column="5" Style="{StaticResource RowIconButton}" Click="OpenMoreOptions" AutomationProperties.Name="Account actions" ToolTip="Account actions" VerticalAlignment="Center">
          <Path Style="{StaticResource Glyph}" StrokeThickness="2" Data="M3.5,8 L3.6,8 M8,8 L8.1,8 M12.5,8 L12.6,8" />
          <Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="Edit profile" Tag="Edit" Click="AccountRowMenu" /><MenuItem Header="Refresh public avatar" Tag="Avatar" Click="AccountRowMenu" /><MenuItem Header="Use preferred game" Tag="Preferred" Click="AccountRowMenu" /><Separator /><MenuItem Header="Disconnect account link" Tag="Disconnect" Click="AccountRowMenu" /><MenuItem Header="Remove saved profile" Tag="Remove" Click="AccountRowMenu" /></ContextMenu></Button.ContextMenu>
        </Button>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding DataContext.CompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter TargetName="AccountStatusColumn" Property="Width" Value="0" />
          <Setter TargetName="AccountStatus" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="CompactAccountStatus" Property="Visibility" Value="Visible" />
        </DataTrigger>
        <!-- Every label drawn on the selected row uses the selection text colour (see AccountItem). The chip and buttons draw their own fill. -->
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter TargetName="AccountName" Property="Foreground" Value="{DynamicResource SelectionForeground}" />
          <Setter TargetName="AccountIdentityGroups" Property="Foreground" Value="{DynamicResource SelectionForeground}" />
          <Setter TargetName="CompactAccountStatus" Property="Foreground" Value="{DynamicResource SelectionForeground}" />
          <Setter TargetName="AccountLaunchStatus" Property="Foreground" Value="{DynamicResource SelectionForeground}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="DenseAccountRow">
      <Grid Height="44">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition x:Name="DenseGroupColumn" Width="100" />
          <ColumnDefinition Width="96" />
          <ColumnDefinition Width="90" />
        </Grid.ColumnDefinitions>
        <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="Select profile" VerticalAlignment="Center" />
        <Grid Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
          <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid Width="28" Height="28" HorizontalAlignment="Left" ToolTip="{Binding PublicProfileEvidence}">
            <Grid.Clip><RectangleGeometry Rect="0,0,28,28" RadiusX="6" RadiusY="6" /></Grid.Clip>
            <Border Background="{DynamicResource SurfaceBackground}" />
            <Path x:Name="DenseAvatarPlaceholder" Data="M 12,2 A 4,4 0 1 1 11.99,2 M 4,22 L 4,19 C 4,12 20,12 20,19 L 20,22" Width="14" Height="16" Stretch="Uniform" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"><Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasAvatar}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Path.Style></Path>
            <Image Source="{Binding Avatar}" Width="28" Height="28" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasAvatar, Converter={StaticResource VisibleIf}}" AutomationProperties.Name="Roblox avatar headshot" />
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="DenseAccountName" Text="{Binding Label}" ToolTip="{Binding Alias}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
            <TextBlock x:Name="DenseAccountUsername" Text="{Binding Username}" ToolTip="{Binding Username}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,1,0,0" />
          </StackPanel>
        </Grid>
        <TextBlock x:Name="DenseAccountGroup" Grid.Column="2" Text="{Binding Group}" ToolTip="{Binding Group}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
        <ContentControl Grid.Column="3" Content="{Binding Identity}" Style="{StaticResource SignInChip}" ToolTip="{Binding LinkedAccount}" />
        <Button Grid.Column="4" Content="{Binding PowerLabel}" ToolTip="{Binding PowerExplanation}" Command="{Binding DataContext.AccountPower, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource RowActionButton}" Padding="10,0" Margin="6,4,0,4" MinHeight="36" AutomationProperties.Name="{Binding PowerLabel}" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding DataContext.CompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter TargetName="DenseGroupColumn" Property="Width" Value="0" />
          <Setter TargetName="DenseAccountGroup" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <!-- As in AccountRow: the selected row's labels use the selection text colour. -->
        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
          <Setter TargetName="DenseAccountName" Property="Foreground" Value="{DynamicResource SelectionForeground}" />
          <Setter TargetName="DenseAccountUsername" Property="Foreground" Value="{DynamicResource SelectionForeground}" />
          <Setter TargetName="DenseAccountGroup" Property="Foreground" Value="{DynamicResource SelectionForeground}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>
  <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="44" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Grid.ColumnSpan="2" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" MouseLeftButtonDown="DragHeader">
        <Grid Margin="16,0,6,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <theme:ThemeAwareLogo Width="22" Height="22" />
            <TextBlock Text="Zenith Sessions" FontSize="13" FontWeight="SemiBold" Margin="10,0,8,0" VerticalAlignment="Center" />
            <TextBlock Text="{local:Text Header_Personal}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Command="{Binding Panic}" ToolTip="{Binding PanicShortcutStatus}" Style="{StaticResource DangerButton}" MinHeight="28" Padding="10,2" AutomationProperties.Name="{Binding PanicLabel}">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource Glyph}" Width="12" Height="12" Data="M4,4 L12,4 L12,12 L4,12 Z" Margin="0,0,7,0" />
                <TextBlock Text="{Binding PanicLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Border Style="{StaticResource KeyCap}" Margin="8,0,10,0" ToolTip="{local:Text Header_PanicShortcutTooltip}"><TextBlock Text="{Binding PanicKeyCap}" Style="{StaticResource MonoText}" FontSize="11" /></Border>
            <Button Command="{Binding Lock}" Style="{StaticResource IconButton}" ToolTip="{local:Text Header_LockTooltip}" AutomationProperties.Name="{local:Text Header_Lock}">
              <Path Style="{StaticResource Glyph}" Data="M3,7 L13,7 L13,14 L3,14 Z M5.2,7 L5.2,5 A2.8,2.8 0 0 1 10.8,5 L10.8,7" />
            </Button>
            <Button Style="{StaticResource IconButton}" Click="OpenMoreOptions" ToolTip="{local:Text Header_MoreOptions}" AutomationProperties.Name="{local:Text Header_MoreOptions}">
              <Path Style="{StaticResource Glyph}" StrokeThickness="2" Data="M3.5,8 L3.6,8 M8,8 L8.1,8 M12.5,8 L12.6,8" />
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Open data folder" Click="OpenDataFolder" />
                  <Separator />
                  <MenuItem Header="Exit manager" Click="ExitManager" />
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <Border Width="1" Height="20" Background="{DynamicResource BorderBrushLight}" Margin="8,0" />
            <Button Style="{StaticResource IconButton}" Width="40" Click="MinimizeWindow" AutomationProperties.Name="{local:Text Header_Minimize}" ToolTip="{local:Text Header_Minimize}"><Path Style="{StaticResource Glyph}" Width="12" Height="12" Data="M2,8 L14,8" /></Button>
            <Button Style="{StaticResource IconButton}" Width="40" Click="MaximizeWindow" AutomationProperties.Name="{local:Text Header_MaximizeOrRestore}" ToolTip="{local:Text Header_MaximizeOrRestore}"><Path Style="{StaticResource Glyph}" Width="11" Height="11" Data="M2,2 L14,2 L14,14 L2,14 Z" /></Button>
            <Button Style="{StaticResource IconButton}" Width="40" Click="CloseWindow" AutomationProperties.Name="{Binding CloseButtonLabel}" ToolTip="{Binding CloseButtonLabel}"><Path Style="{StaticResource Glyph}" Width="11" Height="11" Data="M2,2 L14,14 M14,2 L2,14" /></Button>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="1" x:Name="NavigationRail" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,1,0">
        <DockPanel Margin="12,14,12,14" KeyboardNavigation.TabNavigation="Continue">
          <StackPanel DockPanel.Dock="Bottom" Margin="10,16,8,0">
            <TextBlock Text="{Binding ProductLabel}" Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Button Command="{Binding Navigate}" CommandParameter="Overview" Tag="{Binding IsOverview}" Style="{StaticResource SessionNav}" AutomationProperties.Name="{local:Text Page_Overview}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavigationIcon}" Data="M1,7 L8,1 15,7 M3,6 V15 H13 V6 M6,15 V10 H10 V15" /><TextBlock Text="{local:Text Page_Overview}" Margin="10,0,0,0" /></StackPanel></Button>
            <Button Command="{Binding Navigate}" CommandParameter="Accounts" Tag="{Binding IsAccounts}" Style="{StaticResource SessionNav}" AutomationProperties.Name="{local:Text Page_Accounts}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Path Style="{StaticResource NavigationIcon}" Data="M11,4 A3,3 0 1 1 5,4 A3,3 0 1 1 11,4 M2,15 V12 Q2,8 8,8 Q14,8 14,12 V15 Z" /><TextBlock Grid.Column="1" Text="{local:Text Page_Accounts}" /><TextBlock Grid.Column="2" Text="{Binding AccountCount}" FontSize="12" FontWeight="Normal" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource TextMuted}" /><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SelectionForeground}" /></DataTrigger><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextMuted}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Button>
            <Button Command="{Binding Navigate}" CommandParameter="Sessions" Tag="{Binding IsSessionWorkspace}" Style="{StaticResource SessionNav}" AutomationProperties.Name="{local:Text Page_Sessions}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavigationIcon}" Data="M1,1 H15 V11 H1 Z M8,11 V15 M4,15 H12" /><TextBlock Text="{local:Text Page_Sessions}" Margin="10,0,0,0" /></StackPanel></Button>
            <Button Command="{Binding ShowWindowsOverview}" Tag="{Binding IsWindows}" Style="{StaticResource SessionNav}" AutomationProperties.Name="{local:Text Page_Windows}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavigationIcon}" Data="M1,1 H7 V7 H1 Z M9,1 H15 V7 H9 Z M1,9 H7 V15 H1 Z M9,9 H15 V15 H9 Z" /><TextBlock Text="{local:Text Page_Windows}" Margin="10,0,0,0" /></StackPanel></Button>
            <Button Command="{Binding Navigate}" CommandParameter="Automation" Tag="{Binding IsAutomation}" Style="{StaticResource SessionNav}" AutomationProperties.Name="{local:Text Page_Automation}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavigationIcon}" Data="M4,1 L14,8 4,15 Z" /><TextBlock Text="{local:Text Page_Automation}" Margin="10,0,0,0" /></StackPanel></Button>
            <Border Background="{DynamicResource BorderBrushLight}" Height="1" Margin="10,12" />
            <Button Command="{Binding Navigate}" CommandParameter="Diagnostics" Tag="{Binding IsDiagnostics}" Style="{StaticResource SessionNav}" AutomationProperties.Name="{local:Text Page_Diagnostics}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavigationIcon}" Data="M1,9 H4.5 L6.3,4 L9.5,13 L11.3,8.5 H15" /><TextBlock Text="{local:Text Page_Diagnostics}" Margin="10,0,0,0" /></StackPanel></Button>
            <Button Command="{Binding Navigate}" CommandParameter="Settings" Tag="{Binding IsSettings}" Style="{StaticResource SessionNav}" AutomationProperties.Name="{local:Text Page_Settings}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavigationIcon}" Data="M1,3 H15 M1,8 H15 M1,13 H15 M5,1 V5 M11,6 V10 M6,11 V15" /><TextBlock Text="{local:Text Page_Settings}" Margin="10,0,0,0" /></StackPanel></Button>
            <Button Command="{Binding Navigate}" CommandParameter="Guide" Tag="{Binding IsGuide}" Style="{StaticResource SessionNav}" AutomationProperties.Name="{local:Text Page_Guide}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavigationIcon}" Data="M8,3 Q4,0 1,2 V14 Q4,12 8,15 Q12,12 15,14 V2 Q12,0 8,3 V15" /><TextBlock Text="{local:Text Page_Guide}" Margin="10,0,0,0" /></StackPanel></Button>
            <Button Command="{Binding Navigate}" CommandParameter="News" Tag="{Binding IsNews}" Style="{StaticResource SessionNav}" AutomationProperties.Name="{local:Text Page_News}"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavigationIcon}" Data="M2,1 H14 V15 H2 Z M5,4 H11 M5,8 H11 M5,12 H9" /><TextBlock Text="{local:Text Page_News}" Margin="10,0,0,0" /></StackPanel></Button>
          </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <Grid Grid.Row="1" Grid.Column="1" x:Name="PageHost" Margin="28,22,28,16" SizeChanged="ContentSizeChanged">
        <ScrollViewer x:Name="NewsPage" Visibility="{Binding IsNews, Converter={StaticResource VisibleIf}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <DockPanel Margin="0,0,0,16">
              <Button DockPanel.Dock="Right" Content="{local:Text News_Refresh}" Command="{Binding News.Refresh}" IsEnabled="{Binding News.CanRefresh}" MinHeight="36" Margin="16,0,0,0" />
              <TextBlock Text="{local:Text Page_News}" Style="{StaticResource PageTitle}" />
            </DockPanel>
            <TextBlock Text="{local:Text News_Description}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Text="{Binding News.Status}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16" AutomationProperties.LiveSetting="Polite" />
            <ItemsControl ItemsSource="{Binding News.Items}">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PublishedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm} UTC}" Style="{StaticResource CaptionLine}" Margin="0,6,0,8" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Button Content="{local:Text News_OpenArticle}" Click="OpenNewsArticleClick" HorizontalAlignment="Left" MinHeight="36" />
                  </StackPanel>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="OverviewPage" Visibility="{Binding IsOverview, Converter={StaticResource VisibleIf}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ScrollViewer.Resources><Style x:Key="OverviewChart" TargetType="{x:Type local:ResourceSparkline}" BasedOn="{StaticResource HistoryChart}"><Setter Property="Height" Value="40" /><Setter Property="Width" Value="140" /><Setter Property="Margin" Value="12,0,0,0" /></Style></ScrollViewer.Resources>
          <StackPanel>
            <DockPanel Margin="0,0,0,18">
              <WrapPanel x:Name="OverviewNavigation" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                <Button Content="Accounts" Command="{Binding Navigate}" CommandParameter="Accounts" Style="{StaticResource QuietButton}" MinHeight="36" Margin="0,0,2,0" />
                <Button Content="Windows" Command="{Binding ShowWindowsOverview}" Style="{StaticResource QuietButton}" MinHeight="36" Margin="0,0,2,0" ToolTip="See running clients side by side. Previews stay off until you start them." />
                <Button Content="Automation" Command="{Binding Navigate}" CommandParameter="Automation" Style="{StaticResource QuietButton}" MinHeight="36" Margin="0,0,2,0" />
                <Button Content="Open queue" Command="{Binding OpenOverviewQueue}" Style="{StaticResource QuietButton}" MinHeight="36" Margin="0,0,10,0" ToolTip="Show the launch queue. This does not resume or start anything." />
                <Button Content="Join a game" Command="{Binding Navigate}" CommandParameter="JoinGame" Style="{StaticResource PrimaryButton}" Padding="16,6" MinHeight="36" ToolTip="Pick a game and server. Opening this page never launches anything." />
              </WrapPanel>
              <StackPanel>
                <TextBlock Text="Overview" Style="{StaticResource PageTitle}" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <TextBlock Text="Accounts, running clients and launches at a glance" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                  <Button Command="{Binding Refresh}" IsEnabled="{Binding IsReady}" Style="{StaticResource IconButton}" Width="28" Height="28" MinHeight="28" Margin="6,0,0,0" ToolTip="Refresh" AutomationProperties.Name="Refresh overview"><Path Style="{StaticResource Glyph}" Width="13" Height="13" Data="M13.5,8 A5.5,5.5 0 1 1 11.9,4.1 M13.5,2.5 L13.5,5.7 L10.3,5.7" /></Button>
                </StackPanel>
              </StackPanel>
            </DockPanel>
            <Border Style="{StaticResource SurfaceCard}" Padding="0" Margin="0,0,0,8">
              <Grid x:Name="OverviewWorkspaceCounts">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel Margin="20,16">
                  <TextBlock Text="Saved accounts" Style="{StaticResource FieldLabel}" />
                  <TextBlock Text="{Binding Overview.SavedProfiles,TargetNullValue=—}" Style="{StaticResource MetricValue}" AutomationProperties.Name="Saved profile library total" />
                  <TextBlock Text="{Binding Overview.LibraryCaption}" ToolTip="{Binding Overview.LibraryCaption}" Style="{StaticResource CaptionLine}" />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource BorderBrushLight}" />
                <StackPanel Grid.Column="2" Margin="20,16">
                  <TextBlock Text="Running clients" Style="{StaticResource FieldLabel}" />
                  <TextBlock Text="{Binding Overview.ObservedProcesses,TargetNullValue=—}" Style="{StaticResource MetricValue}" AutomationProperties.Name="Observed process total when complete" />
                  <TextBlock Text="{Binding Overview.ProcessCaption}" ToolTip="{Binding Overview.ProcessCaption}" Style="{StaticResource CaptionLine}" />
                </StackPanel>
                <Border Grid.Column="3" Background="{DynamicResource BorderBrushLight}" />
                <StackPanel Grid.Column="4" Margin="20,16">
                  <TextBlock Text="Queued launches" Style="{StaticResource FieldLabel}" />
                  <TextBlock Text="{Binding Overview.QueuedRequests,TargetNullValue=—}" Style="{StaticResource MetricValue}" AutomationProperties.Name="Queued request total" />
                  <TextBlock Text="{Binding Overview.QueueCaption}" ToolTip="{Binding Overview.QueueCaption}" Style="{StaticResource CaptionLine}" />
                </StackPanel>
              </Grid>
            </Border>
            <TextBlock Text="{Binding Overview.QueueSummary}" ToolTip="{Binding Overview.QueueSummary}" Style="{StaticResource CaptionLine}" Margin="2,0,0,18" />
            <Grid Margin="0,0,0,22">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource SurfaceCard}">
                <StackPanel x:Name="OverviewResources">
                  <DockPanel Margin="0,0,0,14">
                    <Button DockPanel.Dock="Right" Content="{Binding ActivePerformanceName}" ContentStringFormat="Mode · {0}" Command="{Binding Navigate}" CommandParameter="Settings" Style="{StaticResource QuietButton}" MinHeight="28" ToolTip="{Binding ActivePerformanceSummary}" AutomationProperties.Name="Current manager performance profile; open Settings" />
                    <TextBlock Text="System" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" />
                  </DockPanel>
                  <DockPanel Margin="0,0,0,14">
                    <local:ResourceSparkline DockPanel.Dock="Right" Points="{Binding Telemetry.PhysicalPoints}" Ceiling="{Binding Telemetry.PhysicalCeiling}" Style="{StaticResource OverviewChart}" AutomationProperties.Name="Available physical RAM history" />
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Free memory" Style="{StaticResource Caption}" ToolTip="Available physical RAM, as measured by Windows" />
                      <TextBlock Text="{Binding Overview.Physical}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Telemetry.PhysicalRange}" ToolTip="{Binding Telemetry.PhysicalRange}" Style="{StaticResource CaptionLine}" />
                    </StackPanel>
                  </DockPanel>
                  <DockPanel Margin="0,0,0,14">
                    <local:ResourceSparkline DockPanel.Dock="Right" Points="{Binding Telemetry.CommitPoints}" Ceiling="{Binding Telemetry.CommitCeiling}" Style="{StaticResource OverviewChart}" AutomationProperties.Name="System committed memory history" />
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Committed memory" Style="{StaticResource Caption}" ToolTip="System commit charge: memory Windows has promised to processes, out of the commit limit" />
                      <TextBlock Text="{Binding Overview.Commit}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Telemetry.CommitRange}" ToolTip="{Binding Telemetry.CommitRange}" Style="{StaticResource CaptionLine}" />
                    </StackPanel>
                  </DockPanel>
                  <DockPanel Margin="0,0,0,10">
                    <local:ResourceSparkline DockPanel.Dock="Right" Points="{Binding Telemetry.CpuPoints}" Ceiling="100" Style="{StaticResource OverviewChart}" AutomationProperties.Name="Machine CPU history" />
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="CPU" Style="{StaticResource Caption}" ToolTip="Whole-machine CPU use. Gaps in the chart are unknown, not zero." />
                      <TextBlock Text="{Binding Overview.Cpu}" FontSize="15" FontWeight="SemiBold" />
                      <TextBlock Text="All logical processors" Style="{StaticResource CaptionLine}" />
                    </StackPanel>
                  </DockPanel>
                  <Border Style="{StaticResource Divider}" Margin="0,4,0,10" />
                  <TextBlock Text="{Binding Overview.ResourceSummary}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Overview.ResourceCaption}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                  <Expander x:Name="OverviewDetails" Header="Capacity details" Margin="0,8,0,0">
                    <StackPanel Margin="0,8,0,0">
                      <TextBlock Text="{Binding Overview.ForecastCaption}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Capacity}" TextWrapping="Wrap" Margin="0,8,0,0" />
                      <TextBlock Text="{Binding PressureNotice}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                      <TextBlock Text="{Binding Telemetry.SystemStatus}" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
                      <TextBlock Text="{Binding ActivePerformanceSummary}" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
                      <Expander Header="GPU measurements" Margin="0,10,0,0"><StackPanel Margin="0,8,0,0">
                        <TextBlock Text="{Binding GpuTelemetry.Status}" Style="{StaticResource Muted}" FontSize="12" />
                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding GpuTelemetry.Adapters}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8,0,0">
                          <TextBlock Text="{Binding Identity}" FontWeight="SemiBold" FontSize="12" />
                          <WrapPanel Margin="0,4,0,0"><TextBlock Text="{Binding Engine}" Margin="0,0,18,0" FontSize="12" /><TextBlock Text="{Binding Dedicated}" Margin="0,0,18,0" FontSize="12" /><TextBlock Text="{Binding Shared}" FontSize="12" /></WrapPanel>
                          <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="11" />
                        </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                        <TextBlock Text="GPU usage is not memory capacity. Shared GPU memory is part of system RAM." Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" />
                      </StackPanel></Expander>
                      <TextBlock Text="{Binding AccountLaunchAvailability}" Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" ToolTip="Direct ticket launches the saved account without a setup trial. The account and publisher are checked before start; arrival is reported separately." />
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" Padding="0" VerticalAlignment="Top">
                <StackPanel>
                  <DockPanel Margin="20,16,12,10">
                    <Button DockPanel.Dock="Right" Content="Open Sessions" Command="{Binding Navigate}" CommandParameter="Sessions" Style="{StaticResource QuietButton}" MinHeight="28" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Running clients" Style="{StaticResource SectionHeading}" /><TextBlock Text="{Binding Sessions.Count}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel>
                  </DockPanel>
                  <ItemsControl ItemsSource="{Binding Sessions}" MaxHeight="232" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Running clients summary">
                    <ItemsControl.Template><ControlTemplate TargetType="ItemsControl"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter /></ScrollViewer></ControlTemplate></ItemsControl.Template>
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,1,0,0" Padding="20,10">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding CpuPercent, StringFormat={}{0:0.0}%, TargetNullValue=—}" Style="{StaticResource MonoText}" Width="52" TextAlignment="Right" VerticalAlignment="Center" />
                          <TextBlock DockPanel.Dock="Left" Text="{Binding ProcessLabel}" Style="{StaticResource MonoText}" Foreground="{DynamicResource TextPrimary}" Width="110" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" Style="{StaticResource CaptionLine}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                        </DockPanel>
                      </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="No Roblox clients running." Margin="20,4,20,16">
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Sessions.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Border>
            </Grid>
            <TextBlock Text="Recent activity" Style="{StaticResource SectionHeading}" Margin="0,0,0,8" />
            <ListBox x:Name="OverviewRecentActivity" ItemsSource="{Binding Events}" Background="Transparent" BorderThickness="0" MaxHeight="170" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="0,4"><Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{DynamicResource TextMuted}" Margin="2,0,12,0" VerticalAlignment="Center" /><TextBlock Text="{Binding}" Style="{StaticResource Muted}" FontSize="12" /></DockPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="AccountsWorkspace" Visibility="{Binding IsAccounts, Converter={StaticResource VisibleIf}}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
              <Button x:Name="AccountLibraryTools" Content="Import or export" Click="OpenMoreOptions" MinHeight="36" Style="{StaticResource QuietButton}" Margin="0,0,8,0" AutomationProperties.Name="Account library tools" ToolTip="Import, export or create a profile without signing in">
                <Button.ContextMenu>
                  <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Import profile metadata…" Click="ImportProfiles" IsEnabled="{Binding IsReady}" />
                    <MenuItem Header="Export profile metadata…" Click="ExportProfiles" IsEnabled="{Binding IsReady}" />
                    <Separator />
                    <MenuItem Header="Export protected backup (contains sign-ins)…" Click="ExportProtectedBackup" IsEnabled="{Binding CanUsePortableBackup}" />
                    <MenuItem Header="Import protected backup…" Click="ImportProtectedBackup" IsEnabled="{Binding CanUsePortableBackup}" />
                    <Separator />
                    <MenuItem Header="Create profile only…" Click="AddProfile" IsEnabled="{Binding IsReady}" ToolTip="Optional local metadata without signing in. It cannot authorize a Roblox launch." />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
              <Button Content="+ Add account" Command="{Binding AddRobloxAccount}" IsEnabled="{Binding CanAddRobloxAccount}" MinHeight="36" Padding="14,6" Style="{StaticResource PrimaryButton}" ToolTip="Sign in on Roblox’s own page. The saved account uses its verified username and player ID." />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Accounts" Style="{StaticResource PageTitle}" />
              <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"><Run Text="{Binding AccountCount, Mode=OneWay}" /><Run Text=" saved · groups, sign-ins and preferred games" /></TextBlock>
            </StackPanel>
          </DockPanel>
          <WrapPanel x:Name="AccountToolbar" Grid.Row="1" Margin="0,0,0,12" KeyboardNavigation.TabNavigation="Continue">
            <Grid Width="260" Margin="0,0,8,8">
              <TextBox x:Name="AccountsSearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search accounts" ToolTip="Search names and usernames · Ctrl+F" MinHeight="36" Padding="30,0,8,0" VerticalContentAlignment="Center" />
              <Path Style="{StaticResource Glyph}" Stroke="{DynamicResource TextMuted}" Width="14" Height="14" HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" Data="M11.5,7 A4.5,4.5 0 1 1 2.5,7 A4.5,4.5 0 1 1 11.5,7 M10.5,10.5 L13.7,13.7" />
              <TextBlock Text="Search accounts" Margin="31,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" IsHitTestVisible="False">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </Grid>
            <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding Group}" Style="{StaticResource SavedGroupFilterCombo}" Width="150" MinHeight="36" Margin="0,0,8,8" ToolTip="{Binding GroupChoicesNotice}" AutomationProperties.Name="Account group filter" />
            <ComboBox ItemsSource="{Binding SortChoices}" SelectedItem="{Binding SortChoice}" DisplayMemberPath="Label" Width="140" MinHeight="36" Margin="0,0,8,8" AutomationProperties.Name="Sort accounts" ToolTip="Sort" />
            <CheckBox Content="Compact" IsChecked="{Binding Dense}" VerticalAlignment="Center" Margin="4,0,14,8" MinHeight="36" ToolTip="Fit more accounts on screen" />
            <Border Width="1" Height="22" Background="{DynamicResource BorderBrushLight}" Margin="0,0,8,8" VerticalAlignment="Center" />
            <Button Content="Select page" Click="SelectPage" Style="{StaticResource QuietButton}" MinHeight="36" Margin="0,0,2,8" ToolTip="Check or clear the accounts on this page" />
            <Button Content="Add to group" Click="AddCheckedToGroup" IsEnabled="{Binding IsReady}" Style="{StaticResource QuietButton}" MinHeight="36" Margin="0,0,2,8" ToolTip="Add checked accounts on this page to a group" />
            <Button Content="Manage groups…" Click="ManageGroups" IsEnabled="{Binding IsReady}" Style="{StaticResource QuietButton}" MinHeight="36" Margin="0,0,2,8" ToolTip="Create groups, choose colors and order, or review a rename or removal" />
            <Button Content="Check checked sign-ins" Command="{Binding CheckCheckedSignIns}" IsEnabled="{Binding IsReady}" Style="{StaticResource QuietButton}" MinHeight="36" Margin="0,0,2,8" ToolTip="Ask Roblox whether each checked account's saved sign-in still works, one at a time. Stops if Roblox cannot be reached." />
            <Button Content="Remove checked" Click="RemoveSelected" Style="{StaticResource DangerQuietButton}" MinHeight="36" Margin="0,0,8,8" ToolTip="Review removal of checked profiles on this page" />
            <Button Content="Refresh presence" Command="{Binding RefreshPresence}" IsEnabled="{Binding IsReady}" Style="{StaticResource QuietButton}" MinHeight="36" Margin="0,0,2,8" ToolTip="Ask Roblox for each checked account's own presence, or the selected account. Only runs when clicked." />
            <Button Content="Review friendship pairs…" Click="ReviewFriendshipPairs" IsEnabled="{Binding IsReady}" Style="{StaticResource QuietButton}" MinHeight="36" Margin="0,0,2,8" />
            <Button Content="{Binding AccountInspectorToggleLabel}" Command="{Binding ToggleAccountInspector}" MinHeight="36" Margin="0,0,8,8" Visibility="{Binding IsAccountInspectorNarrow, Converter={StaticResource VisibleIf}}" AutomationProperties.Name="Toggle account details" />
            <Button Content="{Binding CancelAccountActionLabel, FallbackValue=Cancel account setup}" Command="{Binding CancelAuthorization}" MinHeight="36" Margin="0,0,8,8" Visibility="{Binding IsAuthorizing, Converter={StaticResource VisibleIf}}" />
            <TextBlock Text="{Binding GroupChoicesNotice}" MaxWidth="640" FontSize="11" Margin="0,0,8,6" VerticalAlignment="Center">
              <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding GroupChoicesNotice}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </WrapPanel>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="0" x:Name="FilterColumn" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition x:Name="InspectorColumn">
                <ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="340" /><Style.Triggers><DataTrigger Binding="{Binding IsAccountInspectorVisible}" Value="False"><Setter Property="Width" Value="0" /></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style>
              </ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="1" x:Name="AccountsListHost">
              <Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0" /><Style.Triggers><DataTrigger Binding="{Binding IsAccountInspectorVisible}" Value="True"><Setter Property="Margin" Value="0,0,16,0" /></DataTrigger></Style.Triggers></Style></Grid.Style>
              <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="8" />
              <ListBox x:Name="AccountList" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" ItemContainerStyle="{StaticResource AccountItem}" Background="Transparent" BorderThickness="0" Margin="1" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="EditProfile" AutomationProperties.Name="Saved account library">
                <ListBox.Style><Style TargetType="ListBox"><Setter Property="ItemTemplate" Value="{StaticResource AccountRow}" /><Style.Triggers><DataTrigger Binding="{Binding Dense}" Value="True"><Setter Property="ItemTemplate" Value="{StaticResource DenseAccountRow}" /></DataTrigger></Style.Triggers></Style></ListBox.Style>
              </ListBox>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Margin="16">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Accounts.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <Path Data="M11,4 A3,3 0 1 1 5,4 A3,3 0 1 1 11,4 M2,15 V12 Q2,8 8,8 Q14,8 14,12 V15 Z" Width="32" Height="32" Stretch="Uniform" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.4" StrokeLineJoin="Round" HorizontalAlignment="Center" Margin="0,0,0,14" />
                <TextBlock Text="{Binding EmptyAccountsText}" Foreground="{DynamicResource TextSecondary}" TextAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
            <Border Grid.Column="2" x:Name="AccountInspector" Style="{StaticResource Panel}" Padding="0" Visibility="{Binding IsAccountInspectorVisible, Converter={StaticResource VisibleIf}}">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="AccountInspectorScroll">
                <StackPanel Margin="22,18,22,20">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding ToggleAccountInspector}" Style="{StaticResource IconButton}" Width="28" Height="28" MinHeight="28" Visibility="{Binding IsAccountInspectorNarrow, Converter={StaticResource VisibleIf}}" ToolTip="Close details" AutomationProperties.Name="Close account details"><Path Style="{StaticResource Glyph}" Width="11" Height="11" Data="M2,2 L14,14 M14,2 L2,14" /></Button>
                    <TextBlock Text="Account details" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                  </DockPanel>
                  <Button Content="{Binding CancelAccountActionLabel, FallbackValue=Cancel account setup}" Command="{Binding CancelAuthorization}" Margin="0,12,0,0" MinHeight="36" Visibility="{Binding IsAuthorizing, Converter={StaticResource VisibleIf}}" />
                  <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource HiddenIf}}" Margin="0,24,0,0">
                    <TextBlock Text="Select an account" Style="{StaticResource SectionHeading}" TextWrapping="Wrap" />
                    <TextBlock Text="Choose a row to see its sign-in, session and preferred game." Style="{StaticResource Muted}" Margin="0,6,0,16" />
                    <Button Content="+ Add account" Command="{Binding AddRobloxAccount}" IsEnabled="{Binding CanAddRobloxAccount}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" MinHeight="36" />
                  </StackPanel>
                  <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource VisibleIf}}">
                    <Grid Margin="0,16,0,12">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <Grid Width="56" Height="56" ToolTip="{Binding SelectedAccount.PublicProfileEvidence}">
                        <Grid.Clip><RectangleGeometry Rect="0,0,56,56" RadiusX="10" RadiusY="10" /></Grid.Clip>
                        <Border Background="{DynamicResource SurfaceBackground}" />
                        <Path x:Name="InspectorAvatarPlaceholder" Data="M 12,2 A 4,4 0 1 1 11.99,2 M 4,22 L 4,19 C 4,12 20,12 20,19 L 20,22" Width="26" Height="28" Stretch="Uniform" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center"><Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding SelectedAccount.HasAvatar}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Path.Style></Path>
                        <Image Source="{Binding SelectedAccount.Avatar}" Width="56" Height="56" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding SelectedAccount.HasAvatar, Converter={StaticResource VisibleIf}}" AutomationProperties.Name="Selected Roblox avatar headshot" />
                      </Grid>
                      <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedAccount.Label}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedAccount.Alias}" />
                        <TextBlock Text="{Binding SelectedAccount.Username}" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding SelectedAccount.PublicDisplayName}" Style="{StaticResource CaptionLine}" Margin="0,2,0,0" ToolTip="Public display name. It does not verify sign-in or a running client." />
                      </StackPanel>
                      <Button Grid.Column="2" Command="{Binding ToggleFavorite}" IsEnabled="{Binding HasSelection}" Style="{StaticResource IconButton}" VerticalAlignment="Top" ToolTip="{Binding SelectedAccount.FavoriteLabel}" AutomationProperties.Name="{Binding SelectedAccount.FavoriteLabel}"><Path Style="{StaticResource Glyph}" Stroke="{DynamicResource AccentWarning}" Data="M8,2.2 L9.8,5.9 L13.8,6.5 L10.9,9.3 L11.6,13.3 L8,11.4 L4.4,13.3 L5.1,9.3 L2.2,6.5 L6.2,5.9 Z" /></Button>
                    </Grid>
                    <WrapPanel>
                      <ContentControl Content="{Binding SelectedAccount.Group}" Style="{StaticResource ChipNeutral}" Margin="0,0,6,6" ToolTip="{Binding SelectedAccount.Group}" />
                      <ContentControl Content="{Binding SelectedAccount.Identity}" Style="{StaticResource SignInChip}" Margin="0,0,6,6" ToolTip="{Binding SelectedAccount.LinkedAccount}" />
                    </WrapPanel>
                    <Border Style="{StaticResource Divider}" />
                    <TextBlock Text="Session" FontWeight="SemiBold" />
                    <Grid Margin="0,10,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <TextBlock Text="Status" Style="{StaticResource KeyText}" />
                      <ContentControl Grid.Column="1" Content="{Binding SelectedAccount.LaunchStatus}" Style="{StaticResource LaunchChip}" HorizontalAlignment="Right" ToolTip="{Binding SelectedAccount.LaunchStatus}" />
                      <TextBlock Grid.Row="1" Text="Preferred game" Style="{StaticResource KeyText}" Margin="0,10,12,0" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedAccount.Destination}" ToolTip="{Binding SelectedAccount.Destination}" Style="{StaticResource ValueText}" Margin="0,10,0,0" />
                    </Grid>
                    <Button Content="{Binding SelectedAccount.PowerLabel}" Command="{Binding AccountPower}" CommandParameter="{Binding SelectedAccount}" IsEnabled="{Binding QueueReady}" Style="{StaticResource PrimaryButton}" ToolTip="{Binding SelectedAccount.PowerExplanation}" MinHeight="36" Margin="0,14,0,0" />
                    <Button Content="Choose server…" Command="{Binding OpenJoinGameForSelectedAccount}" IsEnabled="{Binding HasSelection}" MinHeight="36" Margin="0,8,0,0" />
                    <Border Style="{StaticResource Divider}" />
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="Open Automation" Command="{Binding Navigate}" CommandParameter="Automation" Style="{StaticResource QuietButton}" MinHeight="28" />
                      <TextBlock Text="Assigned macro" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="Assign and review macros in Automation." Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    <Border Style="{StaticResource Divider}" />
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                      <TextBlock Text="Group" Style="{StaticResource KeyText}" />
                      <TextBlock Grid.Column="1" Text="{Binding SelectedAccount.Group}" ToolTip="{Binding SelectedAccount.Group}" Style="{StaticResource ValueText}" />
                      <TextBlock Grid.Row="1" Text="Favorite" Style="{StaticResource KeyText}" Margin="0,10,12,0" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedAccount.FavoriteLabel}" Style="{StaticResource ValueText}" Margin="0,10,0,0" />
                      <TextBlock Grid.Row="2" Text="Sign-in" Style="{StaticResource KeyText}" Margin="0,10,12,0" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedAccount.Identity}" ToolTip="{Binding SelectedAccount.LinkedAccount}" Style="{StaticResource ValueText}" Margin="0,10,0,0" />
                    </Grid>
                    <TextBlock Text="Notes" Style="{StaticResource KeyText}" Margin="0,14,0,6" />
                    <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="6" Padding="12,10">
                      <TextBlock Text="{Binding SelectedAccount.Notes, TargetNullValue=No notes}" Style="{StaticResource Muted}" MaxHeight="120" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <Expander Header="Saved sign-in" Margin="0,16,0,0">
                      <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="{Binding SelectedAccount.LinkedAccount}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10" />
                        <Button Content="Sign in with Roblox" Command="{Binding LinkAccount}" MinHeight="36" />
                        <Button Content="Check saved sign-in" Command="{Binding RefreshAuthorization}" MinHeight="36" Margin="0,8,0,0" />
                        <Button Content="Remove saved sign-in" Click="DisconnectAccount" Style="{StaticResource DangerQuietButton}" MinHeight="36" Margin="0,8,0,0" />
                        <TextBlock Text="Your password stays on Roblox’s page. Zenith checks the player ID before saving an encrypted session." Style="{StaticResource Caption}" Margin="0,10,0,0" />
                      </StackPanel>
                    </Expander>
                    <Expander Header="More actions" Margin="0,8,0,0">
                      <StackPanel Margin="0,10,0,0">
                        <Button Content="Use as main account" Command="{Binding SetSelectedAsMain}" IsEnabled="{Binding HasSelection}" MinHeight="36" ToolTip="Choose this profile for Main Account Priority, then save settings. Active launches keep their original timings." />
                        <Button Content="Refresh public avatar" Command="{Binding RefreshPublicAccount}" IsEnabled="{Binding HasSelection}" MinHeight="36" Margin="0,8,0,0" />
                        <TextBlock Text="Roblox account observations" Style="{StaticResource FieldLabel}" Margin="0,16,0,8" />
                        <TextBlock Text="{Binding SelectedAccount.ServerPresenceText}" Style="{StaticResource Muted}" />
                        <TextBlock Text="Server-reported presence is separate from this client's launch status." Style="{StaticResource Caption}" Margin="0,4,0,8" />
                        <Button Content="Refresh private details" Command="{Binding RefreshPrivateDetails}" IsEnabled="{Binding HasSelection}" MinHeight="36" />
                        <TextBlock Text="{Binding PrivateAccountDetails}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                        <TextBlock Text="Private details stay in memory. Lock, Panic and changing accounts clear them." Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding FriendshipResults}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                        <Button Content="Edit selected profile" IsEnabled="{Binding HasSelection}" Click="EditProfile" MinHeight="36" Margin="0,8,0,0" />
                        <Button Content="Remove profile" IsEnabled="{Binding HasSelection}" Click="RemoveProfile" Style="{StaticResource DangerQuietButton}" MinHeight="36" Margin="0,8,0,0" />
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
          <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Previous" IsEnabled="{Binding CanPrevious}" Command="{Binding PreviousPage}" Style="{StaticResource GhostButton}" MinHeight="36" />
              <Button Content="Next" IsEnabled="{Binding CanNext}" Command="{Binding NextPage}" Style="{StaticResource GhostButton}" MinHeight="36" />
            </StackPanel>
            <TextBlock Text="{Binding PageLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
          </DockPanel>
        </Grid>
        <Grid x:Name="SessionsPage" Visibility="{Binding IsSessions, Converter={StaticResource VisibleIf}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
              <Border Style="{StaticResource SegmentBar}" Margin="0,0,10,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Button Content="Table" Command="{Binding ShowClientTableMode}" Tag="{Binding IsClientTableMode}" Style="{StaticResource SegmentButton}" />
                  <Button x:Name="SessionsPreviewModeButton" Content="Previews" Command="{Binding ShowClientPreviewMode}" Tag="{Binding IsClientPreviewMode}" Style="{StaticResource SegmentButton}" Margin="2,0,0,0" />
                  <Button Content="History" Command="{Binding ShowClientHistoryMode}" Tag="{Binding IsClientHistoryMode}" Style="{StaticResource SegmentButton}" Margin="2,0,0,0" />
                </StackPanel>
              </Border>
              <Button Content="Join a game" Command="{Binding Navigate}" CommandParameter="JoinGame" MinHeight="36" Padding="16,6" Style="{StaticResource PrimaryButton}" ToolTip="Pick a game and server without changing your running clients." />
            </StackPanel>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Sessions" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                <ContentControl Style="{StaticResource InfoTip}" Margin="10,2,0,0" ToolTip="Native process observations with separate, read-only log diagnostics. Reported player and place IDs are unverified; they never authorize account actions. A place and server the log last confirmed more than five minutes ago stay shown with that age while the client's log still says it is connected; Join same game, Join same server and Copy need fresher evidence." AutomationProperties.Name="About session observations" />
              </StackPanel>
              <TextBlock Text="{Binding ProcessInventoryStatus}" ToolTip="{Binding ProcessInventoryStatus}" Style="{StaticResource CaptionLine}" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
          <ScrollViewer Grid.Row="1" MaxHeight="210" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12"><StackPanel x:Name="ClientWindowTools">
            <WrapPanel Margin="0,0,0,4">
              <Button Content="Select / clear clients" Command="{Binding SelectClientPage}" Style="{StaticResource QuietButton}" Margin="0,0,2,8" />
              <Button Content="Minimize clients" Command="{Binding MinimizeCheckedClients}" IsEnabled="{Binding CanChangeClientStates}" Style="{StaticResource QuietButton}" Margin="0,0,2,8" />
              <Button Content="Restore clients" Command="{Binding RestoreCheckedClients}" IsEnabled="{Binding CanChangeClientStates}" Style="{StaticResource QuietButton}" Margin="0,0,2,8" />
              <Button Content="Open Windows view" Command="{Binding ShowWindowsOverview}" Style="{StaticResource QuietButton}" Margin="0,0,10,8" ToolTip="See all running clients tiled inside Zenith." />
              <Border Width="1" Height="22" Background="{DynamicResource BorderBrushLight}" Margin="0,0,10,8" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding ClientDisplays}" SelectedItem="{Binding SelectedClientDisplay}" DisplayMemberPath="Label" MinWidth="210" MaxWidth="380" AutomationProperties.Name="Arrange on monitor" ToolTip="Monitor to tile checked clients on" Margin="0,0,4,8" />
              <Button Command="{Binding RefreshClientDisplays}" IsEnabled="{Binding CanRefreshClientDisplays}" Style="{StaticResource IconButton}" Margin="0,0,6,8" ToolTip="Refresh monitors" AutomationProperties.Name="Refresh monitors"><Path Style="{StaticResource Glyph}" Width="14" Height="14" Data="M13.5,8 A5.5,5.5 0 1 1 11.9,4.1 M13.5,2.5 L13.5,5.7 L10.3,5.7" /></Button>
              <Button Content="Tile clients" Command="{Binding ArrangeClients}" IsEnabled="{Binding CanArrangeClients}" Margin="0,0,4,8" />
              <Button Content="Cancel" Command="{Binding CancelClientWindowWork}" IsEnabled="{Binding IsArrangingClients}" Style="{StaticResource QuietButton}" Margin="0,0,8,8" />
              <ContentControl Style="{StaticResource InfoTip}" Margin="0,0,0,8" ToolTip="Working set includes shared pages; commit is separate. Faults include soft and hard faults. Unavailable counters stay unknown." AutomationProperties.Name="About client measurements" />
            </WrapPanel>
            <WrapPanel Visibility="{Binding IsClientPreviewMode, Converter={StaticResource VisibleIf}}">
              <Button Content="Preview checked clients" Command="{Binding StartClientPreviews}" IsEnabled="{Binding CanStartClientPreviews}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
              <Button Content="Stop previews" Command="{Binding StopClientPreviews}" IsEnabled="{Binding ClientPreviews.CanStop}" Margin="0,0,8,8" />
              <TextBlock Text="{Binding ClientPreviews.Status}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="4,0,0,8" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding CheckedClientCount, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ClientWindowStatus, Mode=OneWay}" /></TextBlock>
            <Expander x:Name="ClientWindowSizeTools" Header="Client window size" Margin="0,8,0,0" AutomationProperties.Name="Client window size">
            <StackPanel x:Name="ClientContentSizeTools" Margin="0,8,0,0">
              <TextBlock Text="Content size · physical pixels" FontWeight="SemiBold" />
              <TextBlock Text="Apply to checked clients, or the selected row when none are checked. Window frames add extra pixels. Each client stays on its current monitor; no foreground activation is requested." Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,8" />
              <WrapPanel>
                <StackPanel IsEnabled="{Binding CanEditClientSize}" Margin="0,0,12,8"><TextBlock Text="Content width" Style="{StaticResource Muted}" FontSize="12" /><StackPanel Orientation="Horizontal"><TextBox x:Name="ClientContentWidthBox" Text="{Binding ClientContentWidth, UpdateSourceTrigger=PropertyChanged}" Width="136" MaxLength="5" AutomationProperties.Name="Client content width in physical pixels" /><TextBlock Text="px" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0" /></StackPanel></StackPanel>
                <StackPanel IsEnabled="{Binding CanEditClientSize}" Margin="0,0,12,8"><TextBlock Text="Content height" Style="{StaticResource Muted}" FontSize="12" /><StackPanel Orientation="Horizontal"><TextBox Text="{Binding ClientContentHeight, UpdateSourceTrigger=PropertyChanged}" Width="136" MaxLength="5" AutomationProperties.Name="Client content height in physical pixels" /><TextBlock Text="px" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0" /></StackPanel></StackPanel>
                <Button Content="Tiny · 320 × 240" Command="{Binding UseTinyClientSize}" IsEnabled="{Binding CanEditClientSize}" ToolTip="Fill the temporary dimensions only. Choose Apply size to resize clients." VerticalAlignment="Bottom" Margin="0,0,8,8" />
                <Button Content="Apply size" Command="{Binding ResizeCheckedClients}" IsEnabled="{Binding CanResizeClients}" VerticalAlignment="Bottom" Margin="0,0,8,8" />
              </WrapPanel>
            </StackPanel>
            </Expander>
            <Expander x:Name="ClientPriorityTools" Header="{local:Text GuideHeading_CpuPriority}" Margin="0,8,0,0" AutomationProperties.Name="{local:Text GuideHeading_CpuPriority}">
              <StackPanel Margin="0,8,0,0">
                <TextBlock Text="Apply to checked clients, or the selected row when none are checked. Below normal gives other work more scheduling priority when the CPU is busy. Efficiency mode also turns on Windows EcoQoS power throttling and very low memory priority. Spread over cores divides the CPU cores among the checked clients it can change, and needs at least two such clients and two cores for each. Their shares do not overlap, but clients spread in separate operations can share cores. Cap CPU puts each checked client in a Windows job this run of Zenith creates for it and limits that client's threads, together, to the chosen share of all CPU time on this PC; a client already in a Windows job (another program's, or one left by an earlier run of Zenith) is left alone. Normal and Below normal change only the priority; Restore original returns every setting Zenith changed, and lifts a cap." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10" />
                <WrapPanel>
                  <Button Content="Normal" Command="{Binding SetClientsNormalPriority}" IsEnabled="{Binding CanChangeClientPriority}" MinHeight="36" Margin="0,0,8,8" />
                  <Button x:Name="SetClientPriorityBelowNormal" Content="Below normal" Command="{Binding SetClientsBelowNormalPriority}" IsEnabled="{Binding CanChangeClientPriority}" MinHeight="36" Margin="0,0,8,8" />
                  <Button x:Name="SetClientEfficiencyMode" Content="Efficiency mode" Command="{Binding SetClientsEfficiencyMode}" IsEnabled="{Binding CanChangeClientPriority}" MinHeight="36" Margin="0,0,8,8" ToolTip="Below normal priority, EcoQoS power throttling and very low memory priority. Restore original returns the client's own values." />
                  <Button Content="Spread over cores" Command="{Binding SpreadClientsOverCores}" IsEnabled="{Binding CanChangeClientPriority}" MinHeight="36" Margin="0,0,8,8" ToolTip="Divide the CPU cores among the checked clients that can be changed, so none of them share a core. Clients spread in separate operations can share cores. Restore original returns each client's own cores." />
                  <StackPanel Orientation="Horizontal" Margin="0,0,8,8">
                    <ComboBox ItemsSource="{Binding ClientCpuCapChoices}" SelectedItem="{Binding ClientCpuCapPercent}" IsEnabled="{Binding CanChangeClientPriority}" MinWidth="64" MinHeight="36" AutomationProperties.Name="CPU cap share, percent of all CPU time on this PC" ToolTip="The most CPU time each checked client may use, as a share of all CPU time on this PC (all cores together). Chosen per click; not saved." />
                    <TextBlock Text="% of all CPUs" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,6,0" />
                    <Button x:Name="CapClientCpu" Content="Cap CPU" Command="{Binding CapClientsCpu}" IsEnabled="{Binding CanChangeClientPriority}" MinHeight="36" ToolTip="Put each checked client in a Windows job Zenith creates for it and limit that client's threads, together, to the chosen share of all CPU time. The cap may lower its frame rate when CPU time is the limiting factor. A client already in a Windows job (another program's, or one left by an earlier run of Zenith) is left alone. Restore original lifts the cap. Windows keeps a process in its job for life, so a cap left by a crash lasts until that client exits; Zenith names such clients when it next starts." />
                  </StackPanel>
                  <Button Content="Restore original" Command="{Binding RestoreClientsPriority}" IsEnabled="{Binding CanChangeClientPriority}" MinHeight="36" Margin="0,0,8,8" />
                  <Button Content="Cancel priority work" Command="{Binding CancelClientPriority}" IsEnabled="{Binding IsChangingClientPriority}" MinHeight="36" Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock Text="{Binding ClientPriorityStatus}" TextWrapping="Wrap" Margin="0,0,0,6" />
                <TextBlock Text="{Binding PendingPriorityRestoreCount, StringFormat='Clients with original priority, efficiency, core or CPU cap settings awaiting restoration: {0}'}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                <ListView ItemsSource="{Binding ClientPriorityResults}" MaxHeight="160" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Client priority results">
                  <ListView.View><GridView>
                    <GridViewColumn Header="Process" Width="100" DisplayMemberBinding="{Binding Session.ProcessId, StringFormat='PID {0}'}" />
                    <GridViewColumn Header="Result" Width="650" DisplayMemberBinding="{Binding Explanation}" />
                  </GridView></ListView.View>
                </ListView>
                <TextBlock Text="Zenith checks each result and attempts to restore its changes on Exit. A crash or refused restore can leave a setting active until you change it or that client exits; a CPU cap left that way lasts until that client exits, because Windows keeps a process in its job for life, and Zenith names such clients when it next starts. CPU priority, efficiency mode and core spreading do not set a CPU percentage, FPS or memory limit. Cap CPU sets a hard share of all CPU time and nothing else, and Zenith has not measured any speed, memory or capacity benefit from any of them." Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
              </StackPanel>
            </Expander>
            <Expander x:Name="ClientMemoryTrimTools" Header="Client memory trim" Margin="0,8,0,0" AutomationProperties.Name="Client memory trim">
              <StackPanel Margin="0,8,0,0">
                <TextBlock Text="Apply to checked clients, or the selected row when none are checked. Windows moves each client's resident pages out of its working set; pages the client uses again are read back in. Zenith trims one client per second and reads its private working set before and about 10 s after." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10" />
                <WrapPanel>
                  <Button x:Name="TrimClientsNowButton" Content="Trim now" Command="{Binding TrimClientsNow}" IsEnabled="{Binding CanTrimClients}" MinHeight="36" Margin="0,0,8,8" />
                  <Button Content="Cancel trim" Command="{Binding CancelClientTrim}" IsEnabled="{Binding IsTrimmingClients}" MinHeight="36" Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock Text="{Binding ClientTrimStatus}" TextWrapping="Wrap" Margin="0,0,0,6" />
                <ListView ItemsSource="{Binding ClientTrimResults}" MaxHeight="160" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Client memory trim results">
                  <ListView.View><GridView>
                    <GridViewColumn Header="Process" Width="100" DisplayMemberBinding="{Binding Session.ProcessId, StringFormat='PID {0}'}" />
                    <GridViewColumn Header="Result" Width="650" DisplayMemberBinding="{Binding Explanation}" />
                  </GridView></ListView.View>
                </ListView>
                <TextBlock Text="A trim does not free committed memory and is not a memory limit. Zenith has not measured any speed, stability or capacity benefit; a smaller working set number alone is not one." Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
              </StackPanel>
            </Expander>
            <Expander x:Name="ClientSoundTools" Header="{local:Text GuideHeading_ClientSound}" Margin="0,8,0,0" AutomationProperties.Name="{local:Text GuideHeading_ClientSound}">
              <StackPanel Margin="0,8,0,0">
                <TextBlock Text="Apply to checked clients, or the selected row when none are checked. Mute turns off a client's own sound in Windows, the same switch as its entry in Volume mixer. Unmute turns it on again, also for a client that started muted. Roblox's settings and files are not changed." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10" />
                <WrapPanel>
                  <Button x:Name="MuteClientsButton" Content="Mute" Command="{Binding MuteClients}" IsEnabled="{Binding CanChangeClientSound}" MinHeight="36" Margin="0,0,8,8" />
                  <Button Content="Unmute" Command="{Binding UnmuteClients}" IsEnabled="{Binding CanChangeClientSound}" MinHeight="36" Margin="0,0,8,8" />
                  <Button Content="Cancel sound work" Command="{Binding CancelClientSound}" IsEnabled="{Binding IsChangingClientSound}" MinHeight="36" Margin="0,0,8,8" />
                </WrapPanel>
                <WrapPanel>
                  <CheckBox x:Name="MuteArrivingClientsOption" Content="Mute clients when they appear" IsChecked="{Binding MuteArrivingClients}" MinHeight="36" VerticalContentAlignment="Center" Margin="0,0,12,8" AutomationProperties.Name="Mute clients when they appear" />
                  <Button Content="Save all settings" Command="{Binding SaveSettings}" MinHeight="36" Margin="0,0,0,8" />
                </WrapPanel>
                <TextBlock Text="Off until you turn it on and save. Then each client that starts afterwards is muted as soon as Windows lists its sound, for up to 2 minutes after it appears. Clients already running are left alone; use Mute for them. Panic, Lock and Cancel sound work pause it until you resume it." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8" />
                <WrapPanel>
                  <Button x:Name="ResumeArrivalMuteButton" Content="Resume muting new clients" Command="{Binding ResumeArrivalMute}" IsEnabled="{Binding CanResumeArrivalMute}" MinHeight="36" Margin="0,0,12,8" />
                  <TextBlock Text="{Binding ArrivalMuteStatus}" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="640" Margin="0,0,0,8" />
                </WrapPanel>
                <TextBlock Text="{Binding ClientSoundStatus}" TextWrapping="Wrap" Margin="0,0,0,6" />
                <ListView ItemsSource="{Binding ClientSoundResults}" MaxHeight="160" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Client sound results">
                  <ListView.View><GridView>
                    <GridViewColumn Header="Process" Width="100" DisplayMemberBinding="{Binding Session.ProcessId, StringFormat='PID {0}'}" />
                    <GridViewColumn Header="Result" Width="650" DisplayMemberBinding="{Binding Explanation}" />
                  </GridView></ListView.View>
                </ListView>
                <TextBlock Text="Zenith turns the sound it muted on again on Unmute and on Exit. Windows can remember a mute for the next client of the same program, so a client that closes while muted, or a crash, can leave a later client muted; Unmute or Volume mixer turns it on." Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
              </StackPanel>
            </Expander>
            <Expander x:Name="UploadLimitTools" Header="Upload limit" Margin="0,8,0,0" AutomationProperties.Name="Upload limit">
              <StackPanel Margin="0,8,0,0">
                <TextBlock Text="Limit what all Roblox clients together may send over the network, through a Windows QoS policy on the Roblox client executables. Apply upload limit and Remove each run Windows PowerShell as administrator, so Windows shows its administrator prompt first; nothing is changed until you approve it, and Zenith never applies a limit on its own. The policy lives in Windows' active policy store only and ends when Windows restarts. Nothing in the client is changed." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10" />
                <WrapPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,8,8">
                    <TextBox x:Name="UploadLimitRateBox" Text="{Binding UploadLimitRate, UpdateSourceTrigger=PropertyChanged}" Width="120" MaxLength="12" IsEnabled="{Binding CanChangeUploadLimit}" MinHeight="36" VerticalContentAlignment="Center" AutomationProperties.Name="Upload limit in kilobits per second" ToolTip="Whole kilobits per second, 100 to 10,000,000, for all Roblox clients together. Read when you choose Apply upload limit." />
                    <TextBlock Text="kbit/s" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                  </StackPanel>
                  <Button x:Name="ApplyUploadLimitButton" Content="Apply upload limit" Command="{Binding ApplyUploadLimit}" IsEnabled="{Binding CanChangeUploadLimit}" MinHeight="36" Margin="0,0,8,8" ToolTip="Windows asks for administrator approval; then Windows PowerShell creates Zenith's QoS policy for each Roblox client executable at this rate (replacing an earlier one) and reads it back." />
                  <Button x:Name="RemoveUploadLimitButton" Content="Remove" Command="{Binding RemoveUploadLimit}" IsEnabled="{Binding CanChangeUploadLimit}" MinHeight="36" Margin="0,0,8,8" ToolTip="Windows asks for administrator approval; then Windows PowerShell deletes Zenith's QoS policies and confirms they are gone." />
                  <Button Content="Cancel" Command="{Binding CancelUploadLimit}" IsEnabled="{Binding IsChangingUploadLimit}" MinHeight="36" Margin="0,0,8,8" ToolTip="Stops waiting. A run you already approved finishes on its own." />
                </WrapPanel>
                <TextBlock Text="{Binding CurrentUploadLimitText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                <TextBlock Text="{Binding UploadLimitStatus}" TextWrapping="Wrap" Margin="0,0,0,6" />
                <TextBlock Text="The limit is one shared ceiling for every matching client, not a share per client, and only for what the clients send; downloads are not limited. Reading Windows' policy list needs administrator rights, so Zenith shows its own record of what it applied in this Windows session and confirms each change by reading the policy back in the same administrator run. Zenith has not measured any effect on game play or on other programs." Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
              </StackPanel>
            </Expander>
            <Expander x:Name="ClientLayoutPreferences" Header="Layout preferences &amp; results" Margin="0,8,0,0">
              <StackPanel Margin="0,8,0,0">
                <WrapPanel><StackPanel Margin="0,0,12,8"><TextBlock Text="Columns · blank is auto" Style="{StaticResource Muted}" FontSize="12" /><TextBox x:Name="SessionsTileColumns" Text="{Binding TileColumns, UpdateSourceTrigger=PropertyChanged}" Width="150" MaxLength="4" HorizontalAlignment="Left" AutomationProperties.Name="Tile columns" /></StackPanel><StackPanel Margin="0,0,12,8"><TextBlock Text="Gap" Style="{StaticResource Muted}" FontSize="12" /><TextBox Text="{Binding TileGap, UpdateSourceTrigger=PropertyChanged}" Width="70" MaxLength="4" AutomationProperties.Name="Tile gap in logical pixels" /></StackPanel><StackPanel Margin="0,0,12,8"><TextBlock Text="Minimum width" Style="{StaticResource Muted}" FontSize="12" /><TextBox Text="{Binding TileMinimumWidth, UpdateSourceTrigger=PropertyChanged}" Width="120" MaxLength="5" AutomationProperties.Name="Minimum client width in logical pixels" /></StackPanel><StackPanel Margin="0,0,12,8"><TextBlock Text="Minimum height" Style="{StaticResource Muted}" FontSize="12" /><TextBox Text="{Binding TileMinimumHeight, UpdateSourceTrigger=PropertyChanged}" Width="120" MaxLength="5" AutomationProperties.Name="Minimum client height in logical pixels" /></StackPanel><Button Content="Save all settings" Command="{Binding SaveSettings}" VerticalAlignment="Bottom" Margin="0,0,0,8" /></WrapPanel>
