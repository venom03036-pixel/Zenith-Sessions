            </WrapPanel>
            <StackPanel><TextBlock Text="{local:Text GuideHeading_Diagnostics}" Style="{StaticResource PageTitle}" /><TextBlock Text="Manager events only. Account names, credentials and game links are never recorded." Style="{StaticResource Caption}" Margin="0,2,0,0" /></StackPanel>
          </DockPanel>
          <DockPanel Grid.Row="1" Margin="0,0,0,12">
