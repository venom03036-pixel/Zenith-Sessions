                    <TextBlock Text="{Binding HandoffSelectionSummary}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="Research step: opens this saved account's official game page so you can choose Play; Zenith inspects and cancels the request. No client starts." Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,12" ToolTip="Inspects only the cancelled request's structure. It does not prove native account selection. Use a game-only destination; exact server requests need separate validation. Incomplete checks may require signing in again." />
                    <WrapPanel><Button Content="Inspect and prevent launch" Command="{Binding InspectNativeHandoff}" IsEnabled="{Binding CanInspectNativeHandoff}" Margin="0,0,8,8" /><Button Content="Cancel inspection" Command="{Binding CancelAuthorization}" Visibility="{Binding IsAuthorizing, Converter={StaticResource VisibleIf}}" Margin="0,0,8,8" /></WrapPanel>
                    <TextBlock Text="{Binding HandoffInspectionStatus}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel></Border>
                  <Border Style="{StaticResource SurfaceCard}"><StackPanel>
                    <TextBlock Text="Launch evidence" Style="{StaticResource SectionHeading}" />
                    <TextBlock Text="Each request stays pinned while you pick other accounts or games. Reported values are never treated as verified." Style="{StaticResource Caption}" Margin="0,4,0,10" />
                    <TextBlock Text="No launch requests yet. A confirmed native test will appear here with its requested account, game and process observations." Style="{StaticResource Muted}" Margin="0,4,0,0" Visibility="{Binding HasLaunchEvidence, Converter={StaticResource HiddenIf}}" />
                    <ComboBox ItemsSource="{Binding LaunchEvidenceRows}" SelectedItem="{Binding SelectedLaunchEvidence}" DisplayMemberPath="Label" MinHeight="36" AutomationProperties.Name="Launch request to inspect" Visibility="{Binding HasLaunchEvidence, Converter={StaticResource VisibleIf}}" />
                    <Grid Margin="0,14,0,0" Visibility="{Binding HasLaunchEvidence, Converter={StaticResource VisibleIf}}">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="Requested" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="Expected player" Style="{StaticResource Caption}" Margin="0,10,0,2" /><TextBlock Text="{Binding SelectedLaunchEvidence.ExpectedPlayer}" TextWrapping="Wrap" />
                        <TextBlock Text="Place" Style="{StaticResource Caption}" Margin="0,10,0,2" /><TextBlock Text="{Binding SelectedLaunchEvidence.RequestedPlace}" TextWrapping="Wrap" />
                        <TextBlock Text="Server" Style="{StaticResource Caption}" Margin="0,10,0,2" /><TextBlock Text="{Binding SelectedLaunchEvidence.RequestedServer}" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="Reported · unverified" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="Player" Style="{StaticResource Caption}" Margin="0,10,0,2" /><TextBlock Text="{Binding SelectedLaunchEvidence.ReportedPlayer}" TextWrapping="Wrap" />
                        <TextBlock Text="Current place" Style="{StaticResource Caption}" Margin="0,10,0,2" /><TextBlock Text="{Binding SelectedLaunchEvidence.ReportedPlace}" TextWrapping="Wrap" />
                        <TextBlock Text="Current server" Style="{StaticResource Caption}" Margin="0,10,0,2" /><TextBlock Text="{Binding SelectedLaunchEvidence.ReportedServer}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding SelectedLaunchEvidence.ProcessSummary}" TextWrapping="Wrap" Margin="0,16,0,4" />
                    <TextBlock Text="{Binding SelectedLaunchEvidence.ObservationTime}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding SelectedLaunchEvidence.LaunchToLog}" TextWrapping="Wrap" Margin="0,8,0,0" ToolTip="Matches this launch to a client log by the browser tracker its request carried, even if the client restarted under a new PID. This never confirms the account or the arrival." />
                    <TextBlock Text="{Binding SelectedLaunchEvidence.Comparison}" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimary}" Margin="0,12,0,4" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedLaunchEvidence.Explanation}" Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" />
