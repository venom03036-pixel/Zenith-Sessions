              <TextBox x:Name="DiagnosticsFilterBox" Width="240" MaxLength="120" MinHeight="32" VerticalContentAlignment="Center" Text="{Binding DiagnosticFilter, UpdateSourceTrigger=PropertyChanged, Delay=150}" ToolTip="Filter by event, subsystem or error class · Ctrl+F" AutomationProperties.Name="Filter diagnostics" Margin="0,0,14,0" />
              <CheckBox Content="{Binding DiagnosticErrors}" IsChecked="{Binding ShowErrors}" VerticalAlignment="Center" Margin="0,0,14,0" />
              <CheckBox Content="{Binding DiagnosticWarnings}" IsChecked="{Binding ShowWarnings}" VerticalAlignment="Center" Margin="0,0,14,0" />
              <CheckBox Content="{Binding DiagnosticInformation}" IsChecked="{Binding ShowInformation}" VerticalAlignment="Center" Margin="0,0,14,0" />
            </WrapPanel>
          </DockPanel>
          <ListView Grid.Row="2" ItemsSource="{Binding DiagnosticRows}" BorderBrush="{DynamicResource BorderBrushLight}" Background="{DynamicResource CardBackground}" Foreground="{DynamicResource TextPrimary}" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Manager events">
            <ListView.View><GridView>
              <GridViewColumn Header="Time" Width="110"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Time}" Style="{StaticResource MonoText}" /></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
