                                        <ComboBoxItem Content="Continue with following action"/>
                                        <ComboBoxItem Content="Retry block"/>
                                        <ComboBoxItem Content="Jump to chosen action"/>
                                        <ComboBoxItem Content="Stop macro"/>
                                    </ComboBox>
                                    <TextBlock Text="If an ELSE branch has enabled actions, it runs first. A completed branch returns to its surrounding flow."
                                               FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBlock Text="When detection or the block fails" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                    <ComboBox SelectedIndex="{Binding ActionEditor.OnFailureRouteIndex}" Margin="0,0,0,8">
                                        <ComboBoxItem Content="Default — saved failure setting"/>
                                        <ComboBoxItem Content="Continue with following action"/>
                                        <ComboBoxItem Content="Retry block"/>
                                        <ComboBoxItem Content="Jump to chosen action"/>
                                        <ComboBoxItem Content="Stop macro"/>
                                    </ComboBox>
                                    <TextBlock Text="Jump destination (main action list)" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding ActionEditor.RouteTargets}" DisplayMemberPath="DisplayName" SelectedValuePath="StepId"
                                              SelectedValue="{Binding ActionEditor.RouteTargetStepId}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Extra retry attempts (0–20)" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ActionEditor.RouteRetryCount, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8"
                                             Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ControlBorder}" Padding="8,5"/>
                                    <TextBlock Text="Delay between retries (ms)" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ActionEditor.RouteRetryDelayMs, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8"
                                             Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ControlBorder}" Padding="8,5"/>
                                    <TextBlock Text="After retries, continue to the next conditional. If there is none in this block, return to its surrounding flow. Destinations keep their identity when actions are reordered."
                                               FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                </StackPanel>

                                <StackPanel Visibility="{Binding ActionEditor.ShowControlFlowFields, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding ActionEditor.BlockOutcomeSummary}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>
                                    <TextBlock Text="Key for new body actions" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ActionEditor.KeyName, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,6"
                                             Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ControlBorder}" Padding="8,5"/>
                                    <Button Command="{Binding ActionEditor.ArmCaptureKeyCommand}" Content="{Binding ActionEditor.CaptureKeyButtonText}"
                                            Style="{StaticResource PillButton}" Padding="10,6" Margin="0,0,0,12"/>
                                </StackPanel>

                                <StackPanel Visibility="{Binding ActionEditor.ShowIfFields, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Select a child action in the list to edit it. To add an existing action, place it immediately after this block and move it into THEN or ELSE."
                                               FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding ActionEditor.ThenSummary}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <WrapPanel Margin="0,0,0,10">
                                        <Button Content="+ Wait" Command="{Binding ActionEditor.AddThenWaitCommand}" Style="{StaticResource PillButton}" Padding="8,4" FontSize="12" Margin="0,0,4,4"/>
                                        <Button Content="+ Key" Command="{Binding ActionEditor.AddThenKeyCommand}" Style="{StaticResource PillButton}" Padding="8,4" FontSize="12" Margin="0,0,4,4"/>
                                        <Button Content="+ Click" Command="{Binding ActionEditor.AddThenClickCommand}" Style="{StaticResource PillButton}" Padding="8,4" FontSize="12" Margin="0,0,4,4"/>
                                        <Button Content="Move next into THEN" Command="{Binding ActionEditor.MoveNextIntoThenCommand}" Style="{StaticResource PillButton}" Padding="8,4" FontSize="12" Margin="0,0,4,4"/>
                                        <Button Content="Move last THEN out" Command="{Binding ActionEditor.RemoveLastThenCommand}" Style="{StaticResource PillButton}" Padding="8,4" FontSize="12" Margin="0,0,4,4"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding ActionEditor.ElseSummary}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <WrapPanel Margin="0,0,0,12">
                                        <Button Content="+ Wait" Command="{Binding ActionEditor.AddElseWaitCommand}" Style="{StaticResource PillButton}" Padding="8,4" FontSize="12" Margin="0,0,4,4"/>
                                        <Button Content="+ Key Press" Command="{Binding ActionEditor.AddElseKeyCommand}" Style="{StaticResource PillButton}" Padding="8,4" FontSize="12" Margin="0,0,4,4"/>
                                        <Button Content="Move next into ELSE" Command="{Binding ActionEditor.MoveNextIntoElseCommand}" Style="{StaticResource PillButton}" Padding="8,4" FontSize="12" Margin="0,0,4,4"/>
                                        <Button Content="Move last ELSE out" Command="{Binding ActionEditor.RemoveLastElseCommand}" Style="{StaticResource PillButton}" Padding="8,4" FontSize="12" Margin="0,0,4,4"/>
                                    </WrapPanel>
                                </StackPanel>

                                <StackPanel Visibility="{Binding ActionEditor.ShowWhileFields, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ActionEditor.LoopHelpText}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBlock Text="Maximum duration (ms)" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ActionEditor.TimeoutMs, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8"
                                             Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ControlBorder}" Padding="8,5"/>
                                    <TextBlock Text="Loop check every (ms)" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ActionEditor.LoopCheckIntervalMs, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8"
                                             Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ControlBorder}" Padding="8,5"/>
                                    <TextBlock Text="Minimum body delay (ms)" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ActionEditor.MinBodyDelayMs, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,8"
                                             Background="{DynamicResource AppBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource ControlBorder}" Padding="8,5"/>
                                    <TextBlock Text="{Binding ActionEditor.BodySummary}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                    <TextBlock Text="Select a child action in the list to edit it. To add an existing action, place it immediately after this block and move it into DO."
                                               FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>
                                    <WrapPanel Margin="0,0,0,12">
                                        <Button Content="+ Key Down" Command="{Binding ActionEditor.AddBodyKeyDownCommand}" Style="{StaticResource PillButton}" Padding="8,4" FontSize="12" Margin="0,0,4,4"/>
                                        <Button Content="+ Wait" Command="{Binding ActionEditor.AddBodyWaitCommand}" Style="{StaticResource PillButton}" Padding="8,4" FontSize="12" Margin="0,0,4,4"/>
                                        <Button Content="+ Key Up" Command="{Binding ActionEditor.AddBodyKeyUpCommand}" Style="{StaticResource PillButton}" Padding="8,4" FontSize="12" Margin="0,0,4,4"/>
                                        <Button Content="+ Key Press" Command="{Binding ActionEditor.AddBodyKeyPressCommand}" Style="{StaticResource PillButton}" Padding="8,4" FontSize="12" Margin="0,0,4,4"/>
                                        <Button Content="+ Break" Command="{Binding ActionEditor.AddBodyBreakCommand}" Style="{StaticResource PillButton}" Padding="8,4" FontSize="12" Margin="0,0,4,4"/>
                                        <Button Content="+ Continue" Command="{Binding ActionEditor.AddBodyContinueCommand}" Style="{StaticResource PillButton}" Padding="8,4" FontSize="12" Margin="0,0,4,4"/>
                                        <Button Content="Move next into DO" Command="{Binding ActionEditor.MoveNextIntoBodyCommand}" Style="{StaticResource PillButton}" Padding="8,4" FontSize="12" Margin="0,0,4,4"/>
                                        <Button Content="Move last DO out" Command="{Binding ActionEditor.RemoveLastBodyCommand}" Style="{StaticResource PillButton}" Padding="8,4" FontSize="12" Margin="0,0,4,4"/>
                                    </WrapPanel>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
                         <StackPanel>
                          <TextBlock Text="Unapplied changes" FontSize="12" Foreground="{DynamicResource AccentWarning}" Margin="0,0,0,6"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ActionEditor.HasDraftChanges}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                          <WrapPanel HorizontalAlignment="Right" Visibility="{Binding ActionEditor.HasSelection, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding CanEditMacro}">
                           <Button Content="Revert &amp; close" Command="{Binding ActionEditor.CancelCommand}" Style="{StaticResource EditorButton}" ToolTip="Discard this action's draft and close its properties. Applied actions remain saved."/>
                           <Button Content="Apply" Click="ActionEditorApply_Click" Command="{Binding ActionEditor.ApplyCommand}" Style="{StaticResource EditorPrimary}" ToolTip="Save these values into the selected action."/>
                          </WrapPanel>
                          <Button Content="Save macro" Command="{Binding SaveMacroCommand}" Style="{StaticResource EditorPrimary}" HorizontalAlignment="Right" Visibility="{Binding ShowMacroProperties, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding CanEditMacro}" ToolTip="Commit this macro and any open drafts"/>
                         </StackPanel>
                        </Border>
                    </Grid>
                </Border>

   </Grid>
   <Border Grid.Row="4" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,1,0,0" Padding="12,6"><WrapPanel>
    <TextBlock Text="{Binding TransportStateText}" ToolTip="{Binding RunProgressText}" FontWeight="SemiBold" Margin="0,0,16,0"/><TextBlock Text="{Binding TotalActionsCount, StringFormat={}{0} top-level actions}" FontSize="12" Margin="0,0,16,0" Foreground="{DynamicResource TextSecondary}"/>
    <TextBlock Text="{Binding RecordedDelaysText, StringFormat=Top-level delays: {0}}" FontSize="12" Margin="0,0,16,0" Foreground="{DynamicResource TextSecondary}"/>
    <TextBlock Text="{Binding TotalRunsCount, StringFormat=Completed runs: {0}}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
    <TextBlock Text="{Binding RecordingCheckpointText}" Visibility="{Binding IsRecordingBusy, Converter={StaticResource BoolToVis}}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="16,0,0,0" TextWrapping="Wrap"/>
   </WrapPanel></Border>
  </Grid>
 </Grid>
</UserControl>
