<UserControl x:Class="MacroSuite.App.Views.MacroEditorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:dd="urn:gong-wpf-dragdrop" xmlns:vm="clr-namespace:MacroSuite.App.ViewModels"
 Focusable="True" PreviewKeyDown="MacroEditorView_PreviewKeyDown">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  <Style x:Key="EditorButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
   <Setter Property="MinHeight" Value="36"/><Setter Property="MinWidth" Value="32"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,0,6,0"/>
  </Style>
  <vm:CompactActionLayoutConverter x:Key="CompactActionLayout"/>
  <Style x:Key="LibraryTab" TargetType="Button">
   <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="4,6"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"><ContentPresenter.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}"/><Setter Property="FontWeight" Value="SemiBold"/></Style></ContentPresenter.Resources></ContentPresenter></Border><Border x:Name="SelectedUnderline" Background="Transparent" Height="2" VerticalAlignment="Bottom"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBackground}"/></Trigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionForeground}"/><Setter TargetName="SelectedUnderline" Property="Background" Value="{DynamicResource SelectionBorder}"/></DataTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="EditorPrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
   <Setter Property="MinHeight" Value="36"/><Setter Property="MinWidth" Value="80"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="12,5"/><Setter Property="Margin" Value="0,0,6,0"/>
  </Style>
  <Style x:Key="EditorStop" TargetType="Button" BasedOn="{StaticResource DangerButton}">
   <Setter Property="MinHeight" Value="36"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,0,6,0"/>
  </Style>
  <Style x:Key="FlatEditorRow" TargetType="ListBoxItem"><EventSetter Event="PreviewMouseRightButtonDown" Handler="EditorRow_PreviewMouseRightButtonDown"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,5"/><Setter Property="MinHeight" Value="38"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Grid><Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><Border x:Name="SelectionRail" Width="3" HorizontalAlignment="Left" Background="Transparent"/><Border x:Name="FocusOutline" BorderThickness="1" BorderBrush="Transparent" IsHitTestVisible="False"/></Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="ItemsControl.AlternationIndex" Value="1"><Setter TargetName="Row" Property="Background" Value="{DynamicResource RowAlternateBackground}"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBackground}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter TargetName="SelectionRail" Property="Background" Value="{DynamicResource SelectionBorder}"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusOutline" Property="BorderBrush" Value="{DynamicResource BorderBrushFocus}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LibraryRow" TargetType="ListBoxItem" BasedOn="{StaticResource FlatEditorRow}"><Setter Property="MinHeight" Value="54"/></Style>
  <Style x:Key="BlockChevron" TargetType="Button" BasedOn="{StaticResource GhostButton}">
   <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="28"/><Setter Property="MinWidth" Value="24"/><Setter Property="FontSize" Value="15"/>
  </Style>
  <Style x:Key="ActionTypeIcon" TargetType="Path">
   <Setter Property="Stroke" Value="{DynamicResource ActionWait}"/><Setter Property="StrokeThickness" Value="1.8"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="Stretch" Value="Uniform"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding VisualCategory}" Value="Mouse"><Setter Property="Stroke" Value="{DynamicResource ActionMouse}"/></DataTrigger>
    <DataTrigger Binding="{Binding VisualCategory}" Value="Keyboard"><Setter Property="Stroke" Value="{DynamicResource ActionKeyboard}"/></DataTrigger>
    <DataTrigger Binding="{Binding VisualCategory}" Value="Flow"><Setter Property="Stroke" Value="{DynamicResource ActionFlow}"/></DataTrigger>
    <DataTrigger Binding="{Binding VisualCategory}" Value="Image"><Setter Property="Stroke" Value="{DynamicResource ActionImage}"/></DataTrigger>
    <DataTrigger Binding="{Binding VisualCategory}" Value="AI"><Setter Property="Stroke" Value="{DynamicResource ActionAI}"/></DataTrigger>
    <DataTrigger Binding="{Binding VisualCategory}" Value="Color"><Setter Property="Stroke" Value="{DynamicResource ActionColor}"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <DataTemplate x:Key="BindingRow">
   <DockPanel Margin="0,5" LastChildFill="True">
    <Button DockPanel.Dock="Right" Content="{Binding HotkeyDisplay}" Command="{Binding CaptureCommand}" CommandParameter="{Binding Id}" MinWidth="52" MinHeight="36" FontFamily="Consolas" Padding="6,3"/>
    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
   </DockPanel>
  </DataTemplate>
 </UserControl.Resources>
 <Grid Background="{DynamicResource WorkspaceMaterial}">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="LibraryColumn" Width="240" MinWidth="220" MaxWidth="360"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="{DynamicResource PanelMaterial}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,1,0">
   <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Margin="0,0,0,12" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource SurfaceBackground}"><Grid KeyboardNavigation.DirectionalNavigation="Cycle"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="Macros" Command="{Binding ShowScriptsTabCommand}" Style="{StaticResource LibraryTab}" Tag="{Binding IsScriptsTabVisible}"/><Button Grid.Column="1" Content="Shortcuts" Command="{Binding ShowHotkeysTabCommand}" Style="{StaticResource LibraryTab}" Tag="{Binding IsHotkeysTabVisible}"/><Button Grid.Column="2" Content="Log" Command="{Binding ShowLogTabCommand}" Style="{StaticResource LibraryTab}" Tag="{Binding IsLogTabVisible}"/><Border Grid.Column="1" Width="1" HorizontalAlignment="Left" Background="{DynamicResource ControlBorder}" IsHitTestVisible="False"/><Border Grid.Column="2" Width="1" HorizontalAlignment="Left" Background="{DynamicResource ControlBorder}" IsHitTestVisible="False"/></Grid></Border>
    <Grid Grid.Row="1" Margin="0,0,0,12" Visibility="{Binding IsScriptsTabVisible, Converter={StaticResource BoolToVis}}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
     <Button Grid.Column="2" ToolTip="{Binding SortOrderTooltip}" Command="{Binding ToggleSortOrderCommand}" Style="{StaticResource EditorButton}" Margin="0" Padding="0" AutomationProperties.Name="Change macro sort order"><Path Width="16" Height="16" Data="M 4,2 L 4,14 M 1,5 L 4,2 L 7,5 M 12,2 L 12,14 M 9,11 L 12,14 L 15,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
     <Grid><TextBox x:Name="MacroSearchBox" Text="{Binding ScriptSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search macros" AutomationProperties.Name="Search macros" MinHeight="36" Padding="33,6,8,6"/>
      <Path Data="M 6,1 A 5,5 0 1 1 5.999,1 M 10,10 L 15,15" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
      <TextBlock Text="Search macros" Foreground="{DynamicResource TextSecondary}" Margin="34,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=MacroSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid>
    </Grid>
    <ListBox Grid.Row="2" ItemsSource="{Binding MacroScripts}" SelectedItem="{Binding SelectedScript}" ItemContainerStyle="{StaticResource LibraryRow}" BorderThickness="0" Background="Transparent" Visibility="{Binding IsScriptsTabVisible, Converter={StaticResource BoolToVis}}" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
     <ListBox.ContextMenu><ContextMenu><MenuItem Header="Rename / properties" Command="{Binding ShowMacroPropertiesCommand}"/><MenuItem Header="Duplicate" Command="{Binding DuplicateMacroCommand}"/><MenuItem Header="Favorite" Command="{Binding FavoriteScriptCommand}"/><MenuItem Header="Enable / disable shortcut" Command="{Binding ToggleMacroStatusCommand}"/><MenuItem Header="Export…" Command="{Binding ExportMacroCommand}"/><Separator/><MenuItem Header="Delete macro" Command="{Binding DeleteMacroCommand}"/></ContextMenu></ListBox.ContextMenu>
     <ListBox.ItemTemplate><DataTemplate><Grid Margin="3,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Name}" Margin="0,0,8,3"/>
      <Border Grid.Column="1" Background="{DynamicResource KeyPillBackground}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="4" Padding="5,2" VerticalAlignment="Center"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Hotkey}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Hotkey}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/></Border>
      <StackPanel Grid.Row="1" Orientation="Horizontal"><Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource DisabledForeground}"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Fill" Value="{DynamicResource ActionFlow}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding ActionCount, StringFormat={}{0} actions}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/></StackPanel>
      <TextBlock Grid.Row="1" Grid.Column="1" Text="Running" Foreground="{DynamicResource AccentSuccess}" FontSize="12" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
     </Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsHotkeysTabVisible, Converter={StaticResource BoolToVis}}"><StackPanel>
     <TextBlock Text="Global shortcuts" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="Click a key to change it. Press Esc to cancel. Panic Stop may use Esc." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>
     <ItemsControl ItemsSource="{Binding AppKeybinds}" ItemTemplate="{StaticResource BindingRow}"/><TextBlock Text="Macros" FontWeight="SemiBold" Margin="0,16,0,8"/><ItemsControl ItemsSource="{Binding MacroKeybinds}" ItemTemplate="{StaticResource BindingRow}"/>
    </StackPanel></ScrollViewer>
    <ListBox Grid.Row="2" ItemsSource="{Binding ActivityLogs}" Visibility="{Binding IsLogTabVisible, Converter={StaticResource BoolToVis}}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,4"/></DataTemplate></ListBox.ItemTemplate></ListBox>
    <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0"><StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Command="{Binding NewMacroCommand}" Style="{StaticResource EditorButton}" Margin="0" Padding="3,5" IsEnabled="{Binding CanEditMacro}" AutomationProperties.Name="New macro"><StackPanel Orientation="Horizontal"><Path Data="M 6,0 L 6,12 M 0,6 L 12,6" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="New macro" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button><Button Grid.Column="2" Command="{Binding LoadMacroCommand}" Style="{StaticResource EditorButton}" Margin="0" Padding="3,5" IsEnabled="{Binding CanImportMacro}" AutomationProperties.Name="Import macro"><StackPanel Orientation="Horizontal"><Path Data="M 5,0 L 12,0 L 12,12 L 5,12 M 0,6 L 8,6 M 5,3 L 8,6 L 5,9" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Import…" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button></Grid>
     <Grid Margin="0,8,0,0" Visibility="{Binding HasDeletedMacro, Converter={StaticResource BoolToVis}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DeletedMacroNotice}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Undo" Command="{Binding UndoDeleteMacroCommand}" Style="{StaticResource EditorButton}" Margin="0" VerticalAlignment="Center"/></Grid>
    </StackPanel></Border>
   </Grid>
  </Border>
  <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" DragCompleted="LibrarySplitter_DragCompleted"/>
  <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="{DynamicResource HeaderMaterial}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="12,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding MacroName}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding MacroName}"/><WrapPanel Margin="0,2,0,0"><TextBlock Text="{Binding TotalActionsCount, StringFormat={}{0} actions}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0"/><TextBlock Text="{Binding CurrentHotkey}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0"/><TextBlock Text="{Binding SaveStateText}" FontSize="12" ToolTip="{Binding EditingAvailabilityText}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Style.Triggers><DataTrigger Binding="{Binding SaveStateText}" Value="Unapplied changes"><Setter Property="Foreground" Value="{DynamicResource AccentWarning}"/></DataTrigger><DataTrigger Binding="{Binding SaveStateText}" Value="Unsaved macro changes"><Setter Property="Foreground" Value="{DynamicResource AccentWarning}"/></DataTrigger><DataTrigger Binding="{Binding SaveStateText}" Value="Save failed"><Setter Property="Foreground" Value="{DynamicResource AccentDanger}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></WrapPanel></StackPanel>
    <WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button Content="{Binding MacroStatusButtonText}" Command="{Binding ToggleMacroStatusCommand}" ToolTip="Enable this macro and its global shortcut" Style="{StaticResource EditorButton}" IsEnabled="{Binding CanEditMacro}"/><Button Content="Properties" Command="{Binding ShowMacroPropertiesCommand}" Style="{StaticResource EditorButton}" ToolTip="Macro name, shortcut and repeat settings"/><Button Content="{Binding ToggleActionEditorLabel}" Command="{Binding ToggleActionEditorCommand}" Style="{StaticResource EditorButton}"/></WrapPanel>
   </Grid></Border>
   <Border Grid.Row="1" Background="{DynamicResource HeaderMaterial}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="12,6"><StackPanel>
    <WrapPanel><Button Content="{Binding PrimaryTransportText}" Command="{Binding PrimaryTransportCommand}" Style="{StaticResource EditorPrimary}"/>
     <Button Content="■ Stop" Command="{Binding StopCommand}" Style="{StaticResource EditorStop}" ToolTip="Stop the current macro or recording"/>
     <Button x:Name="RecordToggleButton" Command="{Binding RecordCommand}" Style="{StaticResource EditorButton}" AutomationProperties.Name="{Binding RecordingButtonText}"><StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="{DynamicResource AccentDanger}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="{Binding RecordingButtonText}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></StackPanel></Button>
     <Border Width="1" Height="22" Background="{DynamicResource ControlBorder}" Margin="5,0,10,0"/>
     <TextBlock Text="Speed" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBox Text="{Binding PlaybackSpeed, UpdateSourceTrigger=LostFocus, StringFormat=0.0}" Width="55" MinHeight="36" IsEnabled="{Binding CanEditMacro}" ToolTip="Playback speed multiplier"/><TextBlock Text="×" VerticalAlignment="Center" Margin="4,0,12,0"/>
     <CheckBox Content="Repeat" IsChecked="{Binding RepeatUntilStopped}" IsEnabled="{Binding CanEditMacro}" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Repeat until you stop the macro. Change the fixed repeat count in Macro properties."/>
     <CheckBox Content="Follow" IsChecked="{Binding FollowCurrentAction}" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Scroll to the current action during playback"/>
     <TextBlock Text="{Binding InputTargetText}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" FontSize="12"/>
    </WrapPanel>
    <TextBlock Text="{Binding LastExecutionError}" Visibility="{Binding HasExecutionError, Converter={StaticResource BoolToVis}}" Foreground="{DynamicResource AccentDanger}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
   </StackPanel></Border>
   <WrapPanel Grid.Row="2" Margin="12,6" ToolTip="{Binding DragDestinationText}">
    <Grid Width="145" Margin="0,0,4,0"><TextBox x:Name="ActionSearchBox" Text="{Binding ActionSearchText, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" KeyDown="ActionSearchBox_KeyDown" ToolTip="Find an action (Ctrl+F); press Enter for the next match" AutomationProperties.Name="Find action"/>
     <TextBlock Text="Find action…" Foreground="{DynamicResource TextSecondary}" Margin="9,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ActionSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
    <Button Content="↓" Command="{Binding FindNextActionCommand}" Style="{StaticResource EditorButton}" ToolTip="Next search match (Enter)" AutomationProperties.Name="Next search match"/>
    <Border Width="1" Height="22" Background="{DynamicResource ControlBorder}" Margin="2,0,8,0"/>
    <Button Click="AddMoreActionsButton_Click" Style="{StaticResource EditorButton}" IsEnabled="{Binding CanEditMacro}"><Button.Content><StackPanel Orientation="Horizontal"><TextBlock Text="+ Add action" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/><Path Width="16" Height="16" Margin="8,0,0,0" Data="M 3,6 L 8,11 L 13,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"/></StackPanel></Button.Content><Button.ContextMenu><ContextMenu>
     <MenuItem Header="Mouse click" Command="{Binding AddClickCommand}"/><MenuItem Header="Key press" Command="{Binding AddKeypressCommand}"/><MenuItem Header="Wait / delay" Command="{Binding AddDelayCommand}"/><Separator/>
     <MenuItem Header="Wait / repeat image" Command="{Binding AddImageCommand}"/><MenuItem Header="If condition" Command="{Binding AddIfCommand}"/><MenuItem Header="While condition" Command="{Binding AddWhileCommand}"/><MenuItem Header="Repeat until present" Command="{Binding AddRepeatUntilCommand}"/><MenuItem Header="Repeat until gone" Command="{Binding AddRepeatUntilGoneCommand}"/><MenuItem Header="Color condition" Command="{Binding AddColorConditionCommand}"/><MenuItem Header="Visual wait" Command="{Binding AddVisualWaitCommand}"/><MenuItem Header="AI vision instruction" Command="{Binding AddAIStepCommand}"/><MenuItem Header="Camera sweep" Command="{Binding InsertActionKindCommand}" CommandParameter="10"/><MenuItem Header="Camera path" Command="{Binding InsertActionKindCommand}" CommandParameter="11"/>
    </ContextMenu></Button.ContextMenu></Button>
    <Button Content="⧉" Command="{Binding DuplicateStepCommand}" Style="{StaticResource EditorButton}" ToolTip="Duplicate action or block (Ctrl+D)" AutomationProperties.Name="Duplicate selected action or block"/>
    <Button Content="×" Command="{Binding RemoveStepCommand}" Style="{StaticResource EditorButton}" ToolTip="Delete action or block (Delete)" AutomationProperties.Name="Delete selected action or block"/>
    <Border Width="1" Height="22" Background="{DynamicResource ControlBorder}" Margin="2,0,8,0"/>
    <Button Content="Undo" Command="{Binding UndoEditCommand}" Style="{StaticResource EditorButton}"/><Button Content="Redo" Command="{Binding RedoEditCommand}" Style="{StaticResource EditorButton}"/>
    <Button Content="Generate with AI" Command="{Binding DataContext.GenerateMacroWithAICommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource EditorButton}" ToolTip="Describe a macro, review the generated steps, then save it to your library"/>
   </WrapPanel>
   <Grid x:Name="ActionWorkspaceGrid" Grid.Row="3" SizeChanged="ActionWorkspaceGrid_SizeChanged"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="180"/><ColumnDefinition Width="5"/><ColumnDefinition x:Name="EditorColumn" Width="320"/></Grid.ColumnDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="{DynamicResource HeaderMaterial}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,1,0,1" Padding="8,5" ToolTip="{Binding DragDestinationText}"><Grid Margin="0,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><TextBlock Text="#" Foreground="{DynamicResource TextSecondary}" FontSize="12"/><TextBlock Grid.Column="1" Text="Action / parameters" Margin="52,0,0,0" Foreground="{DynamicResource TextSecondary}" FontSize="12"/><TextBlock Grid.Column="2" Text="Delay" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}" FontSize="12"/></Grid></Border>
     <ListBox Grid.Row="1" x:Name="ActionSequenceList" AlternationCount="2" ItemsSource="{Binding OutlineRows}" SelectedItem="{Binding SelectedStep}" ItemContainerStyle="{StaticResource FlatEditorRow}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1,1" ScrollViewer.IsDeferredScrollingEnabled="True" ScrollViewer.ScrollChanged="ActionSequenceList_ScrollChanged" dd:DragDrop.IsDragSource="True" dd:DragDrop.IsDropTarget="True" dd:DragDrop.DropHandler="{Binding}">
     <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ContextMenu><ContextMenu><MenuItem Header="Duplicate action / block" InputGestureText="Ctrl+D" Command="{Binding DuplicateStepCommand}"/><MenuItem Header="Delete action / block" InputGestureText="Del" Command="{Binding RemoveStepCommand}"/><Separator/><MenuItem Header="Move up in this scope" InputGestureText="Ctrl+Up" Command="{Binding MoveUpCommand}"/><MenuItem Header="Move down in this scope" InputGestureText="Ctrl+Down" Command="{Binding MoveDownCommand}"/><MenuItem Header="Move to start of scope" Command="{Binding MoveToTopCommand}"/><MenuItem Header="Move to end of scope" Command="{Binding MoveToBottomCommand}"/></ContextMenu></ListBox.ContextMenu>
     <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding StepIndex, StringFormat=00}" FontFamily="Consolas" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
      <Border Grid.Column="1" Margin="{Binding OutlineIndent}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1,0,0,0">
       <Grid Margin="2,0,6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button Command="{Binding DataContext.ToggleBlockCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}" Style="{StaticResource BlockChevron}" ToolTip="Expand or collapse this block" AutomationProperties.Name="Expand or collapse block"><Path Width="16" Height="16" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M 6,3 L 11,8 L 6,13"/><Style.Triggers><DataTrigger Binding="{Binding IsBlockExpanded}" Value="True"><Setter Property="Data" Value="M 3,6 L 8,11 L 13,6"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Button>
        <Grid Grid.Column="1" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="{Binding TypeLabel}"><Path Data="{Binding TypeIconData}" Style="{StaticResource ActionTypeIcon}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid>
