<UserControl x:Class="MacroSuite.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:coreAi="clr-namespace:MacroSuite.Core.AI;assembly=MacroSuite.Core"
             xmlns:themes="clr-namespace:MacroSuite.App.Themes"
             Background="{DynamicResource WorkspaceMaterial}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6,0,16"/>
        </Style>
        <Style x:Key="SettingsTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="12,10"/><Setter Property="MinWidth" Value="144"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentSky}"/><Setter TargetName="TabBorder" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextHighlight}"/><TextBlock Text="Preferences save automatically. Save settings also keeps your current theme edits. Use Save key to store a new credential." Style="{StaticResource Help}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="Open settings folder" Command="{Binding OpenSettingsFolderCommand}" Style="{StaticResource PillButton}" Margin="12,0,8,0"/><Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel></Grid>
        <TextBlock Grid.Row="1" Text="{Binding PersistenceStatus}" TextWrapping="Wrap" Margin="0,0,0,8"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/><Style.Triggers><DataTrigger Binding="{Binding HasSettingsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentDanger}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <TabControl Grid.Row="2" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SettingsTab}">
            <TabItem Header="General"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,0,12,16" MaxWidth="680" HorizontalAlignment="Left">
                <TextBlock Text="General" Style="{StaticResource Label}" FontSize="16"/>
                <CheckBox Content="Keep Zenith Macros on top" IsChecked="{Binding AlwaysOnTop}"/>
                <TextBlock Text="Keep the window visible above other applications." Style="{StaticResource Help}"/>
                <TextBlock Text="Mini toolbar" Style="{StaticResource Label}"/>
                <TextBlock Text="Use a compact floating toolbar for playback and recording. Open the editor from the toolbar to return." Style="{StaticResource Help}"/>
                <Button Content="Open Mini toolbar" Command="{Binding SwitchToMiniModeCommand}" Style="{StaticResource PillButton}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                <CheckBox Content="Click through Mini toolbar" IsChecked="{Binding MiniToolbarClickThrough}"/>
                <TextBlock Text="Clicks pass to the application behind the toolbar. Use your click-through shortcut or Zenith's tray menu to turn interaction back on. Keyboard shortcuts and Panic stop remain available." Style="{StaticResource Help}"/>
                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Click-through shortcut" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" Margin="0,0,16,0"/>
                    <Button Grid.Column="1" Content="{Binding MiniToolbarClickThroughHotkeyDisplay}" Command="{Binding BeginHotkeyCaptureCommand}" CommandParameter="mini-click-through" Style="{StaticResource PillButton}" FontFamily="Consolas" AutomationProperties.Name="Change mini toolbar click-through shortcut"/>
                </Grid>
                <TextBlock Text="Press this shortcut to toggle click-through while the mini toolbar is visible. Click its binding to choose any key or key combination. This does not change screenshot hiding." Style="{StaticResource Help}"/>
                <CheckBox Content="Hide Mini toolbar from screenshots" IsChecked="{Binding MiniToolbarHideFromCapture}"/>
                <TextBlock Text="Exclude only the Mini toolbar from supported Windows screenshots and screen recordings. Off by default. Unsupported capture tools may still include it." Style="{StaticResource Help}"/>
                <TextBlock Text="Editor panes" Style="{StaticResource Label}"/>
                <CheckBox Content="Show properties inspector" IsChecked="{Binding ShowActionEditor}" Margin="0,0,0,8"/>
                <CheckBox Content="Fit inspector width to the available space" IsChecked="{Binding AutoSizeActionEditor}"/>
                <TextBlock Text="Drag the library or inspector divider in the editor to resize it. Widths are remembered." Style="{StaticResource Help}"/>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Appearance"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,0,12,16" MaxWidth="680" HorizontalAlignment="Left">
                <TextBlock Text="Appearance" Style="{StaticResource Label}" FontSize="16"/>
                <TextBlock Text="Choose a starting theme. Colors update immediately and are remembered for your next launch." Style="{StaticResource Help}"/>
                <TextBlock Text="Logo color" Style="{StaticResource Label}"/><ComboBox SelectedIndex="{Binding LogoColorModeIndex}" AutomationProperties.Name="Logo color" Margin="0,0,0,12"><ComboBoxItem Content="Follow theme"/><ComboBoxItem Content="Original teal"/></ComboBox><TextBlock Text="The running app, tray and Mini toolbar follow this choice. The installed desktop icon keeps the teal artwork." Style="{StaticResource Help}"/>
                <TextBlock Text="Theme" Style="{StaticResource Label}"/>
                <ListBox ItemsSource="{Binding ThemePresets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                         AutomationProperties.Name="Theme" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,10,10"/><Setter Property="Padding" Value="0"/>
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ThemeTile" BorderThickness="2" CornerRadius="6" BorderBrush="{DynamicResource ControlBorder}" Padding="3"><ContentPresenter/></Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="ThemeTile" Property="BorderBrush" Value="{DynamicResource SelectionBorder}"/></Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ThemeTile" Property="BorderBrush" Value="{DynamicResource BorderBrushFocus}"/><Setter TargetName="ThemeTile" Property="BorderThickness" Value="3"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></Setter.Value></Setter>
                    </Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate>
                        <Border Background="{Binding PreviewBackground}" CornerRadius="3" Padding="12" Width="174">
                            <StackPanel><TextBlock Text="{Binding Name}" Foreground="{Binding PreviewForeground}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <Border Background="{Binding PreviewAccent}" CornerRadius="3" Height="7" HorizontalAlignment="Left" Width="66"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding SelectedTheme.Description}" Style="{StaticResource Help}"/>
                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Theme preview" Style="{StaticResource Label}"/>
                        <TextBlock Text="Text, controls, focus rings, and selections use coordinated colors." Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <WrapPanel><Button Content="Primary action" Style="{StaticResource PrimaryButton}" IsHitTestVisible="False" Focusable="False" Margin="0,0,8,8"/>
                            <Button Content="Secondary action" Style="{StaticResource PillButton}" IsHitTestVisible="False" Focusable="False" Margin="0,0,0,8"/></WrapPanel>
                        <Border Background="{DynamicResource SelectionBackground}" BorderBrush="{DynamicResource SelectionBorder}" BorderThickness="3,0,0,0" Padding="10,8" Margin="0,4,0,0"><TextBlock Text="Selected action" Foreground="{DynamicResource SelectionForeground}"/></Border>
                    </StackPanel>
                </Border>
                <StackPanel x:Name="CustomAppearanceEditor" DataContext="{Binding Appearance}">
                    <TextBlock Text="Custom themes" Style="{StaticResource Label}" FontSize="16"/>
                    <TextBlock Text="Customize a starting theme, then save it with a name. Preview changes are immediate; Save theme keeps your edits." Style="{StaticResource Help}"/>
                    <ComboBox ItemsSource="{Binding CustomThemes}" SelectedItem="{Binding SelectedCustomTheme}" DisplayMemberPath="Name" AutomationProperties.Name="Saved custom themes" Margin="0,0,0,12"/>
                    <TextBlock Text="Theme name" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding ThemeName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Custom theme name" MaxLength="80" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Content="Save theme" Command="{Binding SaveThemeCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                        <Button Content="Save as new" Command="{Binding SaveAsThemeCommand}" Style="{StaticResource PillButton}" Margin="0,0,8,8"/>
                        <Button Content="Rename" Command="{Binding RenameThemeCommand}" Style="{StaticResource PillButton}" Margin="0,0,8,8"/>
                        <Button Content="Duplicate" Command="{Binding DuplicateThemeCommand}" Style="{StaticResource PillButton}" Margin="0,0,8,8"/>
                        <Button Content="Delete" Command="{Binding DeleteThemeCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
                        <Button Content="Revert edits" Command="{Binding RevertThemeCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,8"/>
                        <Button Content="Reset to base" Command="{Binding ResetThemeCommand}" Style="{StaticResource GhostButton}" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Help}" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="Preparing background…" Style="{StaticResource Help}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="Background" Style="{StaticResource Label}" FontSize="16"/>
                    <ComboBox ItemsSource="{Binding BackgroundKinds}" SelectedIndex="{Binding BackgroundKindIndex}" AutomationProperties.Name="Background style" Margin="0,0,0,12"/>
                    <WrapPanel><Button Content="Choose image or GIF…" Command="{Binding ImportBackgroundCommand}" Style="{StaticResource PillButton}" Margin="0,0,8,8"/><Button Content="Remove image" Command="{Binding RemoveBackgroundCommand}" Style="{StaticResource GhostButton}" Margin="0,0,0,8"/></WrapPanel>
                    <TextBlock Text="Images are copied into your local theme library. PNG, JPEG, BMP and GIF are supported up to 25 MB; still images up to 16 megapixels, GIFs up to 4 megapixels and 300 frames within a bounded animation budget." Style="{StaticResource Help}"/>
                    <CheckBox Content="Build colors from the image" IsChecked="{Binding ColorsFromImage}" Margin="0,0,0,8"/>
                    <CheckBox Content="Animate GIF background" IsChecked="{Binding AnimateBackground}"/>
                    <TextBlock Text="{Binding EffectsStatus}" Style="{StaticResource Help}"/>
                    <TextBlock Text="Panel opacity" Style="{StaticResource Label}"/>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><Slider Minimum="0" Maximum="100" Value="{Binding PanelOpacityPercent}" AutomationProperties.Name="Panel opacity"/><TextBlock Grid.Column="1" Text="{Binding PanelOpacityPercent, StringFormat={}{0:0}%}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
                    <TextBlock Text="Image blur" Style="{StaticResource Label}"/>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><Slider Minimum="0" Maximum="24" Value="{Binding BlurRadius}" AutomationProperties.Name="Image background blur"/><TextBlock Grid.Column="1" Text="{Binding BlurRadius, StringFormat={}{0:0}}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
                    <TextBlock Text="Image darkening" Style="{StaticResource Label}"/>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions><Slider Minimum="0" Maximum="100" Value="{Binding BackgroundDimPercent}" AutomationProperties.Name="Image darkening"/><TextBlock Grid.Column="1" Text="{Binding BackgroundDimPercent, StringFormat={}{0:0}%}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
                    <TextBlock Text="Blur affects the background only, so text stays crisp. Windows controls desktop acrylic blur on Windows 11 22H2 or later; other systems use solid colors. Low resource availability reduces effects automatically." Style="{StaticResource Help}"/>
                    <TextBlock Text="Colors" Style="{StaticResource Label}" FontSize="16"/>
                    <CheckBox Content="Choose readable text automatically" IsChecked="{Binding AutomaticText}" Margin="0,0,0,12"/>
                    <TextBlock Text="Color to edit" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding ColorRoles}" SelectedItem="{Binding SelectedColorRole}" AutomationProperties.Name="Theme color role" Margin="0,0,0,12"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><themes:ColorWheel x:Name="AppearanceColorWheel" Width="192" Height="192" HexColor="{Binding SelectedColorHex, Mode=TwoWay}" AutomationProperties.Name="Color hue and saturation; arrow keys adjust"/><TextBlock Text="Brightness" Style="{StaticResource Label}" Margin="0,12,0,8"/><Slider Minimum="0" Maximum="1" Value="{Binding Brightness, ElementName=AppearanceColorWheel, Mode=TwoWay}" AutomationProperties.Name="Color brightness"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Hex color" Style="{StaticResource Label}"/><TextBox Text="{Binding SelectedColorHex, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Hex color" MaxLength="7" Margin="0,0,0,12"/><TextBlock Text="RGB (0–255)" Style="{StaticResource Label}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox Text="{Binding ColorR, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Red color value"/><TextBox Grid.Column="2" Text="{Binding ColorG, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Green color value"/><TextBox Grid.Column="4" Text="{Binding ColorB, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Blue color value"/></Grid>
                            <TextBlock Text="Editing a color turns off colors from image. Text and panels may be adjusted to preserve contrast." Style="{StaticResource Help}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Suggested image colors" Style="{StaticResource Label}" Margin="0,16,0,8"/>
                    <ItemsControl ItemsSource="{Binding SuggestedColors}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="42" Height="36" Background="{Binding}" Command="{Binding DataContext.ApplySwatchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{Binding}" AutomationProperties.Name="{Binding}" Margin="0,0,8,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Text="{Binding ContrastNotice}" Style="{StaticResource Help}"/>
                </StackPanel>
                <TextBlock Text="Status and action-type colors keep their meaning in every theme. Midnight keeps the very dark appearance; Amber Night adds yellow-orange controls on black." Style="{StaticResource Help}"/>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Recording"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,0,12,16" MaxWidth="680" HorizontalAlignment="Left">
                <TextBlock Text="Recording" Style="{StaticResource Label}" FontSize="16"/>
                <CheckBox Content="Switch to Mini toolbar while recording" IsChecked="{Binding MiniModeWhileRecording}"/>
                <TextBlock Text="Applies the next time you start a recording." Style="{StaticResource Help}"/>
                <CheckBox Content="Record raw mouse movement" IsChecked="{Binding UseRawMouseRecording}"/>
                <TextBlock Text="Use for games with a locked camera. Leave off for ordinary desktop recording." Style="{StaticResource Help}"/>
                <TextBlock Text="Camera path defaults" Style="{StaticResource Label}"/>
                <TextBlock Text="Used for new recordings and new Camera Path actions. Existing paths keep their saved settings." Style="{StaticResource Help}"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Horizontal gain (0.25–10)" Style="{StaticResource Label}"/><TextBox Text="{Binding CameraLookGainX, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Horizontal camera gain"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Vertical gain (0.25–10)" Style="{StaticResource Label}"/><TextBox Text="{Binding CameraLookGainY, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Vertical camera gain"/></StackPanel>
                </Grid>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Playback"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,0,12,16" MaxWidth="680" HorizontalAlignment="Left">
                <TextBlock Text="Playback" Style="{StaticResource Label}" FontSize="16"/>
                <TextBlock Text="Speed and repeat are set for each macro in the editor. Input goes to the active window unless an action selects a target." Style="{StaticResource Help}"/>
                <TextBlock Text="New Camera Path actions" Style="{StaticResource Label}"/>
                <TextBlock Text="These defaults do not change paths already in a macro." Style="{StaticResource Help}"/>
                <TextBlock Text="Playback rate" Style="{StaticResource Label}"/>
                <ComboBox SelectedIndex="{Binding CameraHzIndex}" AutomationProperties.Name="Camera path playback rate" Margin="0,0,0,16"><ComboBoxItem Content="60 Hz"/><ComboBoxItem Content="125 Hz"/><ComboBoxItem Content="250 Hz"/></ComboBox>
                <TextBlock Text="Playback mode" Style="{StaticResource Label}"/>
                <ComboBox SelectedIndex="{Binding CameraModeIndex}" AutomationProperties.Name="Camera path playback mode"><ComboBoxItem Content="Reconstructed (smooth)"/><ComboBoxItem Content="Packet reference (raw)"/></ComboBox>
                <TextBlock Text="Reconstructed smooths the recorded path. Packet reference replays the recorded packets for comparison." Style="{StaticResource Help}"/>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Shortcuts"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,0,12,16" MaxWidth="680" HorizontalAlignment="Left">
                <Button Content="Reset transport shortcuts to F6 / F8 / F4 / F5" Command="{Binding ResetTransportDefaultsCommand}" HorizontalAlignment="Left" Margin="0,8,0,8"/>
                <TextBlock Text="{Binding ShortcutAvailability}" Style="{StaticResource Help}" Margin="0,0,0,12"/>
                <TextBlock Text="Global shortcuts" Style="{StaticResource Label}" FontSize="16"/>
                <TextBlock Text="Work even when another app is focused. Click a binding and press a key or combination. Conflicts are checked before assigning it." Style="{StaticResource Help}"/>
                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Record" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" Margin="0,8,24,8"/><Button Grid.Column="1" Content="{Binding RecordHotkeyDisplay}" Command="{Binding BeginHotkeyCaptureCommand}" CommandParameter="record" Style="{StaticResource PillButton}" FontFamily="Consolas" Margin="0,4"/>
                    <TextBlock Grid.Row="1" Text="Stop" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" Margin="0,8,24,8"/><Button Grid.Row="1" Grid.Column="1" Content="{Binding StopHotkeyDisplay}" Command="{Binding BeginHotkeyCaptureCommand}" CommandParameter="stop" Style="{StaticResource PillButton}" FontFamily="Consolas" Margin="0,4"/>
                    <TextBlock Grid.Row="2" Text="Run" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" Margin="0,8,24,8"/><Button Grid.Row="2" Grid.Column="1" Content="{Binding PlayHotkeyDisplay}" Command="{Binding BeginHotkeyCaptureCommand}" CommandParameter="play" Style="{StaticResource PillButton}" FontFamily="Consolas" Margin="0,4"/>
                    <TextBlock Grid.Row="3" Text="Pause / resume" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" Margin="0,8,24,8"/><Button Grid.Row="3" Grid.Column="1" Content="{Binding PauseHotkeyDisplay}" Command="{Binding BeginHotkeyCaptureCommand}" CommandParameter="pause" Style="{StaticResource PillButton}" FontFamily="Consolas" Margin="0,4"/>
                    <TextBlock Grid.Row="4" Text="Panic Stop — all input" VerticalAlignment="Center" Foreground="{DynamicResource AccentDanger}" Margin="0,8,24,8"/><Button Grid.Row="4" Grid.Column="1" Content="{Binding PanicHotkeyDisplay}" Command="{Binding BeginHotkeyCaptureCommand}" CommandParameter="panic" Style="{StaticResource PillButton}" FontFamily="Consolas" Margin="0,4"/>
                    <TextBlock Grid.Row="5" Text="Mini toolbar click-through" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" Margin="0,8,24,8"/><Button Grid.Row="5" Grid.Column="1" Content="{Binding MiniToolbarClickThroughHotkeyDisplay}" Command="{Binding BeginHotkeyCaptureCommand}" CommandParameter="mini-click-through" Style="{StaticResource PillButton}" FontFamily="Consolas" Margin="0,4"/>
                </Grid>
                <TextBlock Text="Click the binding again to cancel. Esc also cancels ordinary shortcut capture; when assigning Panic Stop, Esc assigns Escape. Macro shortcuts are in the editor, and Auto Clicker has its own shortcut." Style="{StaticResource Help}"/>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Detection &amp; AI"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,0,12,16" MaxWidth="680" HorizontalAlignment="Left">
                <TextBlock Text="Detection &amp; AI" Style="{StaticResource Label}" FontSize="16"/>
                <TextBlock Text="AI is optional. Your provider may charge for requests made with your API key. Local recording, playback, and detection work without an AI connection." Style="{StaticResource Help}"/>
                <Button Content="Generate macro with AI" Command="{Binding DataContext.GenerateMacroWithAICommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,0,0,16"/><TextBlock Text="Provider" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding AvailableProviders}" SelectedItem="{Binding SelectedProvider}" AutomationProperties.Name="AI provider" Margin="0,0,0,16"/>
                <TextBlock Text="Default model" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel}" AutomationProperties.Name="Default AI model" Margin="0,0,0,16"/>
                <TextBlock Text="{Binding CredentialStatus}" Style="{StaticResource Help}"/>
                <TextBlock Text="New or replacement API key" Style="{StaticResource Label}"/><PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged" AutomationProperties.Name="New AI API key" Padding="8,6" MinHeight="36" Background="{DynamicResource SurfaceBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource BorderBrushLight}"/>
                <TextBlock Text="Stored encrypted for this Windows user. A new key is saved only when you choose Save key." Style="{StaticResource Help}"/>
                <WrapPanel><Button Content="Save key" Style="{StaticResource PrimaryButton}" Command="{Binding SaveKeyCommand}" Margin="0,0,8,8"/><Button Content="Test connection" Style="{StaticResource PillButton}" Command="{Binding TestKeyCommand}" Margin="0,0,8,8"/><Button Content="Remove key" Style="{StaticResource GhostButton}" Command="{Binding RemoveKeyCommand}" Margin="0,0,0,8"/></WrapPanel>
                <TextBlock Text="{Binding TestStatusMessage}" Style="{StaticResource Help}"/><TextBlock Text="{Binding TestLatencyText}" Style="{StaticResource Help}"/>
                <Expander Header="AI action approval" Foreground="{DynamicResource TextPrimary}" Margin="0,8,0,16"><StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Applies to AI actions during playback. Generated macros are reviewed before adding them to your library." Style="{StaticResource Help}"/>
                    <ComboBox SelectedItem="{Binding SelectedPolicy}" AutomationProperties.Name="AI action approval policy"><ComboBox.ItemsSource><x:Array Type="{x:Type coreAi:ApprovalPolicy}"><coreAi:ApprovalPolicy>ManualApproval</coreAi:ApprovalPolicy><coreAi:ApprovalPolicy>AutoApprove</coreAi:ApprovalPolicy><coreAi:ApprovalPolicy>AutoReject</coreAi:ApprovalPolicy></x:Array></ComboBox.ItemsSource></ComboBox>
                    <CheckBox Content="Allow autonomous AI actions" IsChecked="{Binding AutonomousModeActive}" Margin="0,12,0,0"/><TextBlock Text="Required for AutoApprove. Actions can execute without individual confirmation." Style="{StaticResource Help}"/>
                    <TextBlock Text="Approval timeout (8–60 seconds)" Style="{StaticResource Label}"/><TextBox Text="{Binding ApprovalTimeoutSeconds, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="AI approval timeout" Margin="0,0,0,16"/>
                    <TextBlock Text="Maximum AI text length" Style="{StaticResource Label}"/><TextBox Text="{Binding MaxAiTextLength, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Maximum AI text length" Margin="0,0,0,16"/>
                    <TextBlock Text="Minimum confidence (0–1)" Style="{StaticResource Label}"/><TextBox Text="{Binding MinAiConfidence, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Minimum AI confidence"/>
                </StackPanel></Expander>
                <CheckBox Content="Keep image scanning near the 3% resource target" IsChecked="{Binding ImageScanBudgetEnabled}"/><TextBlock Text="Adjusts detection cadence and reduces theme effects when needed. This is a soft operating target, not a hard CPU or GPU cap." Style="{StaticResource Help}"/>
                <TextBlock Text="Capture frequency" Style="{StaticResource Label}"/><WrapPanel><TextBox Width="90" Text="{Binding TargetFpsInputText, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Capture frames per second"/><TextBlock Text="frames/s" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0"/></WrapPanel>
                <TextBlock Text="Lower frequencies reduce capture work. Choose a search area on image and color actions to limit the pixels checked." Style="{StaticResource Help}"/>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Advanced"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,0,12,16" MaxWidth="680" HorizontalAlignment="Left">
                <TextBlock Text="Advanced" Style="{StaticResource Label}" FontSize="16"/>
                <CheckBox Content="Allow fallback screen capture" IsChecked="{Binding AllowGdiFallback}"/><TextBlock Text="Try GDI capture when the normal capture path returns blank or protected frames." Style="{StaticResource Help}"/>
                <TextBlock Text="Input backend" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding InputBackendOptions}" SelectedIndex="{Binding PreferredInputBackendIndex}" AutomationProperties.Name="Input backend"/><TextBlock Text="{Binding InputBackendStatus}" Style="{StaticResource Help}"/>
                <CheckBox Content="Detailed execution trace" IsChecked="{Binding DetailedExecutionTrace}"/><TextBlock Text="Add per-action and detection details to the activity log." Style="{StaticResource Help}"/>
                <CheckBox Content="Detection overlay" IsChecked="{Binding ShowDetectionOverlay}"/><TextBlock Text="Show the search rectangle and best match while detecting. The overlay does not capture the screen or send input." Style="{StaticResource Help}"/>
            </StackPanel></ScrollViewer></TabItem>
        </TabControl>
    </Grid>
</UserControl>

