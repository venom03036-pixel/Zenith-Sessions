<Window x:Class="MacroSuite.App.Overlays.MacroPermissionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Macro Permissions"
        Width="500" Height="Auto" MinWidth="440" MinHeight="320"
        SizeToContent="Height"
        Background="{DynamicResource AppBackground}" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Window.Resources>
        <!-- Outer card border -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Permission row label -->
        <Style x:Key="PermLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Violation row label -->
        <Style x:Key="ViolLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentWarning}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Section header -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Approve button -->
        <Style x:Key="ApproveButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="24,10"/>
        </Style>

        <!-- Cancel button -->
        <Style x:Key="CancelButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="24,10"/>
        </Style>
    </Window.Resources>

    <!-- Drag-to-move support -->
    <Border Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Title bar -->
                <RowDefinition Height="Auto"/>  <!-- Macro info card -->
                <RowDefinition Height="Auto"/>  <!-- Permissions card -->
                <RowDefinition Height="Auto"/>  <!-- Violations card (conditional) -->
                <RowDefinition Height="Auto"/>  <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- ── Title bar ─────────────────────────────────────────────── -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛡" FontSize="18" Margin="0,0,8,0"/>
                    <TextBlock Text="Macro Permission Review"
                               Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕"
                        Foreground="{DynamicResource TextMuted}" Background="Transparent" BorderThickness="0"
                        FontSize="16" Cursor="Hand" Padding="4"
                        Click="CloseButton_Click"/>
            </Grid>

            <!-- ── Macro info card ───────────────────────────────────────── -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="MACRO DETAILS" Style="{StaticResource SectionHeader}"/>
                    <TextBlock x:Name="MacroNameText"
                               Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="SemiBold"
                               Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBlock x:Name="MacroIdText"
                               Foreground="{DynamicResource TextMuted}" FontSize="11"
                               FontFamily="Cascadia Code, Consolas, Courier New"/>
                </StackPanel>
            </Border>

            <!-- ── Permissions card ──────────────────────────────────────── -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="THIS MACRO WILL" Style="{StaticResource SectionHeader}"/>
                    <ItemsControl x:Name="PermissionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource PermLabel}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ── Violations card (only shown if violations exist) ──────── -->
            <Border Grid.Row="3" x:Name="ViolationsCard"
                    Style="{StaticResource Card}"
                    BorderBrush="{DynamicResource AccentWarning}" Background="{DynamicResource BadgeBgWarning}"
                    Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="⚠" Foreground="{DynamicResource AccentWarning}" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="SECURITY WARNINGS" Style="{StaticResource SectionHeader}"
                                   Foreground="{DynamicResource AccentWarning}" Margin="0"/>
                    </StackPanel>
                    <ItemsControl x:Name="ViolationsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource ViolLabel}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ── Action buttons ────────────────────────────────────────── -->
            <Grid Grid.Row="4" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="CancelBtn"
                        Content="Cancel" Style="{StaticResource CancelButton}"
                        Click="Cancel_Click"/>
                <Button Grid.Column="2" x:Name="ApproveBtn"
                        Content="✓  Approve &amp; Run" Style="{StaticResource ApproveButton}"
                        Click="Approve_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
