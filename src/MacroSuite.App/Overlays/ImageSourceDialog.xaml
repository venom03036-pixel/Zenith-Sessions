<Window x:Class="MacroSuite.App.Overlays.ImageSourceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insert Image / Photo"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="OnDialogKeyDown"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="ImageChoiceCardButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentMint}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ActiveBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource BorderBrushDark}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="24"
            Width="440">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <!-- Header -->
            <DockPanel Margin="0,0,0,16" LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="🖼️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Insert Template Image"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="{DynamicResource TextHighlight}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✖"
                        DockPanel.Dock="Right"
                        Style="{StaticResource GhostButton}"
                        Padding="6,2"
                        FontSize="11"
                        Click="OnCancelClick"/>
            </DockPanel>

            <TextBlock Text="Select how you would like to provide the template image for OpenCV visual pattern matching:"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,18"/>

            <!-- Option 1: Browse File -->
            <Button Style="{StaticResource ImageChoiceCardButton}"
                    Margin="0,0,0,10"
                    Padding="14,12"
                    Click="OnBrowseFileClick"
                    HorizontalContentAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="{DynamicResource KeyPillBackground}" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="📁" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Browse Photo / Image File" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextHighlight}"/>
                        <TextBlock Text="Select a PNG, JPG, or BMP image file saved on your computer." FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Option 2: Snip from Screen -->
            <Button Style="{StaticResource ImageChoiceCardButton}"
                    Margin="0,0,0,18"
                    Padding="14,12"
                    Click="OnSnipScreenClick"
                    HorizontalContentAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="{DynamicResource SelectionBackground}" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="✂️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Snip Photo from Screen (Hotkey: F10)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentMint}"/>
                        <TextBlock Text="Draw a box around any button, icon, or element on your screen to capture." FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Match Options -->
            <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="6" Padding="12,10" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Match Confidence Threshold:" FontSize="11" Foreground="{DynamicResource TextSecondary}" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="ConfidenceLabel" Text="80%" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentMint}" DockPanel.Dock="Right"/>
                    </DockPanel>
                    <Slider x:Name="ConfidenceSlider"
                            Minimum="0.5"
                            Maximum="0.99"
                            Value="0.80"
                            SmallChange="0.05"
                            LargeChange="0.1"
                            ValueChanged="OnConfidenceChanged"
                            Margin="0,0,0,8"/>
                    <CheckBox x:Name="AutoClickCheckBox"
                              Content="Click the image location once it appears on screen"
                              IsChecked="True"
                              Foreground="{DynamicResource TextSecondary}"
                              FontSize="11"/>
                </StackPanel>
            </Border>

            <!-- Footer Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource PillButton}"
                        Padding="14,6"
                        FontSize="11"
                        Click="OnCancelClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
