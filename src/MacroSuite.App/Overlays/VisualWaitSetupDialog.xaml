<Window x:Class="MacroSuite.App.Overlays.VisualWaitSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wait for Visual Match"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource CardBackground}"
        Foreground="{DynamicResource TextPrimary}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        BorderBrush="{DynamicResource BorderBrushDark}"
        BorderThickness="1"
        PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel>
        <Border Background="{DynamicResource HeaderBackground}" Padding="14,10" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Width="28" Height="24" Click="OnCloseClick" Style="{StaticResource PillButton}" Padding="0" FontSize="11"/>
                <TextBlock Text="WAIT FOR VISUAL MATCH" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentMint}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <StackPanel Margin="18">
        <TextBlock Text="WAIT FOR VISUAL MATCH" FontWeight="Bold" FontSize="13" Margin="0,0,0,12"/>

        <TextBlock Text="Matching type" FontSize="11" Opacity="0.7" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="ModePixel" Content="Exact pixel" IsChecked="True" Margin="0,0,14,0"/>
            <RadioButton x:Name="ModeNeighborhood" Content="Neighborhood" Margin="0,0,14,0"/>
            <RadioButton x:Name="ModeRegion" Content="Image region"/>
        </StackPanel>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Search" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                <ComboBox x:Name="SearchModeBox" SelectedIndex="0">
                    <ComboBoxItem Content="Fixed location"/>
                    <ComboBoxItem Content="Search nearby"/>
                    <ComboBoxItem Content="Search screen"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Method" FontSize="11" Opacity="0.7" Margin="0,0,0,4"/>
                <ComboBox x:Name="MethodBox" SelectedIndex="0">
                    <ComboBoxItem Content="Color / image"/>
                    <ComboBoxItem Content="AI fallback"/>
                    <ComboBoxItem Content="Color / image + AI"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <TextBlock Text="Similarity (higher = more exact)" FontSize="11" Opacity="0.7"/>
        <DockPanel Margin="0,4,0,2">
            <TextBlock x:Name="SimilarityLabel" DockPanel.Dock="Right" Text="90%" Width="40" TextAlignment="Right"/>
            <Slider x:Name="SimilaritySlider" Minimum="70" Maximum="99" Value="90" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSimilarityChanged"/>
        </DockPanel>
        <TextBlock Text="Internally: CIE Lab ΔE76 threshold = (100 − percent) / 3. 90% ≈ ΔE 3.3." FontSize="10" Opacity="0.5" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Poll interval (ms)" FontSize="11" Opacity="0.7"/>
                <TextBox x:Name="PollBox" Text="150" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Timeout (seconds)" FontSize="11" Opacity="0.7"/>
                <TextBox x:Name="TimeoutBox" Text="10" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="On timeout" FontSize="11" Opacity="0.7"/>
                <ComboBox x:Name="TimeoutActionBox" SelectedIndex="0" Margin="0,4,0,0">
                    <ComboBoxItem Content="Stop macro"/>
                    <ComboBoxItem Content="Skip condition"/>
                    <ComboBoxItem Content="Retry"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Retry count" FontSize="11" Opacity="0.7"/>
                <TextBox x:Name="RetryBox" Text="3" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Neighborhood" VerticalAlignment="Center" FontSize="11" Opacity="0.7" Margin="0,0,8,0"/>
            <ComboBox x:Name="NeighborhoodBox" Width="80" SelectedIndex="0">
                <ComboBoxItem Content="1×1"/>
                <ComboBoxItem Content="3×3"/>
                <ComboBoxItem Content="5×5"/>
            </ComboBox>
            <CheckBox x:Name="MaxAccuracyBox" Content="Maximum accuracy (CIEDE2000)" Margin="16,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="6" Padding="10" Margin="0,0,0,12">
            <DockPanel>
                <Border x:Name="ColorSwatch" Width="28" Height="28" CornerRadius="4" Background="Transparent" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                <Button Content="Pick from screen" Click="OnPickClick" DockPanel.Dock="Right" Padding="10,4" Margin="8,0,0,0" Style="{StaticResource PillButton}"/>
                <StackPanel>
                    <TextBlock x:Name="HexText" Text="#------" FontWeight="Bold"/>
                    <TextBlock x:Name="RgbText" Text="Click Pick to sample a pixel or region" FontSize="11" Opacity="0.7"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Padding="14,6" Margin="0,0,8,0" Style="{StaticResource PillButton}"/>
            <Button Content="Add step" IsDefault="True" Click="OnAddClick" Padding="14,6" Style="{StaticResource ModernButton}"/>
        </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
