<Window x:Class="MacroSuite.App.Overlays.ColorPickerOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Color Picker"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Maximized"
        Cursor="Cross"
        Focusable="True"
        KeyDown="OnKeyDown"
        PreviewKeyDown="OnKeyDown">
    <Canvas x:Name="OverlayCanvas"
            Background="Transparent"
            Focusable="True"
            MouseMove="OnMouseMove"
            MouseDown="OnMouseDown"
            KeyDown="OnKeyDown">

        <!-- Floating Magnifier Loupe Card -->
        <Border x:Name="LoupeCard"
                Background="#D9181825"
                BorderBrush="#89B4FA"
                BorderThickness="1.5"
                CornerRadius="8"
                Padding="10"
                Width="160">
            <StackPanel HorizontalAlignment="Center">
                <!-- Color Swatch Circle -->
                <Border x:Name="ColorSwatch"
                        Width="44"
                        Height="44"
                        CornerRadius="22"
                        BorderBrush="#CDD6F4"
                        BorderThickness="2"
                        Background="Transparent"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Center"/>

                <!-- HEX Code Text -->
                <TextBlock x:Name="HexText"
                           Text="—"
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="#CDD6F4"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,2"/>

                <!-- RGB Text -->
                <TextBlock x:Name="RgbText"
                           Text="Preview unavailable"
                           FontSize="10"
                           Foreground="#A6ADC8"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>

                <!-- Coordinates Text -->
                <TextBlock x:Name="CoordsText"
                           Text=""
                           FontSize="10"
                           Foreground="#6C7086"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Instruction Banner -->
        <Border x:Name="InstructionBanner" Canvas.Top="20"
                HorizontalAlignment="Center"
                Background="#D9181825"
                BorderBrush="#45475A"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,6">
            <TextBlock Text="Move for a color preview. Click to sample that pixel. ESC or right-click cancels."
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#CDD6F4"/>
        </Border>
    </Canvas>
</Window>
