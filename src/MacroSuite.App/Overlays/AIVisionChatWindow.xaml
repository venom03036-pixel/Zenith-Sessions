<Window x:Class="MacroSuite.App.Overlays.AIVisionChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Vision - Pre-flight Setup"
        Width="620" Height="540" MinWidth="480" MinHeight="400"
        Background="{DynamicResource AppBackground}" WindowStyle="None" AllowsTransparency="True"
        Topmost="True"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="UserBubble" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10,10,2,10"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="60,0,0,8"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="AssistantBubble" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SelectionBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10,10,10,2"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,60,8"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ChatInput" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentMint}"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,7"/>
        </Style>
        <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Title bar -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" CornerRadius="10,10,0,0" MouseDown="TitleBar_MouseDown">
                <DockPanel Margin="14,0">
                    <Button Content="X" DockPanel.Dock="Right" Width="28" Height="28" FontSize="12" Click="CloseButton_Click"
                            VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondary}" Cursor="Hand"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="AI Vision - Pre-flight Chat" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- Chat log -->
            <Border Grid.Row="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,1,0,1">
                <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,12">
                    <StackPanel x:Name="ChatHistory">
                        <Border Style="{StaticResource AssistantBubble}">
                            <StackPanel>
                                <TextBlock Text="AI Vision Assistant" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentMint}" Margin="0,0,0,5"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SelectionForeground}"
                                           Text="Tell me what this macro step should look for on screen and what it should do. Be specific — e.g. &apos;Find the blue Confirm button in the bottom-right dialog and click it.&apos;"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <!-- Input row -->
            <Grid Grid.Row="2" Margin="12,10,12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" Grid.Column="0" Style="{StaticResource ChatInput}" VerticalAlignment="Center"
                         KeyDown="InputBox_KeyDown" TextChanged="InputBox_TextChanged" Margin="0,0,8,0"
                         ToolTip="Describe what the AI should see and do. Press Enter to send."/>
                <Button Grid.Column="1" Content="Send" Style="{StaticResource SubtleButton}" Click="SendButton_Click" VerticalAlignment="Center"/>
            </Grid>
            <!-- Bottom action row -->
            <Border Grid.Row="3" Background="{DynamicResource HeaderBackground}" Padding="12,10" CornerRadius="0,0,10,10">
                <DockPanel LastChildFill="False">
                    <Button Content="Cancel" Style="{StaticResource SubtleButton}" Click="CancelButton_Click" DockPanel.Dock="Left"/>
                    <Button Content="Clear" Style="{StaticResource SubtleButton}" Click="ClearButton_Click" DockPanel.Dock="Left" Margin="8,0,0,0"/>
                    <Button x:Name="FinalizeButton" Content="Use This Prompt" Style="{StaticResource ActionButton}" Click="FinalizeButton_Click" IsEnabled="False" DockPanel.Dock="Right"/>
                    <TextBlock x:Name="CharCountLabel" Text="0 chars" FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="0,0,10,0"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
