<Window x:Class="MacroSuite.App.Overlays.LiveWatchOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detection Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        IsHitTestVisible="False">
    <Grid>
        <Border BorderBrush="#CBA6F7"
                BorderThickness="2"
                Background="#10CBA6F7"
                CornerRadius="4"/>

        <Canvas IsHitTestVisible="False">
            <Line x:Name="CrosshairHorizontal" Stroke="#FF5A5F" StrokeThickness="2" X1="-8" X2="8" Visibility="Collapsed"/>
            <Line x:Name="CrosshairVertical" Stroke="#FF5A5F" StrokeThickness="2" Y1="-8" Y2="8" Visibility="Collapsed"/>
        </Canvas>

        <Border Background="#E6181825"
                BorderBrush="#CBA6F7"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8,6"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="4,-8,0,0"
                MinWidth="260">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Ellipse Width="6" Height="6" Fill="#A6E3A1" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText"
                               Text="DETECTION OVERLAY"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#CDD6F4"/>
                </StackPanel>
                <TextBlock x:Name="DiagnosticsText"
                           Text="Waiting for a color or visual check…"
                           FontSize="11"
                           Foreground="#CDD6F4"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
