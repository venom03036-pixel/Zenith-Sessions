<Window x:Class="MacroSuite.App.Overlays.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Region Selector"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#40000000"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        KeyDown="OnKeyDown"
        PreviewKeyDown="OnPreviewKeyDown"
        Cursor="Cross">
    <Canvas x:Name="OverlayCanvas"
            Background="#01000000"
            Focusable="True"
            MouseDown="OnMouseDown"
            MouseMove="OnMouseMove"
            MouseUp="OnMouseUp">

        <!-- No DropShadowEffect: a full-screen blurred shadow tanks the GPU. -->
        <Border x:Name="SelectionBox"
                BorderBrush="#89B4FA"
                BorderThickness="1"
                Background="#1489B4FA"
                Visibility="Collapsed"
                SnapsToDevicePixels="True"/>

        <!-- Coordinate / Dimensions Badge -->
        <Border x:Name="InfoBadge"
                Background="#D9181825"
                BorderBrush="#89B4FA"
                BorderThickness="1"
                CornerRadius="4"
                Padding="6,3"
                Visibility="Collapsed">
            <TextBlock x:Name="InfoBadgeText"
                       Text="0 x 0"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#CDD6F4"/>
        </Border>

        <!-- Instruction Banner at top center -->
        <Border Canvas.Top="20"
                HorizontalAlignment="Center"
                Background="#D9181825"
                BorderBrush="#45475A"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,6">
            <TextBlock Text="Click and drag to select a screen region. Press ESC or right-click to cancel."
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#CDD6F4"/>
        </Border>
    </Canvas>
</Window>
