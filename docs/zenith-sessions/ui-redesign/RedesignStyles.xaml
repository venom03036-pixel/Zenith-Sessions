<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Zenith Sessions redesign — style layer (draft, not yet merged into the app).
    Source of truth: Figma "Zenith Sessions — UI Redesign" → Foundations page.
    Every colour is a DynamicResource key that ThemeCatalog already produces, so all six themes keep working.
    Merge AFTER Themes/SessionsControls.xaml in App.xaml. Keys that already exist (PrimaryButton, QuietButton,
    GhostButton, DangerButton, PageTitle, PageSubtitle, Caption) intentionally override the old look.
  -->

  <BooleanToVisibilityConverter x:Key="RedesignVisibleIf" />

  <!-- ===== Typography (Figma text styles: Title / Section / Body / Caption / Label / Mono) ===== -->
  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style x:Key="PageSubtitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="SectionHeading" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style x:Key="MonoText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style x:Key="MetricText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- ===== Surfaces ===== -->
  <Style x:Key="SurfaceCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <!-- Full-height panel docked to the right edge (Account details, game detail, pinned server). -->
  <Style x:Key="DockedPanel" TargetType="Border">
    <Setter Property="Width" Value="360" />
    <Setter Property="Background" Value="{DynamicResource CardBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Padding" Value="24" />
  </Style>
  <Style x:Key="JoiningBanner" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SelectionBackground}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16,10" />
  </Style>
  <Style x:Key="WarningBand" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource BadgeBgWarning}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16,10" />
  </Style>
  <Style x:Key="Divider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BorderBrushLight}" />
    <Setter Property="Margin" Value="0,4" />
  </Style>

  <!-- ===== Buttons (Figma: Button Kind=Primary/Secondary/Ghost/Danger, 32px) ===== -->
  <Style x:Key="ButtonBase" TargetType="Button">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True" />
            <Border x:Name="FocusRing" BorderBrush="{DynamicResource BorderBrushFocus}" BorderThickness="2" CornerRadius="8" Margin="-3" Visibility="Collapsed" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBackground}" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource ActiveBackground}" /></Trigger>
    </Style.Triggers>
  </Style>

  <!-- Secondary -->
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}" />

  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource PrimaryHoverBackground}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource PrimaryPressedBackground}" /></Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="Padding" Value="10,0" />
  </Style>

  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{DynamicResource DangerGradient}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerGradient}" />
    <Setter Property="Foreground" Value="{DynamicResource DangerForeground}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="28" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource DangerHoverBackground}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource DangerPressedBackground}" /></Trigger>
    </Style.Triggers>
  </Style>

  <!-- Text-coloured destructive action (Remove…, Remove profile) -->
  <Style x:Key="DangerTextButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="Foreground" Value="{DynamicResource AccentDanger}" />
  </Style>

  <!-- 32×32 icon button; Content is a 16px Path. Always set ToolTip + AutomationProperties.Name. -->
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style x:Key="Glyph" TargetType="Path">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="1.4" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ===== Status: dot + short word. Put the long explanation in ToolTip. Tag = Success | Warning | Danger | Accent | Neutral ===== -->
  <Style x:Key="StatusDot" TargetType="ContentControl">
    <Setter Property="Tag" Value="Neutral" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="Dot" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource TextMuted}" />
            <ContentPresenter VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="Success"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentSuccess}" /></Trigger>
            <Trigger Property="Tag" Value="Warning"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentWarning}" /></Trigger>
            <Trigger Property="Tag" Value="Danger"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentDanger}" /></Trigger>
            <Trigger Property="Tag" Value="Accent"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentPrimary}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Filled pill (In game, Playing, Pinned, group name). Same Tag values as StatusDot. -->
  <Style x:Key="Pill" TargetType="ContentControl">
    <Setter Property="Tag" Value="Neutral" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border x:Name="Bg" CornerRadius="6" Padding="8,3" Background="{DynamicResource SurfaceBackground}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="Dot" Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" />
              <ContentPresenter x:Name="Label" TextElement.Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="Success">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BadgeBgSuccess}" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" /><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentSuccess}" />
              <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource AccentSuccess}" />
            </Trigger>
            <Trigger Property="Tag" Value="Warning">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BadgeBgWarning}" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" /><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentWarning}" />
              <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource AccentWarning}" />
            </Trigger>
            <Trigger Property="Tag" Value="Danger">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BadgeBgDanger}" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" /><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentDanger}" />
              <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource AccentDanger}" />
            </Trigger>
            <Trigger Property="Tag" Value="Accent">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectionBackground}" />
              <Setter TargetName="Dot" Property="Visibility" Value="Visible" /><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentPrimary}" />
              <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource AccentPrimary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    ===== Roblox headshot avatar (Figma: Avatar Size=24/32/40/56) =====
    Use on a ContentControl whose DataContext is the account row/selection:
      <ContentControl Style="{StaticResource AccountAvatar}" Width="32" Height="32" Tag="{Binding Initials}" />
    • The headshot is an ImageBrush on the Border background, so it is clipped by CornerRadius
      and centre-cropped by Stretch=UniformToFill + AlignmentX/Y=Center at every size.
    • Initials show underneath until Avatar loads, and whenever HasAvatar is false.
    • Needs a string Initials property on the row model (first two letters of the display name).
  -->
  <Style x:Key="AccountAvatar" TargetType="ContentControl">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid>
            <Border x:Name="Plate" CornerRadius="8" Background="{DynamicResource SurfaceBackground}">
              <Viewbox Margin="6" Stretch="Uniform">
                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
              </Viewbox>
            </Border>
            <Border x:Name="Photo" CornerRadius="8" Visibility="{Binding HasAvatar, Converter={StaticResource RedesignVisibleIf}}">
              <Border.Background>
                <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
              </Border.Background>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Sidebar navigation (Figma: NavItem, 34px, filled active state, accent icon) ===== -->
  <Style x:Key="NavItem" TargetType="Button">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Fill" Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,0">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
            </Border>
            <Border x:Name="FocusRing" BorderBrush="{DynamicResource BorderBrushFocus}" BorderThickness="2" CornerRadius="6" Visibility="Collapsed" />
            <!-- Kept for the existing active-state contract; zero-width so it is not drawn. -->
            <Border x:Name="Rail" Width="0" Background="{TemplateBinding BorderBrush}" HorizontalAlignment="Left" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fill" Property="Background" Value="{DynamicResource HoverBackground}" />
              <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
        <Setter Property="Background" Value="{DynamicResource SelectionBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Table rows (accounts, clients, servers, macros, events) ===== -->
  <Style x:Key="TableRow" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="12,0,8,0" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Row" Background="Transparent" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBackground}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TableHeaderText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="TableHeader" TargetType="Border">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <!-- Bulk-action bar that replaces the table header while rows are checked -->
  <Style x:Key="SelectionBar" TargetType="Border">
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="12,0,8,0" />
    <Setter Property="Background" Value="{DynamicResource SelectionBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <!-- ===== Key/value row used in every details panel ===== -->
  <Style x:Key="KeyText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="ValueText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- ===== Keyboard key cap (F12 next to Panic stop) ===== -->
  <Style x:Key="KeyCap" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</ResourceDictionary>
