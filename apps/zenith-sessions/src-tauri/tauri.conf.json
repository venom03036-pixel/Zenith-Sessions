{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zenith Sessions Diagnostics",
  "version": "0.1.0",
  "identifier": "com.zenith.sessions.probe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Zenith Sessions Launch Diagnostics", "width": 860, "height": 550 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": ["diagnostics"]
    }
  },
  "bundle": { "active": false, "icon": ["../../../src/MacroSuite.App/Assets/Zenith_Macros_Teal.ico"] }
}
