{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zenith Sessions Preview",
  "version": "0.1.0",
  "identifier": "com.zenith.sessions.preview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Zenith Sessions Preview", "width": 1160, "height": 720, "minWidth": 740, "minHeight": 500 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": ["diagnostics"]
    }
  },
  "bundle": { "active": false, "icon": ["../../../src/MacroSuite.App/Assets/Zenith_Macros_Teal.ico"] }
}
